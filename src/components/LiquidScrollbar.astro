<!-- Um único indicador para todas as páginas. Ele só aparece quando o
     documento realmente pode rolar; a medida e o arraste moram no script. -->
<div class="liquid-scrollbar" data-liquid-scrollbar hidden aria-hidden="true">
  <div class="liquid-scrollbar__thumb" data-liquid-scrollbar-thumb></div>
</div>

<script>
  import { initLiquidScrollbar } from '../scripts/liquidScrollbar';

  initLiquidScrollbar();
</script>

<style>
  .liquid-scrollbar {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 20;
    width: 14px;
    height: 100dvh;
    overflow: hidden;
    cursor: pointer;
    touch-action: none;
    contain: strict;
  }
  .liquid-scrollbar[hidden] {
    display: none;
  }

  .liquid-scrollbar__thumb {
    --liquid-y: 0px;
    --liquid-stretch: 1;

    position: absolute;
    top: 0;
    right: 0;
    width: 14px;
    min-height: 52px;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.68),
      #fff 40%,
      #fff 60%,
      rgba(255, 255, 255, 0.84)
    );
    border-radius: 0;
    clip-path: polygon(
      30% 0, 70% 0,
      70% 9%, 82% 20%, 64% 34%, 77% 48%, 62% 63%, 79% 78%, 69% 91%,
      69% 100%, 31% 100%,
      31% 91%, 21% 78%, 38% 63%, 23% 48%, 36% 34%, 18% 20%, 30% 9%
    );
    filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.48));
    transform: translate3d(0, var(--liquid-y), 0)
      scaleY(var(--liquid-stretch));
    transform-origin: center;
    animation: liquid-sides 3.2s ease-in-out infinite alternate;
    cursor: grab;
    will-change: transform, clip-path;
  }

  .liquid-scrollbar__thumb:hover,
  .liquid-scrollbar__thumb.is-dragging {
    filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.48))
      drop-shadow(0 0 5px rgba(255, 255, 255, 0.58));
    animation-duration: 1.5s;
  }
  .liquid-scrollbar__thumb.is-dragging {
    cursor: grabbing;
  }

  @keyframes liquid-sides {
    to {
      clip-path: polygon(
        25% 0, 75% 0,
        75% 9%, 60% 20%, 82% 34%, 65% 48%, 81% 63%, 62% 78%, 75% 91%,
        75% 100%, 25% 100%,
        25% 91%, 39% 78%, 19% 63%, 35% 48%, 18% 34%, 40% 20%, 25% 9%
      );
    }
  }

  :global(html[data-motion='reduced']) .liquid-scrollbar__thumb {
    animation: none;
  }
  :global(html.is-scrollbar-dragging) {
    cursor: grabbing;
    user-select: none;
  }
</style>
