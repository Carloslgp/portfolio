<!-- Um único indicador para todas as páginas. Ele só aparece quando o
     documento realmente pode rolar; a medida e o arraste moram no script. -->
<div class="liquid-scrollbar" data-liquid-scrollbar hidden aria-hidden="true">
  <div class="liquid-scrollbar__thumb" data-liquid-scrollbar-thumb></div>
</div>

<script>
  import { initLiquidScrollbar } from '../scripts/liquidScrollbar';

  initLiquidScrollbar();
</script>

<style>
  .liquid-scrollbar {
    position: fixed;
    inset: var(--viewport-top) var(--viewport-right) var(--viewport-bottom) auto;
    z-index: 20;
    width: 14px;
    height: var(--viewport-h);
    overflow: hidden;
    cursor: pointer;
    touch-action: none;
    contain: strict;
  }
  .liquid-scrollbar[hidden] {
    display: none;
  }

  .liquid-scrollbar__thumb {
    --liquid-y: 0px;
    --liquid-stretch: 1;

    position: absolute;
    top: 0;
    right: 0;
    width: 14px;
    min-height: 52px;

    /* ——— a cor ———
       O polegar é TINTA, e não branco: no tema escuro dá no mesmo (a tinta lá
       já é quase branca), mas no claro um branco fixo desaparecia no papel —
       sobrava a sombra dele boiando sozinha na beirada da tela.

       A cor sai em duas camadas de propósito. A de baixo é chapada e por isso
       ATRAVESSA a troca de tema no mesmo 0.6s do resto da página; a de cima é
       só o brilho lateral que a forma sempre teve, e vive num gradiente —
       gradiente é background-IMAGE, e imagem nenhuma transiciona. Deixá-lo
       numa camada própria é o que impede o brilho de arrastar o corpo do
       polegar pro corte seco junto com ele. */
    background-color: var(--ink);
    background-image: linear-gradient(
      90deg,
      rgba(var(--paper-rgb), 0.32),
      rgba(var(--paper-rgb), 0) 40%,
      rgba(var(--paper-rgb), 0) 60%,
      rgba(var(--paper-rgb), 0.16)
    );
    transition: background-color var(--theme-fade);
    border-radius: 0;
    clip-path: polygon(
      30% 0, 70% 0,
      70% 9%, 82% 20%, 64% 34%, 77% 48%, 62% 63%, 79% 78%, 69% 91%,
      69% 100%, 31% 100%,
      31% 91%, 21% 78%, 38% 63%, 23% 48%, 36% 34%, 18% 20%, 30% 9%
    );
    /* o contorno é sempre a cor OPOSTA à do polegar — é ele que separa a forma
       do que estiver embaixo dela (uma foto do About, um parágrafo), e por isso
       tem que virar junto com o tema em vez de ser um preto fixo */
    filter: drop-shadow(0 0 2px rgba(var(--paper-rgb), 0.48));
    transform: translate3d(0, var(--liquid-y), 0)
      scaleY(var(--liquid-stretch));
    transform-origin: center;
    animation: liquid-sides 3.2s ease-in-out infinite alternate;
    cursor: grab;
    will-change: transform, clip-path;
  }

  .liquid-scrollbar__thumb:hover,
  .liquid-scrollbar__thumb.is-dragging {
    /* o contorno de sempre, mais um halo na PRÓPRIA cor do polegar: no escuro
       ele acende, no claro ele adensa. Os dois são "isto aqui respondeu ao
       toque", que é a única coisa que o estado precisa dizer. */
    filter: drop-shadow(0 0 2px rgba(var(--paper-rgb), 0.48))
      drop-shadow(0 0 5px rgba(var(--ink-rgb), 0.58));
    animation-duration: 1.5s;
  }
  .liquid-scrollbar__thumb.is-dragging {
    cursor: grabbing;
  }

  @keyframes liquid-sides {
    to {
      clip-path: polygon(
        25% 0, 75% 0,
        75% 9%, 60% 20%, 82% 34%, 65% 48%, 81% 63%, 62% 78%, 75% 91%,
        75% 100%, 25% 100%,
        25% 91%, 39% 78%, 19% 63%, 35% 48%, 18% 34%, 40% 20%, 25% 9%
      );
    }
  }

  :global(html[data-motion='reduced']) .liquid-scrollbar__thumb {
    animation: none;
  }
  :global(html.is-scrollbar-dragging) {
    cursor: grabbing;
    user-select: none;
  }
</style>
