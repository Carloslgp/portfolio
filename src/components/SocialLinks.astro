---
// src/components/SocialLinks.astro — o GitHub e o LinkedIn, com as marcas.
//
// Três lugares mostram os dois links — o anel, o About e a /work — e cada
// marca é um caminho SVG comprido. Um componente é o que impede três cópias de
// saírem diferentes no dia em que um endereço mudar.
//
// Ele desenha os links e NÃO decide onde eles ficam: posição é da página. E a
// aparência muda com o chão em que eles pousam por variáveis (as --social-*
// lá embaixo), porque variável atravessa o escopo do Astro e seletor não.
// Sobre o papel a pílula é a de vidro claro da /work; sobre a cena do anel, a
// mesma do .mode e do .theme, com a marca branca.
interface Props {
  /** 'glass' é a pílula de vidro; 'bare' é só a marca, na cor do texto em
   *  volta — pra morar no meio de uma frase. */
  variant?: 'glass' | 'bare';
}

const { variant = 'glass' } = Astro.props;

/** Os desenhos são as marcas oficiais (Octicons e Simple Icons), preenchidos
 *  com currentColor pra seguir a tinta de onde estiverem. */
const LINKS = [
  {
    name: 'GitHub',
    href: 'https://github.com/Carloslgp',
    viewBox: '0 0 16 16',
    d: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/carlos-leonardo-garcia-pscheidt/',
    viewBox: '0 0 24 24',
    d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
];
---

<span class:list={['social', `is-${variant}`]}>
  {LINKS.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${link.name} (opens in a new tab)`}
      title={link.name}
    >
      <svg viewBox={link.viewBox} aria-hidden="true" focusable="false">
        <path fill="currentColor" d={link.d}></path>
      </svg>
    </a>
  ))}
</span>

<style>
  .social {
    display: inline-flex;
    align-items: center;
    gap: var(--social-gap, 0.5rem);
    /* as duas marcas são um par: numa frase que quebra, descem juntas */
    white-space: nowrap;
  }

  .social a {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 999px;
    text-decoration: none;
    /* O .overlay e o .intro da home são furados a clique e só devolvem o
       ponteiro aos filhos que o CSS DELES alcança — e o escopo do Astro não
       deixa aquela regra chegar até aqui. */
    pointer-events: auto;
  }

  .social svg {
    display: block;
    width: var(--social-icon, 18px);
    height: var(--social-icon, 18px);
  }

  .social a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  /* --- a pílula de vidro ------------------------------------------------- */
  .is-glass a {
    width: var(--social-size, 44px);
    height: var(--social-size, 44px);
    border: 1px solid var(--social-line, rgba(var(--ink-rgb), 0.12));
    background: var(--social-bg, rgba(90, 90, 90, 0.12));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--social-ink, var(--ink));
    transition:
      background 0.2s,
      color var(--theme-fade),
      border-color var(--theme-fade);
  }

  .is-glass a:hover {
    background: var(--social-bg-hover, rgba(90, 90, 90, 0.42));
  }

  /* --- só a marca -------------------------------------------------------- */
  .is-bare {
    --social-icon: 1.1em;
    --social-gap: 0.6em;
    /* o centro da marca na altura das maiúsculas, não apoiado na linha de
       base — apoiada, ela sobra pra cima do texto */
    vertical-align: -0.2em;
  }

  .is-bare a {
    color: inherit;
    transition: opacity 0.2s;
  }

  /* A marca tem o tamanho da letra, pequena demais pra um dedo. A área de
     toque cresce por fora, num pseudo-elemento, sem mexer na altura da
     linha. */
  .is-bare a::before {
    content: '';
    position: absolute;
    inset: -0.55em -0.3em;
  }

  @media (hover: hover) {
    .is-bare a:hover {
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social a {
      transition: none;
    }
  }

  :global(html[data-motion='reduced']) .social a {
    transition: none;
  }
</style>
