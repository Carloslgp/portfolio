---
// src/components/SocialLinks.astro — o GitHub e o LinkedIn, com as marcas.
//
// Três lugares mostram os dois perfis — o anel, o About e a /work — e é este
// componente que impede três cópias de saírem diferentes no dia em que um
// endereço mudar. O desenho de cada marca mora no BrandMark.astro.
//
// Ele desenha os links e NÃO decide onde eles ficam: posição é da página. E a
// aparência muda com o chão em que eles pousam por variáveis (as --social-*
// lá embaixo), porque variável atravessa o escopo do Astro e seletor não.
// Sobre o papel a pílula é a de vidro claro da /work; sobre a cena do anel, a
// mesma do .mode e do .theme, com a marca branca.
import BrandMark from './BrandMark.astro';

interface Props {
  /** 'glass' é a pílula de vidro; 'bare' é só a marca, na cor do texto em
   *  volta — pra morar no meio de uma frase. */
  variant?: 'glass' | 'bare';
}

const { variant = 'glass' } = Astro.props;

const LINKS = [
  { name: 'GitHub', href: 'https://github.com/Carloslgp', mark: 'github' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/carlos-leonardo-garcia-pscheidt/', mark: 'linkedin' },
] as const;
---

<span class:list={['social', `is-${variant}`]}>
  {LINKS.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${link.name} (opens in a new tab)`}
      title={link.name}
    >
      <BrandMark name={link.mark} />
    </a>
  ))}
</span>

<style>
  .social {
    display: inline-flex;
    align-items: center;
    gap: var(--social-gap, 0.5rem);
    /* as duas marcas são um par: numa frase que quebra, descem juntas */
    white-space: nowrap;
  }

  .social a {
    --mark-size: var(--social-icon, 18px);
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 999px;
    text-decoration: none;
    /* O .overlay e o .intro da home são furados a clique e só devolvem o
       ponteiro aos filhos que o CSS DELES alcança — e o escopo do Astro não
       deixa aquela regra chegar até aqui. */
    pointer-events: auto;
  }

  .social a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  /* --- a pílula de vidro ------------------------------------------------- */
  .is-glass a {
    width: var(--social-size, 44px);
    height: var(--social-size, 44px);
    border: 1px solid var(--social-line, rgba(var(--ink-rgb), 0.12));
    background: var(--social-bg, rgba(90, 90, 90, 0.12));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--social-ink, var(--ink));
    transition:
      background 0.2s,
      color var(--theme-fade),
      border-color var(--theme-fade);
  }

  .is-glass a:hover {
    background: var(--social-bg-hover, rgba(90, 90, 90, 0.42));
  }

  /* --- só a marca -------------------------------------------------------- */
  .is-bare {
    --social-icon: 1.1em;
    --social-gap: 0.6em;
    /* o centro da marca na altura das maiúsculas, não apoiado na linha de
       base — apoiada, ela sobra pra cima do texto */
    vertical-align: -0.2em;
  }

  .is-bare a {
    color: inherit;
    transition: opacity 0.2s;
  }

  /* A marca tem o tamanho da letra, pequena demais pra um dedo. A área de
     toque cresce por fora, num pseudo-elemento, sem mexer na altura da
     linha. */
  .is-bare a::before {
    content: '';
    position: absolute;
    inset: -0.55em -0.3em;
  }

  @media (hover: hover) {
    .is-bare a:hover {
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social a {
      transition: none;
    }
  }

  :global(html[data-motion='reduced']) .social a {
    transition: none;
  }
</style>
