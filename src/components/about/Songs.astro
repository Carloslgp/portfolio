---
// src/components/about/Songs.astro — as músicas da vida: as capas em fila e,
// atrás de cada uma, um modal com o texto.
//
// O conteúdo vem inteiro de src/data/songs.ts e é desenhado AQUI, no servidor:
// os <dialog> nascem no HTML com o texto dentro. O script (scripts/songs.ts)
// só gira as capas e chama showModal() — ele não carrega nem monta nenhum texto.
// É a mesma escolha do carrossel de jogos: um conteúdo só, num lugar só.
//
// Sem JS, o que fica é a tira rolável de capas com título e artista à mostra —
// o texto de cada música é o que se perde, porque <dialog> fechado não existe
// na tela. É o único custo do bloco.
//
// O player do YouTube não nasce aqui: o que este arquivo escreve é uma div
// vazia com o id do vídeo. Quem a preenche é o scripts/songs.ts, e só quando o
// modal abre — assim nem o script do YouTube nem o iframe pesam numa página que
// muita gente rola sem nunca abrir uma capa. É o mesmo trato do `preload="none"`
// que o vídeo do shots.ts faz.
import type { Song } from '../../data/songs';

interface Props {
  title: string;
  items: Song[];
}

const { title, items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

// o título é escrito na página E nomeia o carrossel pra quem não o vê: um texto
// só, então é o próprio <h4> que rotula a região (aria-labelledby, não label)
const headingId = `songs-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
---

<figure class="songs" data-songs aria-roledescription="carrossel" aria-labelledby={headingId}>
  <h4 class="songs-heading" id={headingId}>{title}</h4>

  <div class="songs-stage" data-songs-stage>
    <ul class="songs-track">
      {items.map((song) => (
        <li class="songs-item" data-songs-item data-songs-label={`${song.title} — ${song.artist}`}>
          <button
            type="button"
            class="songs-card"
            data-songs-open={`song-${song.id}`}
            aria-haspopup="dialog"
          >
            {/* draggable: sem isto o arrasto da fila esbarra no arrasto NATIVO
                da imagem, e o navegador sai carregando uma capa fantasma */}
            <img
              src={song.cover} alt={song.alt}
              width="640" height="640" loading="lazy" draggable="false"
            />

            {/* o rótulo do card serve o caminho sem JS: com o palco 3D de pé
                quem diz o nome é a legenda embaixo, e ele sai de cena */}
            <span class="songs-meta">
              <span class="songs-name">{song.title}</span>
              <span class="songs-artist">{song.artist}</span>
            </span>

            {/* a única pista de que a capa abre alguma coisa; só na da frente */}
            <span class="songs-open" aria-hidden="true">Ler</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <figcaption class="songs-bar">
    <button
      type="button" class="songs-nav" data-songs-prev
      aria-label="Música anterior" disabled>‹</button>

    <!-- aria-live: quem navega pelas setas ouve o título trocar -->
    <span class="songs-title" data-songs-title aria-live="polite">
      {items[0] && `${items[0].title} — ${items[0].artist}`}
    </span>

    <span class="songs-count" data-songs-count>{pad(1)} / {pad(items.length)}</span>

    <button
      type="button" class="songs-nav" data-songs-next
      aria-label="Próxima música">›</button>
  </figcaption>
</figure>

{items.map((song) => (
  /* data-lenis-prevent — sem isto NÃO SE ROLA o texto do modal com o dedo.

     O lockScroll() PARA o Lenis quando o modal abre, e o Lenis parado não fica
     quieto: ele cancela o touchmove que chega (lenis 1.3.25, o
     `if (this.isStopped || this.isLocked) event.preventDefault()`). Medido:
     sem o atributo o touchmove aqui dentro chega com defaultPrevented=true, e
     arrastar pra ler um texto longo não faz nada.

     Este atributo é a saída oficial do Lenis: ele varre o composedPath do
     evento ANTES de cancelar e, se acha o atributo, sai de cena e deixa o
     gesto ser nativo. No <dialog> ele cobre tudo que o modal vier a ter.

     (O touchSTART não é cancelado — então não era isto que impedia o toque no
     player do YouTube. Aquilo é outra coisa; ver o comentário da moldura.) */
  <dialog
    class="song-modal"
    id={`song-${song.id}`}
    aria-labelledby={`song-${song.id}-title`}
    data-lenis-prevent
  >
    {/* Todo o conteúdo mora neste filho, e é isso que faz o clique no fundo
        funcionar: só o backdrop chega ao <dialog> como alvo (ver songs.ts). */}
    <div class="song-modal-inner">
      <button type="button" class="song-close" data-songs-close aria-label="Fechar">×</button>

      <div class="song-head">
        <img class="song-cover" src={song.cover} alt={song.alt} width="640" height="640" />
        <div class="song-ident">
          <h4 id={`song-${song.id}-title`}>{song.title}</h4>
          <p class="song-credit">{song.artist}</p>
          <p class="song-credit song-credit-dim">{song.album} · {song.year}</p>
        </div>
      </div>

      {/* ——— por que existe um botão NOSSO em cima do player ———

          Um iframe de outra origem dentro deste modal não recebe TOQUE. Medido
          e isolado: o mesmo clique de mouse toca a música, e o mesmo toque no
          mesmo ponto não faz nada — o evento é roteado pra dentro do iframe
          (nada nosso o intercepta: no texto aqui do lado o touchstart chega
          normal) e morre lá. É o roteamento do navegador, não código nosso, e
          não temos como consertá-lo daqui.

          O que dá pra fazer é não DEPENDER dele: o primeiro toque acontece
          neste botão, que é DOM nosso, na nossa página, onde o toque
          comprovadamente funciona. Ele cria o player já tocando, e a pessoa
          nunca precisa acertar o play de dentro do iframe.

          De brinde, isto é mais leve que antes: sem o toque, nem o iframe nem
          o script do YouTube chegam a existir — a capa que serve de cartaz já
          está baixada, é a mesma do carrossel. */}
      {song.youtube && (
        <div class="song-video" data-song-video={song.youtube}>
          {/* o player nasce aqui dentro */}
          <div class="song-video-slot"></div>

          <button
            type="button" class="song-video-start" data-song-play
            aria-label={`Tocar ${song.title} no YouTube`}
          >
            <img src={song.cover} alt="" width="640" height="640" loading="lazy" />
            <span class="song-video-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M8 5.2v13.6L19 12z" /></svg>
            </span>
          </button>
        </div>
      )}

      {song.line && <p class="song-line">“{song.line}”</p>}
      {song.note.map((paragraph) => <p class="song-note">{paragraph}</p>)}
    </div>
  </dialog>
))}

<script>
  import { initSongs } from '../../scripts/songs';
  initSongs();
</script>

<style>
  /* ——— a fila sangra até as bordas da janela ———
     Nasce dentro da coluna de texto (.about-inner, 42rem) e volta à largura da
     tela pela mesma conta da fita 3D: 100vw exatos, centrado, sem precisar
     saber a largura da coluna. Pra trazer de volta pra dentro do texto é só
     voltar a `margin: 3.5rem 0` — a legenda já se alinha sozinha pelo
     max-width dela. */
  .songs {
    /* a medida do card, e a régua de todo o resto do bloco */
    --cover: clamp(150px, 32vw, 250px);
    margin: 3.5rem calc(50% - 50vw);
  }

  /* O título volta pra coluna de texto (os mesmos 42rem / 1.5rem do
     .about-inner e da legenda) enquanto as capas sangram: ele é uma linha de
     leitura, e leitura não acontece na borda da janela.
     A fonte é declarada inteira aqui porque o `.about h3` do index.astro é
     escopado lá — nada dele atravessa pra dentro deste componente. */
  .songs-heading {
    max-width: 42rem;
    margin: 0 auto 1.3rem;
    padding: 0 1.5rem;
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.25;
    color: rgba(var(--ink-rgb), 0.85);
    transition: color var(--theme-fade);
  }

  /* O palco recorta e dissolve as pontas.
     A máscara vive AQUI e não no trilho de propósito: máscara é propriedade de
     agrupamento, e no mesmo elemento que abre a perspectiva ela achataria o 3D
     inteiro. Aqui em cima ela só apaga as beiradas — sem isso a capa do fundo
     seria fatiada por um corte reto no meio da página. */
  .songs-stage {
    overflow: hidden;
    mask-image: linear-gradient(90deg,
      transparent 0, #000 9%, #000 91%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg,
      transparent 0, #000 9%, #000 91%, transparent 100%);
    /* o dedo na vertical continua rolando a PÁGINA; só o lateral é do carrossel */
    touch-action: pan-y;
    /* ——— folga pra sombra terminar ———
       O `overflow: hidden` acima existe pelas PONTAS, mas ele recorta os quatro
       lados. A conta era exata e cruel: o palco cortava a 24px abaixo da capa e
       a sombra da capa da frente alcança 24,5px (offset 22 + desfoque 45/2 −
       espalhamento 20). Ela morria numa linha reta na borda do recorte, bem
       onde a legenda começa — parecia que a palavra estava comendo a sombra.

       Estes 2.5rem afastam o corte pra 64px, longe do alcance dela. O ar não
       vira espaço em branco: a .songs-bar sobe de volta pela mesma medida (ver
       o margin negativo lá embaixo), então o ritmo vertical do bloco fica
       idêntico ao de antes e a sombra passa POR TRÁS da legenda, que é como o
       reflexo do carrossel de jogos se comporta.

       Não dá pra resolver com `overflow-x: hidden` sozinho: recortar um eixo
       força o outro pra auto, e aí o palco ganharia barra de rolagem. */
    padding-bottom: 2.5rem;
  }

  /* ——— o caminho sem JS ———
     Uma tira rolável de verdade: sem script nenhum isto já é um carrossel, em
     CSS. O script a converte em palco antes de qualquer coisa, e como as <img>
     são as MESMAS nada é baixado duas vezes. */
  .songs-track {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 1.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .songs-item {
    flex: 0 0 var(--cover);
    scroll-snap-align: center;
  }

  /* ——— o palco 3D ——— */
  .songs.is-js .songs-track {
    display: block;
    position: relative;
    height: calc(var(--cover) + 3rem);
    padding: 0;
    overflow: visible;
    perspective: 1200px;
  }
  .songs.is-js .songs-item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--cover);
    margin: calc(var(--cover) / -2) 0 0 calc(var(--cover) / -2);
    /* a pose (translate/rotate/opacity) vem do script — ela depende de quantas
       capas existem, então não cabe numa regra por posição aqui */
    transition: transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.55s ease;
    will-change: transform;
  }
  /* o seletor repete `.songs.is-js` de propósito: a transição acima tem duas
     classes de vantagem, e uma regra mais curta aqui perderia calada */
  :global(html[data-motion='reduced']) .songs.is-js .songs-item {
    transition: none;
  }

  .songs-card {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
    /* arrastar a fila não pode virar seleção de texto no meio do caminho */
    user-select: none;
    -webkit-user-select: none;
  }
  .songs-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;         /* capa é quadrada, venha do arquivo o que vier */
    object-fit: cover;
    border-radius: 2px;
    transition: box-shadow 0.4s ease;
  }
  /* a capa da frente é a única que se descola do papel */
  .songs.is-js .songs-item.is-active .songs-card img {
    box-shadow: 0 22px 45px -20px rgba(0, 0, 0, 0.55);
  }

  .songs-meta {
    display: block;
    margin-top: 0.5rem;
  }
  .songs-name,
  .songs-artist {
    display: block;
    font-size: 0.68rem;
    line-height: 1.5;
    transition: color var(--theme-fade);
  }
  .songs-name {
    font-weight: 600;
    color: rgba(var(--ink-rgb), 0.6);
  }
  .songs-artist {
    color: rgba(var(--ink-rgb), 0.35);
  }
  /* com o palco de pé quem diz o nome é a legenda de baixo */
  .songs.is-js .songs-meta {
    display: none;
  }

  /* A pista de que a capa abre algo. Só existe na capa da frente, e só quando
     o ponteiro (ou o Tab) chega nela: parada, ela seria um selo permanente em
     cima da arte. */
  .songs-open {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .songs:not(.is-js) .songs-open {
    display: none;
  }
  .songs-item.is-active .songs-card:hover .songs-open,
  .songs-item.is-active .songs-card:focus-visible .songs-open {
    opacity: 1;
  }

  /* ——— legenda ———
     A fila sangra, a legenda não: ela volta pra largura e pro recuo da coluna
     de texto (os mesmos 42rem / 1.5rem do .about-inner). É a mesma barra da
     fita 3D, de propósito — dois carrosséis na mesma página não podem falar
     duas línguas. */
  .songs-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    max-width: 42rem;
    /* O topo é NEGATIVO de propósito: ele desfaz os 2.5rem de respiro que o
       palco ganhou pra sombra caber (ver lá em cima), devolvendo a legenda ao
       mesmo lugar de antes. A conta: 2.5rem de folga − 1.5rem daqui = 1rem de
       distância real até a borda do palco, que é o que sempre houve.

       `position: relative` é o que garante a ORDEM: elemento posicionado pinta
       acima de conteúdo estático, então a palavra fica na frente e a sombra
       corre por trás dela. Sem isto, os dois disputam a mesma camada. */
    position: relative;
    margin: -1.5rem auto 0;
    padding: 0 1.5rem;
  }
  .songs-title {
    flex: 1;
    min-width: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(var(--ink-rgb), 0.62);
    /* título longo não pode quebrar a legenda em duas linhas e empurrar o
       texto do tópico a cada troca de capa */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--theme-fade);
  }
  .songs-count {
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;   /* a contagem não dança ao trocar */
    color: rgba(var(--ink-rgb), 0.35);
    transition: color var(--theme-fade);
  }
  .songs-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 32px;
    height: 32px;
    font: inherit;
    font-size: 1.05rem;
    line-height: 1;
    color: var(--ink);
    background: transparent;
    border: 1px solid rgba(var(--ink-rgb), 0.16);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, opacity 0.2s,
      color var(--theme-fade);
  }
  .songs-nav:hover:not(:disabled) {
    background: rgba(var(--ink-rgb), 0.05);
    border-color: rgba(var(--ink-rgb), 0.32);
  }
  /* as pontas da fila: ela não dá a volta, e o botão diz isso */
  .songs-nav:disabled {
    opacity: 0.28;
    cursor: default;
  }

  /* ——— o modal ———
     Ao contrário do resto do About, ESTE bloco tem fundo próprio: o painel
     inteiro é transparente pra deixar os cacos aparecerem por baixo, e um
     modal transparente por cima do vidro seria ilegível. */
  .song-modal {
    /* É ISTO que centraliza, e por isso está declarado à mão: o navegador já dá
       `inset: 0` + `margin: auto` a um dialog modal, mas o `* { margin: 0 }` do
       global.css passa por cima dele (estilo de autor vence o do navegador,
       especificidade à parte). Sem esta linha a caixa fica presa nos quatro
       lados com margem zero — ou seja, no canto superior esquerdo. */
    margin: auto;

    width: min(36rem, calc(100vw - 2rem));
    max-height: min(84svh, 46rem);
    padding: 0;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid rgba(var(--ink-rgb), 0.12);
    border-radius: 4px;
    overflow: hidden;                 /* quem rola é o miolo, não a caixa */
  }
  .song-modal[open] {
    display: flex;                    /* pro miolo poder rolar sozinho */
    flex-direction: column;
    animation: song-in 0.28s ease both;
  }
  .song-modal::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: song-fade 0.28s ease both;
  }
  @keyframes song-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
  }
  @keyframes song-fade {
    from { opacity: 0; }
  }
  :global(html[data-motion='reduced']) .song-modal[open],
  :global(html[data-motion='reduced']) .song-modal::backdrop {
    animation: none;
  }

  .song-modal-inner {
    position: relative;
    padding: 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;     /* chegar ao fim aqui não empurra a página */
  }

  .song-close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    font: inherit;
    font-size: 1.2rem;
    line-height: 1;
    color: var(--ink);
    background: transparent;
    border: 1px solid rgba(var(--ink-rgb), 0.16);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .song-close:hover {
    background: rgba(var(--ink-rgb), 0.06);
    border-color: rgba(var(--ink-rgb), 0.32);
  }

  .song-head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.6rem;
    padding-right: 2.5rem;            /* o X não pisa no título */
  }
  .song-cover {
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    object-fit: cover;
    border-radius: 2px;
  }
  .song-ident h4 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.15;
    margin-bottom: 0.35rem;
  }
  .song-credit {
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(var(--ink-rgb), 0.62);
  }
  .song-credit-dim {
    font-size: 0.72rem;
    color: rgba(var(--ink-rgb), 0.38);
  }

  /* ——— o player ———
     A moldura é 16/9, mas com PISO: os termos do YouTube pedem no mínimo
     200×200px e o player à vista, e na coluna estreita do celular o 16/9
     sozinho cairia abaixo disso. O min-height segura o piso e o vídeo só ganha
     tarja em cima e embaixo — nestas três faixas, que são áudio oficial com
     capa parada, isso não se distingue do enquadramento normal.

     O fundo cinza é o que se vê no instante entre abrir o modal e o iframe
     aparecer; sem ele o lugar do player pisca em branco. */
  .song-video {
    position: relative;
    /* `width` explícito, e não `auto`: com a largura indefinida o navegador
       satisfaz a proporção pelo lado que quiser, e chegou a ESTICAR a caixa
       além do modal. Fixada a largura, a proporção só decide a altura. */
    width: 100%;
    /* 16/9 EXATO, sem piso de altura. A tentação era um `min-height: 200px`
       pro mínimo que o YouTube pede, mas uma caixa fora de 16/9 faz o player
       deles desalinhar o próprio conteúdo — o botão de play sai do centro e o
       título é cortado. Os pixels que faltavam no celular vieram da sangria
       abaixo, que é honesta; o piso forçado só entregava um player torto. */
    aspect-ratio: 16 / 9;
    margin-bottom: 1.6rem;
    background: rgba(var(--ink-rgb), 0.06);
    border-radius: 3px;
    overflow: hidden;
  }
  /* ——— :global() nas duas regras abaixo, e é obrigatório ———
     O iframe é criado em TEMPO DE EXECUÇÃO pela API do YouTube, e o link de
     saída idem (ver saidaDeEmergencia em scripts/songs.ts). O Astro escopa o
     CSS carimbando um data-astro-cid em tudo que ELE desenha e exigindo esse
     atributo no seletor — o que nasce por JS não tem o carimbo, e a regra
     escopada passa longe, calada.

     O sintoma era bom de guardar: sem isto o iframe ficava no tamanho padrão
     dele (640×360) dentro de uma moldura bem menor, e como a moldura tem
     overflow: hidden o que aparecia era um PEDAÇO do player — o botão de play
     fora do centro e o título cortado. Parecia defeito do YouTube. */
  .song-video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ——— o cartaz: a capa e o botão de play nosso ———
     Fica por cima do lugar do player e some quando ele nasce. A capa é a MESMA
     do carrossel, então já está no cache — nenhum byte novo, e nada é pedido ao
     YouTube antes de a pessoa querer. */
  .song-video-slot {
    position: absolute;
    inset: 0;
  }

  .song-video-start {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
