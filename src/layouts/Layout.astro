---
// src/layouts/Layout.astro
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import LiquidScrollbar from '../components/LiquidScrollbar.astro';
import Analytics from '@vercel/analytics/astro';

// The document language. English is the default because every public page uses
// it. Keeping this accurate ensures assistive technology selects the right
// pronunciation rules.
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- O `cover` abaixo é um estado intermediário de propósito; o script logo
         depois o troca por `auto` ainda durante a leitura do <head>, antes do
         primeiro paint.

         No Chrome do iPhone (iOS 26.6), declarar somente `viewport-fit=auto`
         nem sempre desfaz o estado `cover` que o WKWebView guardou de uma
         navegação ou restauração anterior. A página fica inteira 97px acima da
         área visível, mas visualViewport, safe-area e getBoundingClientRect()
         continuam respondendo zero. Por isso nenhuma correção CSS consegue
         distinguir o quadro quebrado do correto.

         A transição REAL `cover` -> `auto` força o WKWebView a recalcular seus
         content insets e reproduz, em toda URL, o resultado que o antigo
         `?fit=auto` comprovou no aparelho. Não condensar isto numa meta estática:
         foi exatamente essa forma que deixou o estado antigo sobreviver. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <script is:inline>
      (() => {
        const meta = document.querySelector('meta[name="viewport"]');
        if (!meta) return;

        const auto = 'width=device-width, initial-scale=1, viewport-fit=auto';
        const cover = 'width=device-width, initial-scale=1, viewport-fit=cover';

        // A primeira troca acontece com o parser ainda no <head>: o navegador
        // conhece os dois estados, mas nunca chega a pintar o estado `cover`.
        meta.setAttribute('content', auto);

        // A troca inicial é segura em qualquer navegador; os resets de retomada
        // são específicos do WKWebView para não relayoutar páginas longas em
        // plataformas que não têm este bug.
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent)
          || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        if (!isIOS) return;

        let frame = 0;
        let needsRestore = false;

        const cancelConfirmation = () => {
          if (!frame) return;
          cancelAnimationFrame(frame);
          frame = 0;
        };

        const isUnzoomed = () => !window.visualViewport
          || Math.abs(window.visualViewport.scale - 1) < 0.01;

        const restoreAuto = () => {
          // Não desfaz o zoom de quem ampliou a página. O reset fica pendente e
          // o resize da visualViewport o executa quando a escala voltar a 1.
          if (document.hidden || !isUnzoomed()) {
            needsRestore = true;
            return;
          }
          if (frame) return;
          needsRestore = false;

          // Duas escritas síncronas não deixam um frame em `cover`. A confirmação
          // no rAF dá ao WKWebView uma transação de camada para aplicar o inset;
          // depois avisa o medidor para reler a geometria já no estado final.
          meta.setAttribute('content', cover);
          meta.setAttribute('content', auto);
          frame = requestAnimationFrame(() => {
            frame = 0;
            meta.setAttribute('content', auto);
            window.dispatchEvent(new Event('viewport:fit-reset'));
          });
        };

        const requireRestore = () => {
          needsRestore = true;
          cancelConfirmation();
          restoreAuto();
        };

        const suspend = () => {
          needsRestore = true;
          // rAFs podem ser congelados com o documento. Um handle antigo não
          // pode bloquear o reset quando a aba voltar sem disparar pageshow.
          cancelConfirmation();
        };

        // BFCache preserva o DOM e também o estado nativo errado. Restauração de
        // aba do Chrome pode chegar só por focus/visibilitychange, sem pageshow.
        window.addEventListener('pageshow', (event) => {
          if (!event.persisted) return;
          requireRestore();
        });
        window.addEventListener('pagehide', suspend);
        window.addEventListener('blur', suspend);
        window.addEventListener('focus', () => {
          if (needsRestore) restoreAuto();
        });
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) suspend();
          else if (needsRestore) restoreAuto();
        });
        window.visualViewport?.addEventListener('resize', () => {
          if (needsRestore && isUnzoomed()) restoreAuto();
        });
        window.visualViewport?.addEventListener('scrollend', () => {
          if (needsRestore && isUnzoomed()) restoreAuto();
        });
      })();
    </script>
    <!-- As fontes são deste domínio agora (ver as @font-face do global.css), e
         por isso não há mais preconnect nenhum aqui: não existe terceiro no
         caminho crítico pra "pré-conectar".

         O preload é do arquivo que TODA página usa — o Inter latin. Sem ele o
         navegador só descobre a fonte depois de baixar e analisar o CSS, e o
         texto passa esse tempo todo desenhado na fonte do sistema. As outras
         faces (Playfair, latin-ext) ficam de fora de propósito: preload é uma
         ordem de prioridade, e pedir tudo com prioridade máxima é o mesmo que
         não priorizar nada. -->
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- inline e ANTES de qualquer paint: o tema salvo entra junto com o CSS,
         senão quem escolheu escuro vê a página piscar branca a cada visita.
         is:inline de propósito — bundlado, ele rodaria tarde demais. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark')
          document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
    <!-- O tamanho visível já nasce em `dvh` no CSS. Este medidor corrige apenas
         a origem da caixa de `position: fixed` no iPhone e mantém a medida
         usada pela cena WebGL sincronizada (ver scripts/viewport.ts). Fica no
         Layout porque toda rota tem uma emenda de tela cheia. -->
    <script>
      import { watchViewport } from '../scripts/viewport';
      watchViewport();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <LiquidScrollbar />
    <!-- Contagem de visitas da Vercel. Fica no FIM do body, e não no head, por
         dois motivos: o script é um módulo (portanto adiado de qualquer jeito) e
         a home tem uma cena WebGL disputando a primeira meia dúzia de frames —
         nada que não seja a cortina tem prioridade sobre ela.

         Não há chave nenhuma pra guardar: em produção o próprio domínio serve o
         script e recebe os eventos (/_vercel/insights/*), então isto é só um
         elemento vazio que dispara um pageview. Em `astro dev` ele detecta o
         modo de desenvolvimento sozinho e só escreve no console — nada é
         contado a partir daqui. -->
    <Analytics />
  </body>
</html>
