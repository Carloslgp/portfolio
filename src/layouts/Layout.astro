---
// src/layouts/Layout.astro
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import LiquidScrollbar from '../components/LiquidScrollbar.astro';
import Analytics from '@vercel/analytics/astro';

// The document language. English is the default because every public page uses
// it. Keeping this accurate ensures assistive technology selects the right
// pronunciation rules.
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- SEM `viewport-fit=cover`, e isso não é esquecimento.

         O `cover` é um trato de duas partes: o navegador desenha de beirada a
         beirada e, em troca, devolve em `env(safe-area-inset-*)` o quanto ele
         cobriu, pra página se defender. O Chrome do iPhone (medido no iOS 26.6)
         cumpre a primeira metade e responde ZERO na segunda — e ainda posiciona
         o viewport no topo FÍSICO da tela. O resultado é a página inteira
         desenhada uns 90px pra cima, com o título sumindo atrás da barra de
         endereço e uma faixa de papel vazio embaixo, sem nenhuma API do DOM
         reportando o deslocamento: `visualViewport.offsetTop`, o canto do
         documento e as próprias safe-areas respondem 0 (ver scripts/viewport.ts,
         que existe pra medir exatamente esse desencontro e não conseguia ver
         este). Sem o `cover`, a mesma página cai encaixada na área visível.

         Repor o `cover` traz o bug de volta. Se algum dia for preciso — modo
         standalone, por exemplo — o teste é abrir `/#vp` no iPhone: a régua
         vermelha tem que encostar nas duas barras do navegador. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- As fontes são deste domínio agora (ver as @font-face do global.css), e
         por isso não há mais preconnect nenhum aqui: não existe terceiro no
         caminho crítico pra "pré-conectar".

         O preload é do arquivo que TODA página usa — o Inter latin. Sem ele o
         navegador só descobre a fonte depois de baixar e analisar o CSS, e o
         texto passa esse tempo todo desenhado na fonte do sistema. As outras
         faces (Playfair, latin-ext) ficam de fora de propósito: preload é uma
         ordem de prioridade, e pedir tudo com prioridade máxima é o mesmo que
         não priorizar nada. -->
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- inline e ANTES de qualquer paint: o tema salvo entra junto com o CSS,
         senão quem escolheu escuro vê a página piscar branca a cada visita.
         is:inline de propósito — bundlado, ele rodaria tarde demais. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark')
          document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
    <!-- O tamanho visível já nasce em `dvh` no CSS. Este medidor corrige apenas
         a origem da caixa de `position: fixed` no iPhone e mantém a medida
         usada pela cena WebGL sincronizada (ver scripts/viewport.ts). Fica no
         Layout porque toda rota tem uma emenda de tela cheia. -->
    <script>
      import { watchViewport } from '../scripts/viewport';
      watchViewport();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <LiquidScrollbar />
    <!-- Contagem de visitas da Vercel. Fica no FIM do body, e não no head, por
         dois motivos: o script é um módulo (portanto adiado de qualquer jeito) e
         a home tem uma cena WebGL disputando a primeira meia dúzia de frames —
         nada que não seja a cortina tem prioridade sobre ela.

         Não há chave nenhuma pra guardar: em produção o próprio domínio serve o
         script e recebe os eventos (/_vercel/insights/*), então isto é só um
         elemento vazio que dispara um pageview. Em `astro dev` ele detecta o
         modo de desenvolvimento sozinho e só escreve no console — nada é
         contado a partir daqui. -->
    <Analytics />
  </body>
</html>
