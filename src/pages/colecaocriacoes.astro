    .cc-media {
      --frame-h: 66dvh;
    }

    .cc-title {
      font-size: clamp(2rem, 3.8vw, 3.4rem);
    }
  }

  /* baixa animação (a escolha do portão): a página já está na versão simples
     pelo script do <head>; aqui só se cortam as transições de enfeite */
  :global(html[data-motion='reduced']) .cc-hint::after,
  :global(html[data-motion='reduced']) .cc-nav,
  :global(html[data-motion='reduced']) .cc-roll-col,
