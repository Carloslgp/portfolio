    .cc-evolution-strip img {
      width: 2.2rem;
      height: 2.2rem;
    }
  }

  /* janela larga e baixa (notebook com a janela encolhida) */
  @media (max-height: 42rem) and (min-width: 46.01rem) {
    .cc-hero h1 {
      font-size: clamp(3.6rem, 12vh, 6rem);
    }

    /* só o duet/flip encolhem: as outras composições já se medem em dvh e
