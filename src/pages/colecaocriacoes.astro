---
// ⚠ NÃO RENOMEIE NEM MOVA ESTE ARQUIVO. O nome dele é a URL pública, e este
// endereço já foi divulgado fora do site: renomear publica outro caminho e
// quebra um link que já está com outras pessoas, sem erro nenhum por conta
// própria. A rota é travada em scripts/rotas-travadas.mjs, e o build morre se
// ela sumir; se isso aconteceu, desfaça o rename em vez de mexer na lista.
//
// /colecaocriacoes — a Coleção de Criações como uma sequência dirigida pelo
// scroll: abertura, uma criação por tela (presa enquanto a animação dela
// acontece) e um fechamento, com um indicador lateral de posição.
//
// Esta página não conhece nenhuma frase: tudo que aparece vem de
// src/data/creations.ts (com o guia src/data/creations.md ao lado). Os
// números da rolagem, dos efeitos e do canva de fotos ao fundo vêm de
// src/scripts/creations/config.ts, e o motor é src/scripts/creations/. Aqui
// só há markup, CSS e as checagens do build logo abaixo.
//
// Sem a cena 3D nem a transição de água do craft, de propósito: o vocabulário
// é o clássico do site (papel/tinta + botão de tema).
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import {
  CLOSING, CREATIONS, EFFECT_NAMES, FIELD_PHOTOS, KIND_LABEL, OPENING, UI, isInterlude,
} from '../data/creations';
import { EFFECTS, FIELD, FIELD_IMAGE, IMAGE, LAYOUT, RIBBON, STAGE } from '../scripts/creations/config';
import { layoutField } from '../scripts/creations/fieldLayout';
import { timing } from '../scripts/creations/timing';

const pad = (n: number) => String(n).padStart(2, '0');

// ——— o que o build recusa ———
//
// O tipo já impede um efeito inexistente no editor, mas a regra das vizinhas
// e a dos ids repetidos só existem em tempo de build — e é aqui que a lista
// inteira está à mão. A mensagem diz QUAL criação e O QUE fazer, porque quem
// vai ler é quem acabou de reordenar a lista, não quem escreveu isto.
const known = new Set<string>(EFFECT_NAMES);

// A numeração ("Criação 03", o contador, as âncoras #criacao-NN) conta só as
// CRIAÇÕES: um intervalo (ver `Interlude` em data/creations.ts) ocupa um lugar
// na rolagem, mas não é uma criação e não leva número. Contada aqui, uma vez,
// pra conferência e markup lerem o mesmo número.
let counted = 0;
const entries = CREATIONS.map((entry, index) => ({
  entry,
  index,
  number: isInterlude(entry) ? '' : pad(++counted),
}));
const total = pad(counted);

const ids = new Set<string>();
let prevPhoto: { id: string; number: string; effect: string } | null = null;
entries.forEach(({ entry, number }) => {
  if (ids.has(entry.id)) {
    throw new Error(
      `Coleção de Criações: o id "${entry.id}" aparece duas vezes na lista. ` +
        `Cada criação (e cada intervalo) precisa de um id próprio (src/data/creations.ts).`,
    );
  }
  ids.add(entry.id);
  if (isInterlude(entry)) return;

  const creation = entry;
  const here = `a criação ${number} ("${creation.id}")`;
  if (!known.has(creation.effect)) {
    throw new Error(
      `Coleção de Criações: ${here} usa o efeito "${creation.effect}", que não existe. ` +
        `Os efeitos são: ${EFFECT_NAMES.join(', ')} (src/data/creations.ts).`,
    );
  }
  // Um intervalo entre as duas NÃO as separa: as fotos continuam se
  // encaixando uma depois da outra, só com uma tela de texto no meio.
  if (prevPhoto && prevPhoto.effect === creation.effect) {
    throw new Error(
      `Coleção de Criações: as criações ${prevPhoto.number} ("${prevPhoto.id}") e ${number} ("${creation.id}") ` +
        `usam o mesmo efeito "${creation.effect}" em sequência. Troque o efeito de uma delas ` +
        `em src/data/creations.ts.`,
    );
  }
  prevPhoto = { id: creation.id, number, effect: creation.effect };
  // 'pieces' fatia UMA foto no espaço (N ripas da mesma imagem); `evolution`
  // fatia VÁRIAS fotos no tempo, na mesma moldura. As duas ideias usam o
  // mesmo `data-cc-featured` no DOM (ver o motor em field.ts) e não têm como
  // conviver: `strips` e `stages` brigariam pelos mesmos elementos.
  if (creation.evolution && creation.effect === 'pieces') {
    throw new Error(
      `Coleção de Criações: ${here} tem \`evolution\` e usa o efeito "pieces". As duas coisas ` +
        `fatiam a moldura de jeitos incompatíveis — troque o \`effect\` em src/data/creations.ts.`,
    );
  }
  // `gallery` (fotos do MESMO instante, trocadas por clique) usa a mesma
  // pilha de elementos que `evolution` (fotos de instantes DIFERENTES,
  // trocadas pela rolagem) — as duas por cima da mesma criação não fazem
  // sentido, e nenhuma das duas convive com 'pieces' pelo motivo acima.
  if (creation.gallery && creation.effect === 'pieces') {
    throw new Error(
      `Coleção de Criações: ${here} tem \`gallery\` e usa o efeito "pieces". As duas coisas ` +
        `fatiam a moldura de jeitos incompatíveis — troque o \`effect\` em src/data/creations.ts.`,
    );
  }
  if (creation.gallery && creation.evolution) {
    throw new Error(
      `Coleção de Criações: ${here} tem \`gallery\` e \`evolution\` juntos — as duas dividem a ` +
        `mesma moldura de jeitos incompatíveis. Escolha uma em src/data/creations.ts.`,
    );
  }
});

// O andamento do canva (FIELD.TEMPO) desacelera o fundo na leitura e o
// acelera nas passagens. Forte demais, a desaceleração passaria do zero e o
// fundo andaria PRA TRÁS em algum trecho — rolar pra baixo e ver as fotos
// descendo. Não é um erro que se veja olhando o número, então o build confere.
{
  const T = timing(CREATIONS.length);
  const steps = 2000;
  let before = T.warp(0);
  for (let k = 1; k <= steps; k++) {
    const now = T.warp((k / steps) * T.total);
    if (now < before - 1e-9) {
      throw new Error(
        `Coleção de Criações: com FIELD.TEMPO = ${FIELD.TEMPO} o canva do fundo anda pra trás ` +
          `em algum ponto da página. Baixe FIELD.TEMPO ou aumente FIELD.TEMPO_RAMP em ` +
          `src/scripts/creations/config.ts.`,
      );
    }
    before = now;
  }
}

// As variantes de cada imagem saem do pipeline do Astro no build (ver IMAGE
// no config). A proporção viaja como variável CSS: é ela que dimensiona a
// moldura, então uma foto deitada e uma em pé cabem na mesma tela sem que
// nenhuma seja cortada pra caber numa caixa fixa.
const slides = await Promise.all(
  entries.map(async ({ entry, index, number }) => {
    // Um intervalo não tem foto, composição nem número: só o texto e o lugar
    // dele na rolagem. A âncora é o próprio id (ver `Interlude`).
    if (isInterlude(entry)) {
      return { ...entry, index, number, anchor: entry.id };
    }
    const creation = entry;
    const img = await getImage({
      src: creation.image,
      widths: [...IMAGE.WIDTHS],
      format: IMAGE.FORMAT,
      quality: IMAGE.QUALITY,
    });
    // que forma esta criação toma no palco: o que a criação pediu, ou o
    // ciclo de STAGE.CYCLE percorrido pela ordem da lista (ver config.ts).
    // Vira um data-attribute e acaba aí — quem desenha é o CSS, e o motor
    // de encaixe só mede a moldura que sair disso.
    const layout = creation.layout ?? STAGE.CYCLE[index % STAGE.CYCLE.length];

    // Os estágios seguintes da evolução (só existe em quem tem `evolution`,
    // ver data/creations.ts): mesma pipeline do herói — cada estágio ocupa a
    // MESMA moldura dele, no palco, então precisa da mesma qualidade.
    const evolution = creation.evolution
      ? await Promise.all(
          creation.evolution.map(async (step) => {
            const stepImg = await getImage({
              src: step.image,
              widths: [...IMAGE.WIDTHS],
              format: IMAGE.FORMAT,
              quality: IMAGE.QUALITY,
            });
            return { src: stepImg.src, srcset: stepImg.srcSet.attribute, date: step.date, alt: step.alt };
          }),
        )
      : undefined;

    // As fotos extras de uma `gallery` (ver data/creations.ts): mesma
    // pipeline da evolução, sem data — são do mesmo instante, não de instantes
    // diferentes.
    const gallery = creation.gallery
      ? await Promise.all(
          creation.gallery.map(async (photo) => {
            const photoImg = await getImage({
              src: photo.image,
              widths: [...IMAGE.WIDTHS],
              format: IMAGE.FORMAT,
              quality: IMAGE.QUALITY,
            });
            return { src: photoImg.src, srcset: photoImg.srcSet.attribute, alt: photo.alt };
          }),
        )
      : undefined;

    return {
      ...creation,
      interlude: false as const,
      index,
      number,
      anchor: `criacao-${number}`,
      src: img.src,
      srcset: img.srcSet.attribute,
      ratio: creation.image.width / creation.image.height,
      from: creation.from ?? 'right',
      layout,
      evolution,
      gallery,
      // a única coisa que a composição decide fora do CSS: a `full` leva a
      // foto a 100vw e as outras a cabem na moldura (ver IMAGE.SIZES /
      // SIZES_FULL). Precisa ser aqui porque quem escolhe a variante é o
      // navegador, lendo o atributo, antes de qualquer script rodar.
      sizes: layout === 'full' ? IMAGE.SIZES_FULL : IMAGE.SIZES,
    };
  }),
);

// Só as criações, sem os intervalos: são elas que têm foto, fólio e lugar no
// canva. `total` (quantas criações) já saiu da contagem lá em cima.
type Slide = (typeof slides)[number];
type CreationSlide = Extract<Slide, { interlude: false }>;
const creationSlides = slides.filter((s): s is CreationSlide => !s.interlude);
const pieceIndexes = Array.from({ length: EFFECTS.PIECES.COUNT }, (_, k) => k);

// O canva de fotos ao fundo: posições e tamanhos das fotos comuns vêm prontos
// do build (ver scripts/creations/fieldLayout.ts). As fotos das criações
// também entram no canva — a posição delas é função da moldura, medida na
// tela, então aqui só levam os dados da criação. Uma variante por foto da
// lista, e não por lugar no canva: a lista repete.
//
// Desenhadas do plano mais DISTANTE pro mais próximo (FIELD.DEPTH): a pequena
// e lenta nunca passa por cima da grande e rápida. Os data-attributes levam
// tudo que o motor precisa, então a ordem no DOM é livre pra ser a de pintura.
const fieldSources = await Promise.all(
  FIELD_PHOTOS.map((photo) => getImage({ src: photo, ...FIELD_IMAGE })),
);
const fieldCards = layoutField(FIELD_PHOTOS.length, CREATIONS.length)
  .map((card) => ({
    ...card,
    src: fieldSources[card.photo].src,
    ratio: FIELD_PHOTOS[card.photo].width / FIELD_PHOTOS[card.photo].height,
  }))
  .sort((a, b) => a.depth - b.depth);

// A fita da abertura precisa de RIBBON.COUNT fotos que apareçam em toda tela.
// O fieldLayout acrescenta linhas até ter; se mesmo assim faltar (trocaram a
// semente, a densidade ou o COUNT), é melhor o build dizer do que a fita sair
// banguela.
{
  const members = fieldCards.filter((card) => card.rank >= 0).length;
  if (members < RIBBON.COUNT) {
    throw new Error(
      `Coleção de Criações: o canva tem só ${members} fotos que aparecem em toda tela, e a ` +
        `fita da abertura pede ${RIBBON.COUNT}. Baixe RIBBON.COUNT ou aumente FIELD.FILL em ` +
        `src/scripts/creations/config.ts.`,
    );
  }
}
---

<Layout lang="pt">
  <Fragment slot="head">
    <title>Coleção de Criações · Carlos Leonardo</title>
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="preload"
      href="/fonts/playfair-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Palco ou versão simples? Decidido AQUI, antes do primeiro paint, e não
        no bundle: os dois layouts têm alturas de página muito diferentes (um
        palco de uma tela contra oito criações empilhadas), e trocar de um pro
        outro depois do primeiro quadro é a página inteira pulando.

        A resposta vem de duas perguntas. Baixa animação: a escolha feita no
        portão do site (sessionStorage, ver scripts/motion.ts) manda; o
        prefers-reduced-motion do sistema só vale pra quem entrou por link
        direto e nunca passou pelo portão. E "cabe?": abaixo de uma altura
        mínima a tela presa não tem onde pôr moldura + texto (ver LAYOUT no
        config). Sem JS nada disto roda, a marca não existe e o CSS entrega a
        versão simples — que é o layout padrão de propósito. */}
    <script is:inline define:vars={{ minStageHeight: LAYOUT.MIN_STAGE_HEIGHT }}>
      try {
        var mode = sessionStorage.getItem('motion-mode');
        if (mode === 'full' || mode === 'reduced')
          document.documentElement.dataset.motion = mode;
        var reduced = mode === 'reduced' ||
          (!mode && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        var fits = window.innerHeight >= minStageHeight;
        document.documentElement.dataset.creations = !reduced && fits ? 'stage' : 'static';
      } catch (e) {}
    </script>
  </Fragment>

  <div class="paper" aria-hidden="true"></div>

  {/* O `noreferrer` é o que faz a home rodar a abertura inteira ao voltar daqui.
      Ela decide entre a descida da câmera e o anel instantâneo pelo referrer
      (main.ts → isInternalArrival), e pular a descida só faz sentido pras
      páginas do anel: quem volta de lá já a assistiu e ainda renasce no
      segmento de onde saiu. Esta página não está no anel e não é linkada em
      lugar nenhum — chega-se nela pela URL — então sair daqui é uma chegada de
      verdade, não um passo atrás. Sem isto o anel aparecia estático depois da
      cortina de carregamento. */}
  <a class="back" href="/" rel="noreferrer">‹ Voltar</a>

  <button
    class="theme"
    data-theme-toggle
    aria-pressed="false"
    aria-label="Alternar tema claro/escuro"
    title="Tema claro / escuro"
  >
    <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>

  <main class="cc-page">
    {/* O palco: no modo 'stage' é uma tela de altura, presa pelo ScrollTrigger,
        com a abertura e as criações empilhadas em camadas dentro dele; na
        versão simples é só um contêiner, e as mesmas peças viram blocos de
        uma tela cada. Mesmo HTML, dois CSS. */}
    <div class="cc-stage" data-cc-stage>
      {/* O canva de fotos: atrás de tudo, decorativo (sem alt, fora da árvore
          de acessibilidade) e só no palco. Primeiro as fotos comuns (a
          posição vem do build), depois os fólios (o número de cada criação
          num plano próprio, entre o canva e as fotos), depois a foto de cada
          criação, que o motor leva do canva até a moldura — no `pieces`, em N
          ripas, cada uma um elemento próprio recortado à sua fatia. Metade
          das comuns leva uma classe que o CSS esconde no celular.

          Nenhuma foto aqui é `lazy`: todas nascem no canto 0,0, dentro da
          tela, e o lazy nunca adiou nada. Quem ordena a fila é a prioridade —
          as fotos da fita primeiro, porque são a primeira coisa que se vê. */}
      <div
        class="cc-field"
        data-cc-field
        aria-hidden="true"
        style={`--bleed:${FIELD.INNER.BLEED}`}
      >
        {fieldCards.map((c) => (
          <figure
            class:list={['cc-card', { 'is-wide-only': c.wideOnly }]}
            data-cc-card
            data-x={c.x.toFixed(2)}
            data-yc={c.yc.toFixed(3)}
            data-w={c.w}
            data-depth={c.depth.toFixed(3)}
            data-ratio={c.ratio.toFixed(4)}
            data-lit={c.lit ? '1' : '0'}
            data-hero-ok={c.heroOk ? '1' : '0'}
            data-stage-ok={c.stageOk ? '1' : '0'}
            data-rank={c.rank}
            style={`--ratio:${c.ratio.toFixed(4)}`}
          >
            <img
              src={c.src}
              alt=""
              loading="eager"
              fetchpriority={c.rank >= 0 ? 'high' : 'low'}
              decoding="async"
              draggable="false"
            />
          </figure>
        ))}
        {creationSlides.map((s) => (
          <span class="cc-folio" data-cc-folio={s.index} data-layout={s.layout}>{s.number}</span>
        ))}
        {creationSlides.map((s) => {
          // A criação que é um PROCESSO (ver `evolution` em data/creations.ts,
          // hoje só a de pixel art): em vez de fatiar UMA foto no espaço
          // (`pieces`, abaixo), aqui são VÁRIAS fotos empilhadas na mesma
          // moldura, cada uma seu próprio estágio — o field.ts decide qual se
          // vê pela opacidade, avançando um estágio por vez conforme se rola
          // a pausa de leitura. `--ratio` é sempre o da primeira foto (a que
          // chega do canva): é o tamanho da moldura, as outras só cabem nela.
          if (s.evolution) {
            const stages = [{ src: s.src, srcset: s.srcset }, ...s.evolution];
            return stages.map((stage, i) => (
              <figure
                class="cc-card is-featured is-stage"
                data-cc-featured={s.index}
                data-stage={i}
                data-stages={stages.length}
                data-effect={s.effect}
                data-from={s.from}
                data-layout={s.layout}
                data-ratio={s.ratio.toFixed(4)}
                style={`--ratio:${s.ratio.toFixed(4)}`}
              >
                <img
                  src={stage.src}
                  srcset={stage.srcset}
                  sizes={s.sizes}
                  alt=""
                  loading="eager"
                  fetchpriority={i === 0 ? 'auto' : 'low'}
                  decoding="async"
                  draggable="false"
                />
              </figure>
            ));
          }
          // A criação com mais de uma FOTO DO MESMO INSTANTE (ver `gallery`
          // em data/creations.ts): a mesma pilha de `evolution` acima, só que
          // `data-gallery` avisa o field.ts pra NÃO avançar sozinho pela
          // rolagem — quem escolhe o estágio visível é o clique nas setas
          // (ver [data-cc-gallery-nav] mais abaixo e o main.ts).
          if (s.gallery) {
            const photos = [{ src: s.src, srcset: s.srcset }, ...s.gallery];
            return photos.map((photo, i) => (
              <figure
                class="cc-card is-featured"
                data-cc-featured={s.index}
                data-stage={i}
                data-stages={photos.length}
                data-gallery="1"
                data-effect={s.effect}
                data-from={s.from}
                data-layout={s.layout}
                data-ratio={s.ratio.toFixed(4)}
                style={`--ratio:${s.ratio.toFixed(4)}`}
              >
                <img
                  src={photo.src}
                  srcset={photo.srcset}
                  sizes={s.sizes}
                  alt=""
                  loading="eager"
                  fetchpriority={i === 0 ? 'auto' : 'low'}
                  decoding="async"
                  draggable="false"
                />
              </figure>
            ));
          }
          return (s.effect === 'pieces' ? pieceIndexes : [0]).map((k) => (
            <figure
              class:list={['cc-card', 'is-featured', { 'is-strip': s.effect === 'pieces' }]}
              data-cc-featured={s.index}
              data-strip={k}
              data-strips={s.effect === 'pieces' ? EFFECTS.PIECES.COUNT : 1}
              data-effect={s.effect}
              data-from={s.from}
              data-layout={s.layout}
              data-ratio={s.ratio.toFixed(4)}
              style={`--ratio:${s.ratio.toFixed(4)};--k:${k};--n:${EFFECTS.PIECES.COUNT}`}
            >
              <img
                src={s.src}
                srcset={s.srcset}
                sizes={s.sizes}
                alt=""
                loading="eager"
                fetchpriority={s.index === 0 ? 'auto' : 'low'}
                decoding="async"
                draggable="false"
              />
            </figure>
          ));
        })}
      </div>

      <header class="cc-hero" data-cc-hero>
        <p class="eyebrow" data-cc-hero-kicker>{OPENING.kicker}</p>
        {/* O título parte em duas com um VÃO no meio: é ali que a fita da
            abertura corre (o canva reunido numa curva em S, ver RIBBON no
            config). O vão é um span vazio de propósito — ele existe pra ser
            MEDIDO pelo field.ts, do mesmo jeito que a moldura de cada
            criação, e assim a curva cai entre as linhas em qualquer
            tipografia e qualquer tela.

            Cada linha mora numa máscara: na saída da abertura as duas se
            ABREM de novo, no mesmo vão, e cada uma escorrega pra fora da sua
            (ver opening.ts). Continua um <h1> só: pro leitor de tela o texto
            segue sendo "Coleção de criações.", em ordem. */}
        <h1 data-cc-hero-title>
          <span class="cc-title-mask" data-cc-hero-mask><span class="cc-title-line" data-cc-hero-line>{OPENING.title.line1}</span></span>{' '}
          <span class="cc-ribbon-slot" data-cc-ribbon aria-hidden="true"></span>
          <span class="cc-title-mask" data-cc-hero-mask><span class="cc-title-line" data-cc-hero-line><em>{OPENING.title.line2}</em></span></span>
        </h1>
        <p class="lead" data-cc-hero-lead>{OPENING.lead}</p>
        <p class="cc-hint" data-cc-hero-hint aria-hidden="true"><span>{OPENING.hint}</span></p>
      </header>

      {slides.map((s) => s.interlude ? (
        <section
          class="cc-slide cc-interlude"
          id={s.anchor}
          data-cc-slide
          data-cc-interlude
          aria-labelledby={`${s.anchor}-titulo`}
        >
          {/* Um intervalo (ver `Interlude` em data/creations.ts): só o texto,
              centrado, com os mesmos ganchos de uma criação — o motor anima
              rótulo, título, descrição e links do mesmo jeito. Sem
              [data-cc-media]: não há foto pra encaixar, e o partsOf (main.ts)
              reconhece o [data-cc-interlude]. Os links moram num bloco só, que
              é o que a varredura do link revela. */}
          <div class="cc-copy" data-cc-copy>
            <p class="cc-kicker" data-cc-line data-cc-kicker>{s.kicker}</p>
            <h2 class="cc-title" id={`${s.anchor}-titulo`} data-cc-line data-cc-title>{s.title}</h2>
            <p class="cc-desc" data-cc-line data-cc-desc>{s.description}</p>
            <div class="cc-interlude-links" data-cc-line data-cc-link>
              {s.links.map((link) => (
                <a class="cc-link" href={link.href} target="_blank" rel="noopener">
                  {link.label} <span aria-hidden="true">{UI.linkMark}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : (
        <section
          class="cc-slide"
          id={s.anchor}
          data-cc-slide
          data-cc-number={s.number}
          data-effect={s.effect}
          data-from={s.from}
          data-layout={s.layout}
          aria-labelledby={`${s.anchor}-titulo`}
          style={`--ratio:${s.ratio.toFixed(4)}`}
        >
          {/* A moldura. No palco é só o LUGAR: a foto que se vê é a do canva,
              que vem se encaixar aqui (o motor mede esta caixa). A <img>
              existe pra versão simples — lá não há canva — e pelo alt, que
              o leitor de tela lê nos dois casos; no palco ela fica
              invisível por CSS. Mesma URL da foto do canva: um download. */}
          <div class="cc-media" data-cc-media>
            <img
              src={s.src}
              srcset={s.srcset}
              sizes={s.sizes}
              alt={s.alt}
              loading={s.index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
          </div>

          {/* Cada peça do texto tem o próprio gancho, porque cada uma se revela
              de um jeito (ver TYPE no config); o data-cc-line fica pra versão
              simples. */}
          <div class="cc-copy" data-cc-copy>
            <p class="cc-kicker" data-cc-line data-cc-kicker>
              {UI.item} {s.number} · {KIND_LABEL[s.kind]}{s.date && ` · ${s.date}`}{s.missingPhoto && <span class="cc-missing-tag">{UI.missingPhoto}</span>}
            </p>
            <h2 class="cc-title" id={`${s.anchor}-titulo`} data-cc-line data-cc-title>{s.title}</h2>
            <p class="cc-desc" data-cc-line data-cc-desc>{s.description}</p>
            {/* O fallback da versão simples: sem rolagem presa, não há como a
                foto ir mudando sozinha (isso é só do palco, ver o
                cc-card.is-stage no canva) — então aqui a evolução vira uma
                fileira sempre visível, e o CSS a esconde no palco pra não
                duplicar o que a moldura já está fazendo. */}
            {s.evolution && (
              <div class="cc-evolution" data-cc-line>
                <p class="cc-evolution-label">{UI.evolutionLabel}</p>
                <ol class="cc-evolution-strip">
                  {s.evolution.map((step) => (
                    <li>
                      <figure>
                        <img
                          src={step.src}
                          srcset={step.srcset}
                          sizes="4rem"
                          alt={step.alt}
                          loading="lazy"
                          decoding="async"
                          draggable="false"
                        />
                        <figcaption>{step.date}</figcaption>
                      </figure>
                    </li>
                  ))}
                </ol>
              </div>
            )}
            {/* O mesmo fallback, pra `gallery` (ver o comentário acima): sem
                clique animado a versão simples não tem como trocar a foto
                sozinha, então aqui as fotos extras viram uma fileira sempre
                visível — sem data, porque são do MESMO instante, não de
                instantes diferentes. */}
            {s.gallery && (
              <div class="cc-gallery-strip" data-cc-line>
                <p class="cc-gallery-strip-label">{UI.galleryLabel}</p>
                <ul class="cc-gallery-strip-list">
                  {s.gallery.map((photo) => (
                    <li>
                      <img
                        src={photo.src}
                        srcset={photo.srcset}
                        sizes="6rem"
                        alt={photo.alt}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {s.link && (
              <a class="cc-link" data-cc-line data-cc-link href={s.link.href} target="_blank" rel="noopener">
                {s.link.label} <span aria-hidden="true">{UI.linkMark}</span>
              </a>
            )}
          </div>

        </section>
      ))}
    </div>

    <footer class="cc-closing" data-cc-closing>
      <div class="cc-closing-inner" data-cc-closing-inner>
        <p class="eyebrow">{CLOSING.kicker}</p>
        <h2>{CLOSING.title}</h2>
        <p class="lead">{CLOSING.text}</p>
        <p class="cc-closing-quote">{CLOSING.quote}</p>
        <nav aria-label="Voltar pro resto do site">
          {CLOSING.links.map((link) => (
            <a href={link.href} rel={link.href === '/' ? 'noreferrer' : undefined}>{link.label}</a>
          ))}
        </nav>
      </div>
    </footer>
  </main>

  {/* O contador ("03 / 28"): o número que o leitor de tela anuncia
      (escondido, e só muda quando a criação muda) e a coluna que se VÊ, que
      rola de um número pro outro (ver nav.ts). Um intervalo não tem número:
      enquanto ele está na tela a coluna mostra "—". */}
  <div class="cc-nav" data-cc-nav>
    <p class="cc-nav-count">
      <span class="cc-sr" data-cc-nav-current aria-live="polite">—</span>
      <span class="cc-roll" aria-hidden="true"><span class="cc-roll-col" data-cc-roll>{['—', ...slides.map((s) => s.number || '—')].map((label) => <span>{label}</span>)}</span></span><span class="cc-nav-sep" aria-hidden="true">/</span><span>{total}</span>
    </p>
  </div>

  {/* As setas da galeria (ver `gallery` em data/creations.ts), uma barra por
      criação que tem mais de uma foto. FORA do palco (que é cheio de
      transform: a `full` centraliza a foto com translate, e um transform em
      qualquer ancestral vira o "containing block" de um position:fixed,
      quebrando a promessa de ficar preso à TELA) — aqui, soltas no fim do
      documento, cada uma realmente fica onde `position:fixed` diz. O main.ts
      mostra só a da criação ativa (ver onActive lá) e liga o clique nas
      setas. */}
  {creationSlides.filter((s) => s.gallery).map((s) => (
    <div class="cc-gallery-nav" data-cc-gallery-nav={s.index} data-cc-gallery-count={(s.gallery?.length ?? 0) + 1}>
      <button type="button" class="cc-gallery-btn" data-cc-gallery-prev aria-label="Foto anterior">‹</button>
      <span class="cc-gallery-label" data-cc-gallery-label>{`1 / ${(s.gallery?.length ?? 0) + 1}`}</span>
      <button type="button" class="cc-gallery-btn" data-cc-gallery-next aria-label="Próxima foto">›</button>
    </div>
  ))}
</Layout>

<script>
  import { initTheme } from '../scripts/theme';
  import { initCreations } from '../scripts/creations/main';

  initTheme();
  initCreations();
</script>

<style>
  .paper {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    transition: background-color var(--theme-fade);
  }

  /* A página rola — e o global.css dá a html e body o `height: 100%` +
     `overflow: hidden` de que a HOME precisa (canvas fixo, quem rola lá é o
     Lenis). Aqui os dois voltam ao normal, como na /work e na /craft. Sem
     isto o sintoma engana: o overflow do body propaga pro viewport, a página
     aparece inteira e nenhum gesto chega nela. */
  :global(html:has(.cc-page)),
  :global(html:has(.cc-page) body) {
    height: auto;
    overflow: visible;
  }

  /* Durante a ENTRADA a página já tem a altura inteira (o pin nasce antes
     dela, ver intro.ts), então a rolagem é travada: no desktop pelo Lenis
     parado, e aqui pro toque — mais específico que a regra acima, que
     devolve o overflow. A barra de rolagem do site some junto: convidar a
     rolar durante a entrada seria convidar a perdê-la. */
  :global(html.is-intro:has(.cc-page)) {
    overflow: hidden;
  }

  :global(html[data-creations='stage'] .liquid-scrollbar) {
    transition: opacity 0.6s ease;
  }

  :global(html.is-intro .liquid-scrollbar) {
    opacity: 0;
  }

  .cc-page {
    position: relative;
    z-index: 1;
    color: var(--ink);
    transition: color var(--theme-fade);
  }

  /* ——— o palco ———
     O CSS padrão é a VERSÃO SIMPLES (blocos empilhados, uma tela cada). O
     palco só existe sob html[data-creations='stage'], que o script inline do
     <head> escreve quando há JS, animação e altura pra isso. Errar pro lado
     do empilhado é errar pro lado que sempre funciona. */
  .cc-stage {
    position: relative;
  }

  :global(html[data-creations='stage']) .cc-stage {
    height: var(--viewport-h);
    overflow: hidden;
  }

  /* ——— o canva de fotos ao fundo ———
     Só existe no palco: empilhada, a página é uma lista e um fundo que rola
     por trás dela não faria sentido. Toda foto é posicionada pelo motor
     (transform, a partir do canto 0,0), então o CSS só dá a forma.

     A opacidade de cada foto é escrita PRONTA pelo motor (field.ts) — o
     nível dela, a respiração do canva e o teto do celular já multiplicados.
     Eram variáveis herdadas daqui, e mudar a respiração recalculava o estilo
     de todas as figuras a cada quadro. */
  .cc-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: none;
    overflow: hidden;
    pointer-events: none;
  }

  :global(html[data-creations='stage']) .cc-field {
    display: block;
  }

  .cc-card {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    aspect-ratio: var(--ratio);
    /* apagada até o motor escrever a opacidade dela */
    opacity: 0;
    transform-origin: center center;
    backface-visibility: hidden;
  }

  /* antes da primeira medida não há largura nem posição; e fora da tela
     (com folga) o motor desliga a foto em vez de movê-la */
  .cc-field:not(.is-ready) .cc-card,
  .cc-card.is-off {
    visibility: hidden;
  }

  .cc-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* a foto de uma criação passa por cima das comuns e dos fólios — e por
     baixo do texto, que está na criação (z-index 1, acima do canva) */
  .cc-card.is-featured {
    z-index: 2;
    overflow: hidden;
  }

  /* A foto anda DENTRO da moldura (ver FIELD.INNER): a imagem é deitada
     --bleed maior em cima e embaixo, e o motor só a translada. A sobra fica
     cortada pela figura. Janela, e não zoom — zoom re-rasterizaria a foto a
     cada quadro. */
  .cc-card.is-featured img {
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(var(--bleed, 0) * -100%);
    height: calc(100% + var(--bleed, 0) * 200%);
  }

  /* as ripas do `pieces`: N cópias da foto no mesmo lugar, cada uma recortada
     à sua fatia. --gap é o motor abrindo uma fresta entre elas no momento da
     onda (ver EFFECTS.PIECES); em repouso é 0 e as fatias se encostam. */
  .cc-card.is-strip {
    clip-path: inset(
      0 calc((var(--n) - 1 - var(--k)) / var(--n) * 100% + var(--gap, 0) * 1px) 0
        calc(var(--k) / var(--n) * 100% + var(--gap, 0) * 1px)
    );
  }

  /* os estágios da evolução: N fotos EMPILHADAS na mesma moldura — o field.ts
     decide qual se vê trocando só a opacidade (`stageOp`), então aqui não há
     nada pra recortar. `contain`, e não `cover` como o resto da página: cada
     estágio tem a SUA proporção (algumas bem mais largas que a moldura, que
     segue a do primeiro estágio), e cortar pixel art já composta esconde
     parte do desenho — o fundo cobre a folga que sobra dos lados. */
  .cc-card.is-featured.is-stage img {
    object-fit: contain;
    background: rgba(var(--ink-rgb), 0.06);
    transition: background-color var(--theme-fade);
  }

  /* O VÉU da composição `full` mora NA FOTO. Ele existe pro texto branco ler
     sobre ela, então vai aonde ela for, encolhe com ela e é cortado por ela:
     quando a foto sai, não sobra uma faixa escura sobre papel vazio (era o
     defeito de quando ele morava na criação).

     A caixa dele começa no alto da TELA dentro da foto no encaixe (a moldura
     da `full` é centrada e nunca menor que o viewport — ver .cc-media da
     full, os dois comentários apontam um pro outro), e vai até o PÉ DA FOTO:
     o degradê termina escuro na altura da tela e continua escuro dali pra
     baixo. Com a caixa do tamanho exato da tela, a borda de baixo dela
     aparecia como uma linha dura atravessando a foto assim que ela encolhia
     na saída. As paradas são em --viewport-h, e não em %, pelo mesmo motivo.

     A opacidade segue --dock, o quanto a foto já chegou, e começa atrasada
     (o -0.35): enquanto ela ainda é miniatura, véu nenhum. O will-change dá a
     ele camada própria, pra o fade não repintar a foto. */
  .cc-card.is-featured[data-layout='full']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% - var(--viewport-h) / 2);
    bottom: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) calc(var(--viewport-h) * 0.22),
      rgba(0, 0, 0, 0.12) calc(var(--viewport-h) * 0.45),
      rgba(0, 0, 0, 0.55) calc(var(--viewport-h) * 0.74),
      rgba(0, 0, 0, 0.82) var(--viewport-h)
    );
    opacity: clamp(0, calc(var(--dock, 0) * 1.6 - 0.35), 1);
    will-change: opacity;
  }

  /* ——— o fólio ———
     O número da criação em itálico gigante, a 6% de tinta, num plano entre o
     canva e as fotos. Ele atravessa a criação subindo mais devagar que tudo
     (ver TYPE.FOLIO) e fica do lado do TEXTO de cada composição, onde há ar.
     Some atrás da foto numa `full`, e nunca passa por cima de uma. */
  .cc-folio {
    position: absolute;
    z-index: 1;
    right: 6vw;
    bottom: -4vh;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(9rem, 30vw, 28rem);
    font-style: italic;
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: rgba(var(--ink-rgb), 0.06);
    opacity: 0;
    pointer-events: none;
    user-select: none;
    will-change: transform, opacity;
    transition: color var(--theme-fade);
  }

  .cc-folio[data-layout='flip'],
  .cc-folio[data-layout='tower'],
  .cc-folio[data-layout='quiet'] {
    left: 6vw;
    right: auto;
  }

  /* a abertura e as criações ficam por cima do canva */
  :global(html[data-creations='stage']) .cc-hero,
  :global(html[data-creations='stage']) .cc-slide {
    z-index: 1;
  }

  /* ——— a abertura ——— */
  /* Composição centrada e simétrica, e tem que ser: a fita corre ENTRE as
     duas linhas do título, e uma curva centrada sob um título alinhado à
     esquerda não é composição, é sobreposição. */
  .cc-hero {
    position: relative;
    min-height: var(--viewport-h);
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    padding: clamp(3rem, 7vh, 5rem) clamp(1.5rem, 6vw, 6rem) clamp(2.5rem, 6vh, 4.5rem);
  }

  :global(html[data-creations='stage']) .cc-hero {
    position: absolute;
    inset: 0;
    min-height: 0;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  /* A tipografia encolheu: com o vão da fita no meio, as duas linhas mais o
     vão mais o rótulo e o parágrafo têm que caber numa tela SEM rolar — a
     abertura é a única parte da página que não tem pra onde crescer. */
  .cc-hero h1 {
    display: grid;
    justify-items: center;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.6rem, min(8vw, 9.5vh), 5.6rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .cc-hero h1 em {
    font-weight: 400;
  }

  /* As linhas do título, cada uma na sua máscara. A máscara só corta no
     palco (é lá que as linhas escorregam pra fora dela); o padding com
     margem negativa dá espaço pro acento do "ç", pro til do "ã" e pra
     cauda do itálico, sem mudar o lugar de nada. */
  .cc-title-mask,
  .cc-title-line {
    display: block;
  }

  :global(html[data-creations='stage']) .cc-title-mask {
    overflow: hidden;
    padding: 0.14em 0.14em 0.24em;
    margin: -0.14em -0.14em -0.24em;
  }

  /* A regra de dono da abertura (ver intro.ts e opening.ts): a opacidade
     destas peças é da ENTRADA, pelas duas variáveis que ela escreve na raiz
     da abertura. A saída nunca escreve opacidade aqui — ela move, recorta e
     lava. O --exit-a só existe pro parágrafo em navegador sem mask-image. */
  :global(html[data-creations='stage']) [data-cc-hero-title] {
    opacity: var(--intro-title, 1);
  }

  :global(html[data-creations='stage']) [data-cc-hero-kicker],
  :global(html[data-creations='stage']) [data-cc-hero-hint] {
    opacity: var(--intro-rest, 1);
  }

  :global(html[data-creations='stage']) [data-cc-hero-lead] {
    opacity: calc(var(--intro-rest, 1) * var(--exit-a, 1));
  }

  /* O VÃO onde a fita corre. Não tem conteúdo e não desenha nada: é uma caixa
     pro field.ts MEDIR (getBoundingClientRect), do mesmo jeito que ele mede a
     moldura de cada criação. Por isso a curva cai entre as linhas em qualquer
     tipografia e qualquer tela, sem que o motor saiba o que é uma fonte.

     Na versão simples não há canva nem fita, e ele colapsa — senão seria um
     buraco no meio do título sem motivo nenhum. */
  .cc-ribbon-slot {
    display: block;
    width: 100%;
    height: 0;
  }

  :global(html[data-creations='stage']) .cc-ribbon-slot {
    height: min(44dvh, 26rem);
    transition: height 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* O vão se fecha quando a fita estoura: as fotos saem dali e o título se
     junta atrás delas, no mesmo gesto. Fechar por altura, e não por
     transform, porque o que tem que acontecer é o título REFLUIR: as duas
     linhas se aproximando de verdade. */
  :global(html.is-intro-done) .cc-ribbon-slot {
    height: 0;
  }

  .lead {
    max-width: 31rem;
    margin-top: clamp(1.4rem, 3.5vh, 2.2rem);
    color: rgba(var(--ink-rgb), 0.68);
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.62;
    transition: color var(--theme-fade);
  }

  /* a dica de rolar: um rótulo e um fio que pulsa. Só no palco — na versão
     simples a página é uma lista e ninguém precisa ser convidado a rolar */
  .cc-hint {
    position: absolute;
    left: 50%;
    bottom: calc(1.6rem + env(safe-area-inset-bottom));
    display: none;
    justify-items: center;
    gap: 0.7rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transform: translateX(-50%);
    transition: color var(--theme-fade);
  }

  :global(html[data-creations='stage']) .cc-hint {
    display: grid;
  }

  .cc-hint::after {
    content: '';
    width: 1px;
    height: 2.4rem;
    background: currentColor;
    animation: cc-hint-pulse 1.8s ease-in-out infinite alternate;
  }

  @keyframes cc-hint-pulse {
    from { opacity: 0.25; transform: scaleY(0.6); transform-origin: top; }
    to { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  /* ——— as criações ——— */
  .cc-slide {
    position: relative;
    min-height: var(--viewport-h);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(4.5rem, 9vh, 6rem) clamp(1.5rem, 6vw, 6rem);
  }

  /* No palco as criações são camadas: mesma caixa, uma sobre a outra, e o
     GSAP decide qual está visível. O `visibility: hidden` aqui é o estado
     antes de o bundle rodar — sem ele, o quadro entre o script inline e o
     módulo mostraria as oito empilhadas na mesma tela. O GSAP escreve
     visibility inline (autoAlpha) e o inline ganha desta regra. */
  :global(html[data-creations='stage']) .cc-slide {
    position: absolute;
    inset: 0;
    min-height: 0;
    visibility: hidden;
  }

  /* A moldura tem a PROPORÇÃO da imagem (--ratio, escrita no build) e é
     limitada por altura (--frame-h) e pela coluna. A largura sai da conta
     explícita em vez de deixar o navegador transferir o max-height pela
     aspect-ratio: dá o mesmo resultado, sem depender de como cada motor
     resolve essa transferência. */
  .cc-media {
    --frame-h: min(72dvh, 46rem);
    --frame-cap: 100%;
    position: relative;
    justify-self: end;
    width: min(var(--frame-cap), calc(var(--frame-h) * var(--ratio)));
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: rgba(var(--ink-rgb), 0.06);
    transition: background-color var(--theme-fade);
  }

  .cc-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* ——— as setas da galeria (só o palco) ———
     Fixas, e não dentro da moldura: a `full` centraliza a foto com
     `translate`, e um transform em qualquer ancestral vira o "containing
     block" de um `position:fixed` — a barra ficaria presa a essa foto enorme
     e centralizada, não à tela (ver o comentário do markup, no fim da
     página). Por isso o markup delas mora solto, fora do palco, e só a da
     criação ATIVA aparece (`.is-active`, ligado pelo main.ts do mesmo jeito
     que o contador sabe qual criação está na tela). O lugar, logo abaixo da
     foto, é o main.ts que escreve (ver `placeGallery` lá) — daí o top/left
     zerados aqui. Escondidas na versão simples: lá não há canva pra trocar,
     e `.cc-gallery-strip` mostra as fotos extras de outro jeito (ver o CSS
     dela). */
  .cc-gallery-nav {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    display: none;
    align-items: center;
    gap: 0.55rem;
    will-change: transform;
  }

  :global(html[data-creations='stage']) .cc-gallery-nav.is-active {
    display: flex;
  }

  .cc-gallery-btn {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .cc-gallery-btn:hover,
  .cc-gallery-btn:focus-visible {
    background: rgba(0, 0, 0, 0.65);
  }

  .cc-gallery-label {
    min-width: 3.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* ═══ AS COMPOSIÇÕES ═══════════════════════════════════════════════════
     A forma que cada criação toma no palco. Os nomes e o que cada um quer
     dizer estão em data/creations.ts → LAYOUT_NAMES; a ordem em que aparecem
     está em scripts/creations/config.ts → STAGE.CYCLE. Aqui é a geometria.

     Tudo isto é layout puro, e mesmo assim é o que mais muda a animação: o
     motor de encaixe MEDE a moldura (getBoundingClientRect) e leva a foto até
     ela, do tamanho que ela for. Uma moldura que cobre a tela é uma foto que
     cresce até cobrir a tela — e o mesmo `grow` que era um crescimentozinho
     no centro vira um zoom de tela cheia, sem uma linha de JS.

     Duas regras que valem pra todas:
       • a caixa tem SEMPRE a proporção da foto (--ratio), e o tamanho sai de
         uma altura-alvo (--frame-h) com um teto de largura (--frame-cap).
       • só no palco. Na versão simples (tela baixa, baixa animação) a página
         é uma pilha comum, e composição ali seria enfeite sobre um fallback.

     A moldura pode passar da tela de propósito (tower, edge, full). Quem
     corta é o .cc-field, que tem overflow: hidden no tamanho do viewport — e
     o getBoundingClientRect ignora corte de ancestral, então o motor continua
     enxergando a caixa inteira e mandando a foto pro lugar certo. */
  :global(html[data-creations='stage']) .cc-slide {
    /* uma moldura que sangra não pode virar barra de rolagem horizontal */
    overflow: hidden;
  }

  @media (min-width: 46.01rem) {
    /* ——— flip: o duet espelhado ———
       A proporção das colunas troca junto, senão a moldura da direita nasce
       menor que a da esquerda só por estar do outro lado. */
    :global(html[data-creations='stage']) .cc-slide[data-layout='flip'] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
    :global(html[data-creations='stage']) [data-layout='flip'] .cc-media {
      grid-column: 2;
      justify-self: start;
    }
    :global(html[data-creations='stage']) [data-layout='flip'] .cc-copy {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
    }

    /* A folga do indicador. Ele é fixo à direita e ocupa uns 65px de largura
       contra os 86 de padding do slide — só que ele não fica DENTRO desse
       padding: medido, ele começa 3px antes da borda do conteúdo. Estas duas
       encostam ali, então param antes. */
    :global(html[data-creations='stage']) [data-layout='tower'] .cc-media,
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-media {
      margin-right: 1.6rem;
    }

    /* ——— tower: mais alta que a tela, estreita, encostada na borda ———
       Ela sangra em cima e embaixo, e SÓ: o indicador lateral é fixo no meio
       da altura, exatamente onde uma borda direita sangrando passaria.
       Conteúdo não passa por cima de navegação permanente. */
    :global(html[data-creations='stage']) [data-layout='tower'] .cc-media {
      --frame-h: 116dvh;
      --frame-cap: 52vw;
      grid-column: 2;
      justify-self: end;
    }
    :global(html[data-creations='stage']) [data-layout='tower'] .cc-copy {
      grid-column: 1;
      grid-row: 1;
      max-width: 26rem;
    }

    /* ——— quiet: pequena num canto, texto no oposto ———
       A única em que a foto NÃO é o assunto principal da tela: ela vira um
       selo no alto e quem manda é o título. Depois de uma full, é o silêncio
       que faz a próxima cheia valer. */
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-media {
      --frame-h: 38dvh;
      --frame-cap: 24vw;
      grid-column: 2;
      justify-self: end;
      align-self: start;
    }
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-copy {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
      max-width: 34rem;
    }
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-title {
      font-size: clamp(3rem, 6vw, 6rem);
    }

    /* ——— edge: grande, jogada pra fora da borda esquerda ———
       Uns 16vw ficam de fora. O texto do outro lado tem que estar inteiro na
       tela, senão vira só uma foto mal posicionada. */
    :global(html[data-creations='stage']) .cc-slide[data-layout='edge'] {
      /* a primeira coluna encolhe porque boa parte dela está fora da tela */
      grid-template-columns: minmax(0, 0.62fr) minmax(0, 1fr);
    }
    :global(html[data-creations='stage']) [data-layout='edge'] .cc-media {
      --frame-h: 88dvh;
      --frame-cap: 62vw;
      grid-column: 1;
      justify-self: start;
      margin-left: -16vw;
    }
  }

  /* ——— full: a foto ocupa a página inteira ———
     Vale em toda largura, inclusive no celular.

     A moldura é a MENOR caixa com a proporção da foto que ainda cobre o
     viewport: max(largura da tela, altura da tela x proporção). O que sobra
     em uma direção sangra pra fora e o .cc-field corta. O véu que escurece o
     pé da tela mora na foto do canva, e conta com esta caixa ser centrada e
     nunca menor que a tela (ver .cc-card.is-featured[data-layout='full']).

     O padding do slide vai a zero pra caixa nascer do canto do viewport, e
     volta no texto: aqui ele flutua sobre a foto, não divide espaço com ela. */
  :global(html[data-creations='stage']) .cc-slide[data-layout='full'] {
    padding: 0;
    grid-template-columns: minmax(0, 1fr);
  }

  :global(html[data-creations='stage']) [data-layout='full'] .cc-media {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: max(100%, calc(var(--viewport-h) * var(--ratio)));
    max-width: none;
  }

  /* O texto por cima do véu. Trocar --ink e --ink-rgb aqui vira todas as
     linhas de uma vez — e continua branco nos dois temas, porque quem manda
     no contraste agora é a foto, não o tema da página. */
  :global(html[data-creations='stage']) [data-layout='full'] .cc-copy {
    --ink: #fff;
    --ink-rgb: 255, 255, 255;
    position: absolute;
    z-index: 1;
    left: 0;
    bottom: 0;
    padding: clamp(1.6rem, 5vw, 5rem);
    padding-right: clamp(3.2rem, 8vw, 7rem);
    max-width: min(42rem, 100%);
    color: #fff;
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.4);
  }

  /* no palco a moldura é só o lugar medido pelo motor: transparente, com a
     própria foto invisível — quem aparece ali é a foto do canva se
     encaixando. A <img> continua no documento pelo alt. */
  :global(html[data-creations='stage']) .cc-media {
    background: none;
  }

  :global(html[data-creations='stage']) .cc-media img {
    visibility: hidden;
  }

  .cc-copy {
    max-width: 30rem;
  }

  .cc-kicker {
    margin-bottom: 1.1rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  /* O aviso de "Fotos em falta" (ver `missingPhoto` em data/creations.ts):
     mora DENTRO do kicker de propósito, e não como elemento à parte — assim
     ele herda a mesma varredura (clip-path) que já revela o kicker inteiro,
     sem precisar de mais uma peça no motor de tipografia (ver
     scripts/creations/effects.ts → wipe). O laço tracejado ecoa a moldura
     reservada da própria foto-placeholder, e a tinta cheia (contra os 48% do
     resto do kicker) é o que faz o aviso realmente se notar. */
  .cc-missing-tag {
    display: inline-block;
    margin-left: 0.6em;
    padding: 0.16em 0.6em;
    border: 1px dashed rgba(var(--ink-rgb), 0.5);
    border-radius: 999px;
    color: rgba(var(--ink-rgb), 0.85);
    transition: color var(--theme-fade), border-color var(--theme-fade);
  }

  .cc-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  /* ——— as palavras mascaradas (ver type.ts) ———
     O SplitText embrulha cada palavra do título numa máscara (.cc-wd-mask) e
     a palavra sobe de dentro dela. overflow: hidden, e não o clip que ele
     escreve inline: no iOS abaixo do 16 o clip inline é inválido e cai, e
     esta regra fica no lugar. O padding com margem negativa guarda o acento
     do "Tí", o "ç" e a cauda do itálico, que numa altura de linha de 0.96
     seriam cortados. Na `full` a sobra é maior: a sombra do texto não pode
     ser cortada. */
  .cc-title :global(.cc-wd-mask),
  .cc-closing h2 :global(.cc-wd-mask) {
    display: inline-block;
    overflow: hidden;
    padding: 0.16em 0.1em 0.22em;
    margin: -0.16em -0.1em -0.22em;
    vertical-align: top;
  }

  .cc-title :global(.cc-wd),
  .cc-closing h2 :global(.cc-wd) {
    display: inline-block;
  }

  :global(html[data-creations='stage']) [data-layout='full'] .cc-title :global(.cc-wd-mask) {
    padding: 0.3em 0.3em 0.4em;
    margin: -0.3em -0.3em -0.4em;
  }

  .cc-desc {
    margin-top: clamp(1.1rem, 2.4vh, 1.6rem);
    color: rgba(var(--ink-rgb), 0.68);
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.62;
    transition: color var(--theme-fade);
  }

  /* ——— a fita de evolução (só a versão simples) ———
     Só existe na criação de pixel art (ver `evolution` em data/creations.ts):
     uma fileira pequena de miniaturas mais antigas, cada uma com a data
     embaixo, terminando na foto que a moldura já mostra. Rola na horizontal
     se não couber — mais fácil que decidir quantas cabem em cada tela.

     No PALCO ela some: lá a própria moldura já vai passando pelos estágios
     conforme se rola (ver .cc-card.is-stage, mais abaixo, e o `stageOp` em
     field.ts) — mostrar a fita também seria contar a mesma história duas
     vezes. Esta fileira é só o que a versão simples tem pra oferecer no
     lugar da rolagem presa que ela não roda. */
  .cc-evolution {
    margin-top: clamp(1.2rem, 2.6vh, 1.8rem);
  }

  :global(html[data-creations='stage']) .cc-evolution {
    display: none;
  }

  .cc-evolution-label {
    margin-bottom: 0.6rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  .cc-evolution-strip {
    display: flex;
    gap: 0.55rem;
    list-style: none;
    overflow-x: auto;
    padding-bottom: 0.2rem;
    -webkit-overflow-scrolling: touch;
  }

  .cc-evolution-strip li {
    flex: none;
  }

  .cc-evolution-strip figure {
    margin: 0;
    display: grid;
    gap: 0.35rem;
    justify-items: center;
  }

  .cc-evolution-strip img {
    display: block;
    width: 3.4rem;
    height: 3.4rem;
    object-fit: cover;
    border-radius: 3px;
    background: rgba(var(--ink-rgb), 0.06);
    transition: background-color var(--theme-fade);
  }

  .cc-evolution-strip figcaption {
    color: rgba(var(--ink-rgb), 0.55);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: color var(--theme-fade);
  }

  /* ——— a fileira de galeria (só a versão simples) ———
     O mesmo fallback de `.cc-evolution` acima, pra `gallery` (ver
     data/creations.ts): sem data embaixo, porque as fotos são do MESMO
     instante — a moldura já mostra a primeira, esta fileira é só o resto. No
     PALCO ela some: lá quem troca a foto são as setas dentro da própria
     moldura (`.cc-gallery-nav`, logo abaixo). */
  .cc-gallery-strip {
    margin-top: clamp(1.2rem, 2.6vh, 1.8rem);
  }

  :global(html[data-creations='stage']) .cc-gallery-strip {
    display: none;
  }

  .cc-gallery-strip-label {
    margin-bottom: 0.6rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  .cc-gallery-strip-list {
    display: flex;
    gap: 0.55rem;
    list-style: none;
    overflow-x: auto;
    padding-bottom: 0.2rem;
    -webkit-overflow-scrolling: touch;
  }

  .cc-gallery-strip-list li {
    flex: none;
  }

  .cc-gallery-strip-list img {
    display: block;
    width: 4.6rem;
    height: 4.6rem;
    object-fit: cover;
    border-radius: 3px;
    background: rgba(var(--ink-rgb), 0.06);
    transition: background-color var(--theme-fade);
  }

  .cc-link {
    display: inline-block;
    margin-top: 1.6rem;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(var(--ink-rgb), 0.25);
    text-underline-offset: 3px;
    transition: color var(--theme-fade), text-decoration-color 0.25s ease;
  }

  .cc-link:hover,
  .cc-link:focus-visible {
    text-decoration-color: currentColor;
  }

  /* ——— o intervalo (ver `Interlude` em data/creations.ts) ———
     Uma tela só de texto, sem moldura: uma coluna, centrada. É o mesmo bloco
     no palco e na versão simples — o que muda entre as duas é só o que já
     muda pra toda criação. */
  .cc-slide.cc-interlude {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }

  .cc-interlude .cc-copy {
    max-width: 36rem;
  }

  .cc-interlude .cc-title {
    font-size: clamp(2.8rem, 6vw, 5.6rem);
  }

  .cc-interlude-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.8rem;
    margin-top: 1.6rem;
  }

  .cc-interlude-links .cc-link {
    margin-top: 0;
  }

  /* ——— a lavagem ———
     A descrição e os parágrafos da abertura e do fechamento se revelam por
     um degradê de MÁSCARA que desce por eles, levemente inclinado como uma
     pincelada: --in empurra a borda de baixo (entrando), --out a de cima
     (saindo, continuando pra baixo). Nada é dividido, então o texto continua
     um parágrafo pro leitor de tela e reflui como qualquer parágrafo.

     O repouso é VISÍVEL (--in 1, --out 0): o revert do refresh e a versão
     simples caem aqui. A mesma pergunta do @supports é feita no JS (type.ts
     → WASH); onde a resposta é não, o JS usa opacidade. */
  @supports (mask-image: linear-gradient(#000 calc(1% + 1em), #000)) or (-webkit-mask-image: linear-gradient(#000 calc(1% + 1em), #000)) {
    :global(html[data-creations='stage']) .cc-desc,
    :global(html[data-creations='stage']) .cc-hero .lead,
    :global(html[data-creations='stage']) .cc-closing .lead {
      --in: 1;
      --out: 0;
      --f: 2.6em;
      --a: calc(var(--out) * (100% + var(--f)) - var(--f));
      --b: calc(var(--in) * (100% + var(--f)) - var(--f));
      -webkit-mask-image: linear-gradient(
        172deg,
        transparent var(--a),
        #000 calc(var(--a) + var(--f)),
        #000 var(--b),
        transparent calc(var(--b) + var(--f))
      );
      mask-image: linear-gradient(
        172deg,
        transparent var(--a),
        #000 calc(var(--a) + var(--f)),
        #000 var(--b),
        transparent calc(var(--b) + var(--f))
      );
    }

    /* na `full` a sombra do texto passa da caixa, e a máscara corta na
       borda: a caixa cresce pra dentro da sombra sem sair do lugar */
    :global(html[data-creations='stage']) [data-layout='full'] .cc-desc {
      padding: 1.5rem;
      margin: calc(clamp(1.1rem, 2.4vh, 1.6rem) - 1.5rem) -1.5rem -1.5rem;
    }
  }

  /* ——— o fechamento ——— */
  .cc-closing {
    min-height: var(--viewport-h);
    display: grid;
    place-items: center;
    padding: clamp(5rem, 12vh, 8rem) clamp(1.5rem, 6vw, 6rem);
    text-align: center;
  }

  .cc-closing-inner {
    display: grid;
    justify-items: center;
  }

  .cc-closing h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.6rem, 6vw, 5.4rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .cc-closing .lead {
    max-width: 28rem;
  }

  /* A última linha do roteiro, sozinha no arquivo original (uma linha em
     branco a separa do parágrafo acima) — por isso é um parágrafo à parte
     aqui também, e não uma frase colada no final do `.lead`. Itálico: é uma
     citação, não mais uma frase da prosa — e sem aspas, porque o roteiro
     também não usa nenhuma ali. */
  .cc-closing-quote {
    max-width: 26rem;
    margin-top: clamp(1.4rem, 3vh, 2rem);
    color: rgba(var(--ink-rgb), 0.68);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-style: italic;
    line-height: 1.5;
    transition: color var(--theme-fade);
  }

  .cc-closing nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    margin-top: clamp(2rem, 5vh, 3rem);
    font-size: 0.85rem;
  }

  .cc-closing nav a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(var(--ink-rgb), 0.25);
    text-underline-offset: 3px;
    transition: color var(--theme-fade), text-decoration-color 0.25s ease;
  }

  .cc-closing nav a:hover,
  .cc-closing nav a:focus-visible {
    text-decoration-color: currentColor;
  }

  /* ——— o contador ———
     A opacidade sai de variáveis: --nav-alpha, que a saída da abertura leva
     de 0 a 1, e --nav-out, que o fim da última criação leva de 1 a 0 (ver
     nav.ts). No palco nada aqui tem transição: tudo é função da rolagem, e
     transição correria atrás dela. Na versão simples as variáveis não
     existem e valem 1. Mora logo abaixo do botão de tema, do mesmo lado. */
  .cc-nav {
    position: fixed;
    top: calc(4.75rem + env(safe-area-inset-top));
    right: calc(1.5rem + var(--viewport-right));
    z-index: 6;
    opacity: var(--nav-alpha, 1);
    transition: opacity 0.3s ease;
  }

  :global(html[data-creations='stage']) .cc-nav {
    --nav-alpha: 0;
    opacity: calc(var(--nav-alpha, 1) * var(--nav-out, 1));
    transition: none;
  }

  .cc-nav.is-done {
    pointer-events: none;
  }

  .cc-nav-count {
    color: rgba(var(--ink-rgb), 0.55);
    font-size: 0.68rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    transition: color var(--theme-fade);
  }

  .cc-nav-sep {
    margin: 0 0.3em;
    opacity: 0.5;
  }

  /* o texto que só o leitor de tela lê (global.css não tem utilitário pra
     isso, e só esta página precisa) */
  .cc-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* O contador que rola: uma coluna com "—" e os números, numa janela de uma
     linha com as bordas esfumadas. --roll é o índice (fracionário) do número
     na janela: -1 é o traço, 0 é o "01". Em itálico serifado, como um fólio
     de livro — é o único número grande do cromo. */
  .cc-roll {
    --rh: 1.15em;
    display: inline-block;
    height: var(--rh);
    overflow: hidden;
    vertical-align: -0.2em;
    color: var(--ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    line-height: var(--rh);
    -webkit-mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
    transition: color var(--theme-fade);
  }

  .cc-roll-col {
    display: grid;
    transform: translate3d(0, calc((var(--roll, -1) + 1) * -1 * var(--rh)), 0);
  }

  .cc-roll-col > span {
    height: var(--rh);
  }

  /* na versão simples não há linha do tempo pra seguir: o número troca por
     transição */
  :global(html[data-creations='static']) .cc-roll-col {
    transition: transform 0.6s cubic-bezier(0.33, 0, 0.12, 1);
  }

  /* ——— o cromo sobre foto ———
     "‹ Voltar", o botão de tema e o indicador lateral são tinta escura no
     tema claro. Uma composição que cobre a tela de foto os apaga.

     O motor mede quanto da tela a foto encaixada está cobrindo e marca
     data-over-photo na raiz quando passa da metade (ver field.ts). Aqui o
     cromo só vira claro — o mesmo que ele já é no tema escuro, então é
     redefinir --ink e --ink-rgb e todas as regras existentes seguem.
     Vira sem piscar porque cada uma dessas regras já tem transition de cor. */
  :global(html[data-over-photo]) .back,
  :global(html[data-over-photo]) .theme,
  :global(html[data-over-photo]) .cc-nav {
    --ink: #fff;
    --ink-rgb: 255, 255, 255;
  }

  /* Branco não basta: a primeira foto full tem céu claro justamente no alto,
     onde o "‹ Voltar" e o botão de tema ficam. Então o que ganha fundo é o
     CONTROLE, não a imagem — uma pastilha escura atrás de cada um. O padding
     e o recuo negativo do .back moram na regra normal, com fundo
     transparente: assim a pastilha só ACENDE aqui, sem mexer no lugar do
     texto. */
  :global(html[data-over-photo]) .back,
  :global(html[data-over-photo]) .theme {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-color: rgba(255, 255, 255, 0.24);
  }

  /* o contador não ganha pastilha (ficaria maior que o número): uma sombra
     própria já dá a ele a borda escura que falta no claro */
  :global(html[data-over-photo]) .cc-nav {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.75));
  }

  .back {
    position: fixed;
    top: calc(1.5rem + env(safe-area-inset-top));
    left: 2rem;
    z-index: 6;
    /* o recuo cancela o padding lateral: a pastilha de over-photo cresce em
       volta do rótulo sem tirá-lo do lugar em que ele sempre esteve */
    padding: 0.35rem 0.75rem;
    margin-left: -0.75rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--theme-fade), background-color 0.25s ease,
      border-color var(--theme-fade);
  }

  .back::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.12rem;
    left: 1.05rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .back:hover::after,
  .back:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .theme {
    position: fixed;
    top: calc(1.3rem + env(safe-area-inset-top));
    right: 1.5rem;
    z-index: 6;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(var(--ink-rgb), 0.12);
    border-radius: 999px;
    background: rgba(90, 90, 90, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink);
    cursor: pointer;
    transition:
      background 0.2s,
      color var(--theme-fade),
      border-color var(--theme-fade);
  }

  .theme:hover {
    background: rgba(90, 90, 90, 0.42);
  }

  .theme svg {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: opacity var(--theme-fade), transform var(--theme-fade);
  }

  .theme .icon-sun {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-moon {
    opacity: 0;
    transform: rotate(90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-sun {
    opacity: 1;
    transform: none;
  }

  /* ——— celular: moldura em cima, texto embaixo ———
     O orçamento vertical aqui é o que define LAYOUT.MIN_STAGE_HEIGHT no
     config: moldura de 36dvh + título de duas linhas + três frases + link
     precisam caber numa tela presa. O padding de cima deixa o contador (fixo
     no alto, à direita) livre: a foto vai de borda a borda da coluna e
     passaria por baixo dele. */
  @media (max-width: 46rem) {
    .cc-hero {
      padding: 6.5rem 1.35rem 6rem;
    }

    .cc-hero h1 {
      font-size: clamp(3.4rem, 17vw, 6.5rem);
    }

    .cc-slide {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-content: center;
      row-gap: 1.3rem;
      padding: 6.25rem 1.35rem 2rem;
    }

    /* ——— as composições no celular: uma só ———
       No desktop cada composição é um jeito de dividir a tela com o texto ao
       lado. Numa coluna só essas variações viravam desordem: foto à esquerda,
       à direita, estreita, vazando pela borda, ou a tela inteira com um
       parágrafo longo por cima. Aqui TODAS viram a mesma coisa: foto
       centralizada em cima, na largura da coluna, e o texto embaixo, no
       papel. O ritmo de uma criação pra outra fica por conta do efeito de
       encaixe.

       --phone-frame é a altura máxima da foto, e é um knob só: o celular
       baixo (mais abaixo) muda a base. Foto deitada enche a largura e fica
       mais baixa que isso; foto em pé para nessa altura, mais estreita. */
    .cc-media {
      --phone-frame: 36dvh;
      --frame-h: var(--phone-frame);
      --frame-cap: 100%;
      justify-self: center;
    }

    /* Escopadas ao palco, como as do desktop — a versão simples já é uma
       pilha comum. Não redefinem --phone-frame, senão passariam por cima do
       celular baixo. */
    :global(html[data-creations='stage']) [data-layout] .cc-media {
      --frame-h: var(--phone-frame);
      --frame-cap: 100%;
      justify-self: center;
      align-self: auto;
      margin: 0;
    }

    /* a `full` é a que mais muda: deixa de cobrir a tela e de pôr o texto
       branco por cima — mesmo papel, mesma tinta e mesma moldura das outras */
    :global(html[data-creations='stage']) .cc-slide[data-layout='full'] {
      padding: 6.25rem 1.35rem 2rem;
      grid-template-columns: minmax(0, 1fr);
    }

    :global(html[data-creations='stage']) [data-layout='full'] .cc-media {
      position: relative;
      top: auto;
      left: auto;
      translate: none;
      width: min(var(--frame-cap), calc(var(--frame-h) * var(--ratio)));
      max-width: 100%;
    }

    :global(html[data-creations='stage']) [data-layout='full'] .cc-copy {
      --ink: inherit;
      --ink-rgb: inherit;
      position: static;
      padding: 0;
      max-width: none;
      color: inherit;
      text-shadow: none;
    }

    /* sem sombra no texto, a caixa da máscara não precisa crescer (ver o
       @supports da varredura) */
    :global(html[data-creations='stage']) [data-layout='full'] .cc-desc {
      padding: 0;
      margin: 0.8rem 0 0;
    }

    /* e sem texto branco por cima, o véu escuro na foto não tem motivo */
    .cc-card.is-featured[data-layout='full']::after {
      display: none;
    }

    .cc-kicker {
      margin-bottom: 0.7rem;
      font-size: 0.62rem;
    }

    .cc-title {
      font-size: clamp(1.9rem, 7.6vw, 2.5rem);
    }

    .cc-desc {
      margin-top: 0.8rem;
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .cc-evolution {
      margin-top: 0.7rem;
    }

    .cc-evolution-label {
      margin-bottom: 0.4rem;
      font-size: 0.58rem;
    }

    .cc-evolution-strip {
      gap: 0.4rem;
    }

    .cc-evolution-strip img {
      width: 2.6rem;
      height: 2.6rem;
    }

    .cc-evolution-strip figcaption {
      font-size: 0.5rem;
    }

    .cc-gallery-strip {
      margin-top: 0.7rem;
    }

    .cc-gallery-strip-label {
      margin-bottom: 0.4rem;
      font-size: 0.58rem;
    }

    .cc-gallery-strip-list {
      gap: 0.4rem;
    }

    .cc-gallery-strip-list img {
      width: 3.6rem;
      height: 3.6rem;
    }

    .cc-gallery-btn {
      width: 1.9rem;
      height: 1.9rem;
      font-size: 1rem;
    }

    .cc-gallery-label {
      font-size: 0.6rem;
    }

    .cc-link {
      margin-top: 1rem;
      font-size: 0.8rem;
    }

    .cc-closing h2 {
      font-size: clamp(2.4rem, 11vw, 4rem);
    }

    /* sem margem onde acender no celular: o canva vira textura, com metade
       das fotos e um teto de luz — o teto é aplicado no JS (FIELD.MOBILE) */
    .cc-card.is-wide-only {
      display: none;
    }

    /* o fólio sai no celular: numa coluna só não sobra um "lado do texto"
       com ar pra ele, e atrás da foto ele só embaralhava o alto da tela */
    .cc-folio {
      display: none;
    }

    .cc-nav {
      right: calc(0.9rem + var(--viewport-right));
    }

    .cc-roll {
      font-size: 1.1rem;
    }

    .back {
      left: 1.35rem;
    }

    .theme {
      right: 1rem;
      width: 40px;
      height: 40px;
    }
  }

  /* celular baixo (iPhone SE e afins): ainda cabe, com tudo um pouco menor */
  @media (max-width: 46rem) and (max-height: 700px) {
    .cc-slide,
    :global(html[data-creations='stage']) .cc-slide[data-layout='full'] {
      row-gap: 1rem;
      padding-top: 5.5rem;
      padding-bottom: 1.25rem;
    }

    /* o knob único: baixar a base encolhe TODAS as composições na proporção,
