---
// ⚠ NÃO RENOMEIE NEM MOVA ESTE ARQUIVO. O nome dele é a URL pública, e este
// endereço já foi divulgado fora do site: renomear publica outro caminho e
// quebra um link que já está com outras pessoas, sem erro nenhum por conta
// própria. A rota é travada em scripts/rotas-travadas.mjs, e o build morre se
// ela sumir; se isso aconteceu, desfaça o rename em vez de mexer na lista.
//
// /colecaocriacoes — a Coleção de Criações como uma sequência dirigida pelo
// scroll: abertura, uma criação por tela (presa enquanto a animação dela
// acontece) e um fechamento, com um indicador lateral de posição.
//
// Esta página não conhece nenhuma frase: tudo que aparece vem de
// src/data/creations.ts (com o guia src/data/creations.md ao lado). Os
// números da rolagem, dos efeitos e do canva de fotos ao fundo vêm de
// src/scripts/creations/config.ts, e o motor é src/scripts/creations/. Aqui
// só há markup, CSS e a checagem do build logo abaixo.
//
// Sem a cena 3D nem a transição de água do craft, de propósito: o vocabulário
// é o clássico do site (papel/tinta + botão de tema).
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import {
  CLOSING, CREATIONS, EFFECT_NAMES, FIELD_PHOTOS, KIND_LABEL, OPENING, UI,
} from '../data/creations';
import { EFFECTS, FIELD, FIELD_IMAGE, IMAGE, LAYOUT, STAGE } from '../scripts/creations/config';
import { layoutField } from '../scripts/creations/fieldLayout';

const pad = (n: number) => String(n).padStart(2, '0');

// ——— o que o build recusa ———
//
// O tipo já impede um efeito inexistente no editor, mas a regra das vizinhas
// e a dos ids repetidos só existem em tempo de build — e é aqui que a lista
// inteira está à mão. A mensagem diz QUAL criação e O QUE fazer, porque quem
// vai ler é quem acabou de reordenar a lista, não quem escreveu isto.
const known = new Set<string>(EFFECT_NAMES);
const ids = new Set<string>();
CREATIONS.forEach((creation, i) => {
  const here = `a criação ${pad(i + 1)} ("${creation.id}")`;
  if (!known.has(creation.effect)) {
    throw new Error(
      `Coleção de Criações: ${here} usa o efeito "${creation.effect}", que não existe. ` +
        `Os efeitos são: ${EFFECT_NAMES.join(', ')} (src/data/creations.ts).`,
    );
  }
  if (ids.has(creation.id)) {
    throw new Error(
      `Coleção de Criações: ${here} repete um id que já existe na lista. ` +
        `Cada criação precisa de um id próprio (src/data/creations.ts).`,
    );
  }
  ids.add(creation.id);
  const prev = CREATIONS[i - 1];
  if (prev && prev.effect === creation.effect) {
    throw new Error(
      `Coleção de Criações: as criações ${pad(i)} ("${prev.id}") e ${pad(i + 1)} ("${creation.id}") ` +
        `usam o mesmo efeito "${creation.effect}" em sequência. Troque o efeito de uma delas ` +
        `em src/data/creations.ts.`,
    );
  }
});

// As variantes de cada imagem saem do pipeline do Astro no build (ver IMAGE
// no config). A proporção viaja como variável CSS: é ela que dimensiona a
// moldura, então uma foto deitada e uma em pé cabem na mesma tela sem que
// nenhuma seja cortada pra caber numa caixa fixa.
const slides = await Promise.all(
  CREATIONS.map(async (creation, index) => {
    const img = await getImage({
      src: creation.image,
      widths: [...IMAGE.WIDTHS],
      format: IMAGE.FORMAT,
      quality: IMAGE.QUALITY,
    });
    // que forma esta criação toma no palco: o que a criação pediu, ou o
    // ciclo de STAGE.CYCLE percorrido pela ordem da lista (ver config.ts).
    // Vira um data-attribute e acaba aí — quem desenha é o CSS, e o motor
    // de encaixe só mede a moldura que sair disso.
    const layout = creation.layout ?? STAGE.CYCLE[index % STAGE.CYCLE.length];

    return {
      ...creation,
      index,
      number: pad(index + 1),
      anchor: `criacao-${pad(index + 1)}`,
      src: img.src,
      srcset: img.srcSet.attribute,
      ratio: creation.image.width / creation.image.height,
      from: creation.from ?? 'right',
      layout,
      // a única coisa que a composição decide fora do CSS: a `full` leva a
      // foto a 100vw e as outras a cabem na moldura (ver IMAGE.SIZES /
      // SIZES_FULL). Precisa ser aqui porque quem escolhe a variante é o
      // navegador, lendo o atributo, antes de qualquer script rodar.
      sizes: layout === 'full' ? IMAGE.SIZES_FULL : IMAGE.SIZES,
    };
  }),
);

const total = pad(CREATIONS.length);
const pieceIndexes = Array.from({ length: EFFECTS.PIECES.COUNT }, (_, k) => k);

// O canva de fotos ao fundo: posições e tamanhos das fotos comuns vêm prontos
// do build (ver scripts/creations/fieldLayout.ts). As fotos das criações
// também entram no canva — a posição delas é função da moldura, medida na
// tela, então aqui só levam os dados da criação. Uma variante por foto da
// lista, e não por lugar no canva: a lista repete.
const fieldSources = await Promise.all(
  FIELD_PHOTOS.map((photo) => getImage({ src: photo, ...FIELD_IMAGE })),
);
const fieldCards = layoutField(FIELD_PHOTOS.length, CREATIONS.length).map((card) => ({
  ...card,
  src: fieldSources[card.photo].src,
  ratio: FIELD_PHOTOS[card.photo].width / FIELD_PHOTOS[card.photo].height,
}));
---

<Layout lang="pt">
  <Fragment slot="head">
    <title>Coleção de Criações · Carlos Leonardo</title>
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="preload"
      href="/fonts/playfair-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Palco ou versão simples? Decidido AQUI, antes do primeiro paint, e não
        no bundle: os dois layouts têm alturas de página muito diferentes (um
        palco de uma tela contra oito criações empilhadas), e trocar de um pro
        outro depois do primeiro quadro é a página inteira pulando.

        A resposta vem de duas perguntas. Baixa animação: a escolha feita no
        portão do site (sessionStorage, ver scripts/motion.ts) manda; o
        prefers-reduced-motion do sistema só vale pra quem entrou por link
        direto e nunca passou pelo portão. E "cabe?": abaixo de uma altura
        mínima a tela presa não tem onde pôr moldura + texto (ver LAYOUT no
        config). Sem JS nada disto roda, a marca não existe e o CSS entrega a
        versão simples — que é o layout padrão de propósito. */}
    <script is:inline define:vars={{ minStageHeight: LAYOUT.MIN_STAGE_HEIGHT }}>
      try {
        var mode = sessionStorage.getItem('motion-mode');
        if (mode === 'full' || mode === 'reduced')
          document.documentElement.dataset.motion = mode;
        var reduced = mode === 'reduced' ||
          (!mode && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        var fits = window.innerHeight >= minStageHeight;
        document.documentElement.dataset.creations = !reduced && fits ? 'stage' : 'static';
      } catch (e) {}
    </script>
  </Fragment>

  <div class="paper" aria-hidden="true"></div>

  {/* O `noreferrer` é o que faz a home rodar a abertura inteira ao voltar daqui.
      Ela decide entre a descida da câmera e o anel instantâneo pelo referrer
      (main.ts → isInternalArrival), e pular a descida só faz sentido pras
      páginas do anel: quem volta de lá já a assistiu e ainda renasce no
      segmento de onde saiu. Esta página não está no anel e não é linkada em
      lugar nenhum — chega-se nela pela URL — então sair daqui é uma chegada de
      verdade, não um passo atrás. Sem isto o anel aparecia estático depois da
      cortina de carregamento. */}
  <a class="back" href="/" rel="noreferrer">‹ Voltar</a>

  <button
    class="theme"
    data-theme-toggle
    aria-pressed="false"
    aria-label="Alternar tema claro/escuro"
    title="Tema claro / escuro"
  >
    <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>

  <main class="cc-page">
    {/* O palco: no modo 'stage' é uma tela de altura, presa pelo ScrollTrigger,
        com a abertura e as criações empilhadas em camadas dentro dele; na
        versão simples é só um contêiner, e as mesmas peças viram blocos de
        uma tela cada. Mesmo HTML, dois CSS. */}
    <div class="cc-stage" data-cc-stage>
      {/* O canva de fotos: atrás de tudo, decorativo (sem alt, fora da árvore
          de acessibilidade) e só no palco. Primeiro as fotos comuns (a
          posição vem do build); depois a foto de cada criação, que o motor
          leva do canva até a moldura — no `pieces`, em N tiras, cada uma um
          elemento próprio recortado à sua fatia. Metade das comuns leva uma
          classe que o CSS esconde no celular. */}
      <div
        class="cc-field"
        data-cc-field
        aria-hidden="true"
        style={`--lit-cap-mobile:${FIELD.MOBILE.LIT_CAP}`}
      >
        {fieldCards.map((c) => (
          <figure
            class:list={['cc-card', { 'is-wide-only': c.wideOnly }]}
            data-cc-card
            data-x={c.x.toFixed(2)}
            data-yc={c.yc.toFixed(3)}
            data-w={c.w}
            data-ratio={c.ratio.toFixed(4)}
            data-lit={c.lit ? '1' : '0'}
            data-hero-ok={c.heroOk ? '1' : '0'}
            data-stage-ok={c.stageOk ? '1' : '0'}
            data-rank={c.rank}
            style={`--ratio:${c.ratio.toFixed(4)}`}
          >
            <img src={c.src} alt="" loading="lazy" decoding="async" draggable="false" />
          </figure>
        ))}
        {slides.map((s) =>
          (s.effect === 'pieces' ? pieceIndexes : [0]).map((k) => (
            <figure
              class:list={['cc-card', 'is-featured', { 'is-strip': s.effect === 'pieces' }]}
              data-cc-featured={s.index}
              data-strip={k}
              data-strips={s.effect === 'pieces' ? EFFECTS.PIECES.COUNT : 1}
              data-effect={s.effect}
              data-from={s.from}
              data-ratio={s.ratio.toFixed(4)}
              style={`--ratio:${s.ratio.toFixed(4)};--k:${k};--n:${EFFECTS.PIECES.COUNT}`}
            >
              <img
                src={s.src}
                srcset={s.srcset}
                sizes={s.sizes}
                alt=""
                loading={s.index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                draggable="false"
              />
            </figure>
          )),
        )}
      </div>

      <header class="cc-hero" data-cc-hero>
        <p class="eyebrow" data-cc-hero-kicker>{OPENING.kicker}</p>
        {/* O título parte em duas com um VÃO no meio: é ali que a fita da
            abertura corre (o canva reunido numa curva em S, ver RIBBON no
            config). O vão é um span vazio e sem conteúdo de propósito — ele
            existe pra ser MEDIDO pelo field.ts, do mesmo jeito que a moldura
            de cada criação, e assim a curva cai entre as linhas em qualquer
            tipografia e qualquer tela, sem que o motor saiba de fonte.

            Continua um <h1> só: pro leitor de tela o texto segue sendo
            "Coleção de criações.", em ordem, e o vão não diz nada. */}
        <h1 data-cc-hero-title>
          <span class="cc-title-line">{OPENING.title.line1}</span>{' '}
          <span class="cc-ribbon-slot" data-cc-ribbon aria-hidden="true"></span>
          <span class="cc-title-line"><em>{OPENING.title.line2}</em></span>
        </h1>
        <p class="lead" data-cc-hero-lead>{OPENING.lead}</p>
        <p class="cc-hint" data-cc-hero-hint aria-hidden="true"><span>{OPENING.hint}</span></p>
      </header>

      {slides.map((s) => (
        <section
          class="cc-slide"
          id={s.anchor}
          data-cc-slide
          data-effect={s.effect}
          data-from={s.from}
          data-layout={s.layout}
          aria-labelledby={`${s.anchor}-titulo`}
          style={`--ratio:${s.ratio.toFixed(4)}`}
        >
          {/* A moldura. No palco é só o LUGAR: a foto que se vê é a do canva,
              que vem se encaixar aqui (o motor mede esta caixa). A <img>
              existe pra versão simples — lá não há canva — e pelo alt, que
              o leitor de tela lê nos dois casos; no palco ela fica
              invisível por CSS. Mesma URL da foto do canva: um download. */}
          <div class="cc-media" data-cc-media>
            <img
              src={s.src}
              srcset={s.srcset}
              sizes={s.sizes}
              alt={s.alt}
              loading={s.index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
          </div>

          <div class="cc-copy">
            <p class="cc-kicker" data-cc-line>
              {UI.item} {s.number} · {KIND_LABEL[s.kind]}{s.date && ` · ${s.date}`}
            </p>
            <h2 class="cc-title" id={`${s.anchor}-titulo`} data-cc-line>{s.title}</h2>
            <p class="cc-desc" data-cc-line>{s.description}</p>
            {s.link && (
              <a class="cc-link" data-cc-line href={s.link.href} target="_blank" rel="noopener">
                {s.link.label} <span aria-hidden="true">{UI.linkMark}</span>
              </a>
            )}
          </div>

        </section>
      ))}
    </div>

    <footer class="cc-closing" data-cc-closing>
      <div class="cc-closing-inner" data-cc-closing-inner>
        <p class="eyebrow">{CLOSING.kicker}</p>
        <h2>{CLOSING.title}</h2>
        <p class="lead">{CLOSING.text}</p>
        <nav aria-label="Voltar pro resto do site">
          {CLOSING.links.map((link) => (
            <a href={link.href} rel={link.href === '/' ? 'noreferrer' : undefined}>{link.label}</a>
          ))}
        </nav>
      </div>
    </footer>
  </main>

  {/* O indicador: um traço por criação e o contador. Os traços são âncoras de
      verdade — na versão simples o navegador as resolve sozinho, e no palco o
      script troca o destino pela posição de scroll da criação. */}
  <nav class="cc-nav" data-cc-nav aria-label={UI.nav}>
    <p class="cc-nav-count" aria-live="polite">
      <span data-cc-nav-current>—</span><span class="cc-nav-sep">/</span><span>{total}</span>
    </p>
    <ol>
      {slides.map((s) => (
        <li>
          <a
            href={`#${s.anchor}`}
            data-cc-nav-item
            aria-label={`${UI.jump} ${s.number} de ${total}: ${s.title}`}
          >
            <span class="cc-nav-num" aria-hidden="true">{s.number}</span>
            <span class="cc-nav-mark" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</Layout>

<script>
  import { initTheme } from '../scripts/theme';
  import { initCreations } from '../scripts/creations/main';

  initTheme();
  initCreations();
</script>

<style>
  .paper {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    transition: background-color var(--theme-fade);
  }

  /* A página rola — e o global.css dá a html e body o `height: 100%` +
     `overflow: hidden` de que a HOME precisa (canvas fixo, quem rola lá é o
     Lenis). Aqui os dois voltam ao normal, como na /work e na /craft. Sem
     isto o sintoma engana: o overflow do body propaga pro viewport, a página
     aparece inteira e nenhum gesto chega nela. */
  :global(html:has(.cc-page)),
  :global(html:has(.cc-page) body) {
    height: auto;
    overflow: visible;
  }

  .cc-page {
    position: relative;
    z-index: 1;
    color: var(--ink);
    transition: color var(--theme-fade);
  }

  /* ——— o palco ———
     O CSS padrão é a VERSÃO SIMPLES (blocos empilhados, uma tela cada). O
     palco só existe sob html[data-creations='stage'], que o script inline do
     <head> escreve quando há JS, animação e altura pra isso. Errar pro lado
     do empilhado é errar pro lado que sempre funciona. */
  .cc-stage {
    position: relative;
  }

  :global(html[data-creations='stage']) .cc-stage {
    height: var(--viewport-h);
    overflow: hidden;
  }

  /* ——— o canva de fotos ao fundo ———
     Só existe no palco: empilhada, a página é uma lista e um fundo que rola
     por trás dela não faria sentido. Toda foto é posicionada pelo motor
     (transform, a partir do canto 0,0), então o CSS só dá a forma.

     A opacidade das fotos comuns é o PRODUTO de duas variáveis que o motor
     escreve: --level, o nível dela no trecho atual, e --breath, a respiração
     do canva inteiro. --lit-cap é o teto do celular. As fotos das criações
     recebem a opacidade direto, porque encaixadas elas SÃO a criação. */
  .cc-field {
    --breath: 1;
    position: absolute;
    inset: 0;
    z-index: 0;
    display: none;
    overflow: hidden;
    pointer-events: none;
  }

  :global(html[data-creations='stage']) .cc-field {
    display: block;
  }

  .cc-card {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    aspect-ratio: var(--ratio);
    /* O max(--ribbon-a, ...) é a fita da abertura passando por cima das
       regras do canva. Lá ela não é fundo — é a página inteira — então acende
       por inteiro, inclusive acima do teto do celular (--lit-cap), que existe
       pra fundo não competir com texto e ali não há texto pra competir. Fora
       da abertura --ribbon-a é 0 e a conta é a de sempre. */
    opacity: calc(
      max(var(--ribbon-a, 0), min(var(--level, 0), var(--lit-cap, 1))) * var(--breath)
    );
    transform-origin: center center;
    backface-visibility: hidden;
  }

  /* antes da primeira medida não há largura nem posição; e fora da tela
     (com folga) o motor desliga a foto em vez de movê-la */
  .cc-field:not(.is-ready) .cc-card,
  .cc-card.is-off {
    visibility: hidden;
  }

  .cc-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* a foto de uma criação passa por cima das comuns — e por baixo do texto,
     que está na criação (z-index 1, abaixo) */
  .cc-card.is-featured {
    z-index: 2;
  }

  /* as tiras do `pieces`: N cópias da foto no mesmo lugar, cada uma
     recortada à sua fatia; o motor move cada tira por conta própria */
  .cc-card.is-strip {
    clip-path: inset(
      0 calc((var(--n) - 1 - var(--k)) / var(--n) * 100%) 0 calc(var(--k) / var(--n) * 100%)
    );
  }

  /* a abertura e as criações ficam por cima do canva */
  :global(html[data-creations='stage']) .cc-hero,
  :global(html[data-creations='stage']) .cc-slide {
    z-index: 1;
  }

  /* ——— a abertura ——— */
  /* Composição centrada e simétrica, e tem que ser: a fita corre ENTRE as
     duas linhas do título, e uma curva centrada sob um título alinhado à
     esquerda não é composição, é sobreposição. */
  .cc-hero {
    position: relative;
    min-height: var(--viewport-h);
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    padding: clamp(3rem, 7vh, 5rem) clamp(1.5rem, 6vw, 6rem) clamp(2.5rem, 6vh, 4.5rem);
  }

  :global(html[data-creations='stage']) .cc-hero {
    position: absolute;
    inset: 0;
    min-height: 0;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  /* A tipografia encolheu: com o vão da fita no meio, as duas linhas mais o
     vão mais o rótulo e o parágrafo têm que caber numa tela SEM rolar — a
     abertura é a única parte da página que não tem pra onde crescer. */
  .cc-hero h1 {
    display: grid;
    justify-items: center;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.6rem, min(8vw, 9.5vh), 5.6rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .cc-hero h1 em {
    font-weight: 400;
  }

  /* O VÃO onde a fita corre. Não tem conteúdo e não desenha nada: é uma caixa
     pro field.ts MEDIR (getBoundingClientRect), do mesmo jeito que ele mede a
     moldura de cada criação. Por isso a curva cai entre as linhas em qualquer
     tipografia e qualquer tela, sem que o motor saiba o que é uma fonte.

     Na versão simples não há canva nem fita, e ele colapsa — senão seria um
     buraco no meio do título sem motivo nenhum. */
  .cc-ribbon-slot {
    display: block;
    width: 100%;
    height: 0;
  }

  :global(html[data-creations='stage']) .cc-ribbon-slot {
    height: min(44dvh, 26rem);
    transition: height 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* O vão se fecha quando a fita estoura: as fotos saem dali e o título se
     junta atrás delas, no mesmo gesto. Depois disso a abertura é a que sempre
     foi — rótulo, título em duas linhas coladas, parágrafo, dica — e a
     rolagem começa numa página montada.

     Fechar por altura, e não por transform, porque o que tem que acontecer é
     o título REFLUIR: as duas linhas se aproximando de verdade. Um transform
     deixaria o buraco no lugar e só disfarçaria. */
  :global(html.is-intro-done) .cc-ribbon-slot {
    height: 0;
  }

  .lead {
    max-width: 31rem;
    margin-top: clamp(1.4rem, 3.5vh, 2.2rem);
    color: rgba(var(--ink-rgb), 0.68);
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.62;
    transition: color var(--theme-fade);
  }

  /* a dica de rolar: um rótulo e um fio que pulsa. Só no palco — na versão
     simples a página é uma lista e ninguém precisa ser convidado a rolar */
  .cc-hint {
    position: absolute;
    left: 50%;
    bottom: calc(1.6rem + env(safe-area-inset-bottom));
    display: none;
    justify-items: center;
    gap: 0.7rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transform: translateX(-50%);
    transition: color var(--theme-fade);
  }

  :global(html[data-creations='stage']) .cc-hint {
    display: grid;
  }

  .cc-hint::after {
    content: '';
    width: 1px;
    height: 2.4rem;
    background: currentColor;
    animation: cc-hint-pulse 1.8s ease-in-out infinite alternate;
  }

  @keyframes cc-hint-pulse {
    from { opacity: 0.25; transform: scaleY(0.6); transform-origin: top; }
    to { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  /* ——— as criações ——— */
  .cc-slide {
    position: relative;
    min-height: var(--viewport-h);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(4.5rem, 9vh, 6rem) clamp(1.5rem, 6vw, 6rem);
  }

  /* No palco as criações são camadas: mesma caixa, uma sobre a outra, e o
     GSAP decide qual está visível. O `visibility: hidden` aqui é o estado
     antes de o bundle rodar — sem ele, o quadro entre o script inline e o
     módulo mostraria as oito empilhadas na mesma tela. O GSAP escreve
     visibility inline (autoAlpha) e o inline ganha desta regra. */
  :global(html[data-creations='stage']) .cc-slide {
    position: absolute;
    inset: 0;
    min-height: 0;
    visibility: hidden;
  }

  /* A moldura tem a PROPORÇÃO da imagem (--ratio, escrita no build) e é
     limitada por altura (--frame-h) e pela coluna. A largura sai da conta
     explícita em vez de deixar o navegador transferir o max-height pela
     aspect-ratio: dá o mesmo resultado, sem depender de como cada motor
     resolve essa transferência. */
  .cc-media {
    --frame-h: min(72dvh, 46rem);
    --frame-cap: 100%;
    position: relative;
    justify-self: end;
    width: min(var(--frame-cap), calc(var(--frame-h) * var(--ratio)));
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: rgba(var(--ink-rgb), 0.06);
    transition: background-color var(--theme-fade);
  }

  .cc-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* ═══ AS COMPOSIÇÕES ═══════════════════════════════════════════════════
     A forma que cada criação toma no palco. Os nomes e o que cada um quer
     dizer estão em data/creations.ts → LAYOUT_NAMES; a ordem em que aparecem
     está em scripts/creations/config.ts → STAGE.CYCLE. Aqui é a geometria.

     Tudo isto é layout puro, e mesmo assim é o que mais muda a animação: o
     motor de encaixe MEDE a moldura (getBoundingClientRect) e leva a foto até
     ela, do tamanho que ela for. Uma moldura que cobre a tela é uma foto que
     cresce até cobrir a tela — e o mesmo `grow` que era um crescimentozinho
     no centro vira um zoom de tela cheia, sem uma linha de JS.

     Duas regras que valem pra todas:
       • a caixa tem SEMPRE a proporção da foto (--ratio), e o tamanho sai de
         uma altura-alvo (--frame-h) com um teto de largura (--frame-cap).
         Assim uma foto deitada não estoura a composição pensada pra uma em
         pé: o teto entra e a altura cede.
       • só no palco. Na versão simples (tela baixa, baixa animação) a página
         é uma pilha comum, e composição ali seria enfeite sobre um fallback.

     A moldura pode passar da tela de propósito (tower, edge, full). Quem
     corta é o .cc-field, que tem overflow: hidden no tamanho do viewport — e
     o getBoundingClientRect ignora corte de ancestral, então o motor continua
     enxergando a caixa inteira e mandando a foto pro lugar certo. */
  :global(html[data-creations='stage']) .cc-slide {
    /* uma moldura que sangra não pode virar barra de rolagem horizontal */
    overflow: hidden;
  }

  @media (min-width: 46.01rem) {
    /* ——— flip: o duet espelhado ———
       A proporção das colunas troca junto, senão a moldura da direita nasce
       menor que a da esquerda só por estar do outro lado. */
    :global(html[data-creations='stage']) .cc-slide[data-layout='flip'] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
    :global(html[data-creations='stage']) [data-layout='flip'] .cc-media {
      grid-column: 2;
      justify-self: start;
    }
    :global(html[data-creations='stage']) [data-layout='flip'] .cc-copy {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
    }

    /* ——— tower: mais alta que a tela, estreita, encostada na borda ———
       116dvh é o ponto em que ela sangra em cima E embaixo o bastante pra se
       ler como "não cabe", sem que o assunto da foto (que costuma estar no
       meio) saia junto. O teto de 52vw é o que segura uma foto deitada: nela
       a altura cede e o resultado é uma faixa larga, que é a forma que uma
       deitada tem quando quer ser grande. */
    /* A folga do indicador. Ele é fixo à direita e ocupa uns 65px de largura
       contra os 86 de padding do slide — só que ele não fica DENTRO desse
       padding: medido, ele começa 3px antes da borda do conteúdo. Nunca deu
       problema porque nada encostava ali. Estas duas encostam, então param
       antes. As outras nem chegam perto e não precisam da regra. */
    :global(html[data-creations='stage']) [data-layout='tower'] .cc-media,
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-media {
      margin-right: 1.6rem;
    }

    /* Ela sangra em cima e embaixo, e SÓ. Sangrar pela direita também era o
       primeiro desenho, e estava errado: o indicador lateral é fixo no meio
       da altura, exatamente onde esta moldura passa, e uma foto escura por
       baixo dele o apaga. Conteúdo não passa por cima de navegação
       permanente — e o gesto não perde nada, porque o que faz a tower é a
       altura que não cabe, não a borda lateral. */
    :global(html[data-creations='stage']) [data-layout='tower'] .cc-media {
      --frame-h: 116dvh;
      --frame-cap: 52vw;
      grid-column: 2;
      justify-self: end;
    }
    :global(html[data-creations='stage']) [data-layout='tower'] .cc-copy {
      grid-column: 1;
      grid-row: 1;
      max-width: 26rem;
    }

    /* ——— quiet: pequena num canto, texto no oposto ———
       A única em que a foto NÃO é o assunto principal da tela: ela vira um
       selo no alto e quem manda é o título. Depois de uma full, é o silêncio
       que faz a próxima cheia valer. */
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-media {
      --frame-h: 38dvh;
      --frame-cap: 24vw;
      grid-column: 2;
      justify-self: end;
      align-self: start;
    }
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-copy {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
      max-width: 34rem;
    }
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-title {
      font-size: clamp(3rem, 6vw, 6rem);
    }

    /* ——— edge: grande, jogada pra fora da borda esquerda ———
       Uns 16vw ficam de fora. É o gesto mais arriscado da página e depende de
       uma coisa: o texto do outro lado tem que estar inteiro na tela, senão
       vira só uma foto mal posicionada. */
    :global(html[data-creations='stage']) .cc-slide[data-layout='edge'] {
      /* a primeira coluna encolhe porque boa parte dela está fora da tela:
         com as colunas normais o texto começava a 770px e sobrava um vazio
         de 470 entre ele e a foto — ar demais vira desleixo, não composição */
      grid-template-columns: minmax(0, 0.62fr) minmax(0, 1fr);
    }
    :global(html[data-creations='stage']) [data-layout='edge'] .cc-media {
      --frame-h: 88dvh;
      --frame-cap: 62vw;
      grid-column: 1;
      justify-self: start;
      margin-left: -16vw;
    }
  }

  /* ——— full: a foto ocupa a página inteira ———
     Vale em toda largura, inclusive no celular: é a composição que menos
     depende de haver duas colunas, e a que mais rende em tela pequena.

     A moldura é a MENOR caixa com a proporção da foto que ainda cobre o
     viewport: max(largura da tela, altura da tela x proporção). Com o
     aspect-ratio junto, o que sobra em uma direção sangra pra fora e o
     .cc-field corta. É o que faz qualquer foto — em pé, deitada, quadrada —
     cobrir a tela inteira sem deformar e sem faixa preta.

     O padding do slide vai a zero pra caixa nascer do canto do viewport, e
     volta no texto: aqui ele flutua sobre a foto, não divide espaço com ela. */
  :global(html[data-creations='stage']) .cc-slide[data-layout='full'] {
    padding: 0;
    grid-template-columns: minmax(0, 1fr);
  }

  :global(html[data-creations='stage']) [data-layout='full'] .cc-media {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: max(100%, calc(var(--viewport-h) * var(--ratio)));
    max-width: none;
  }

  /* O véu. Escurece só o pé da tela, onde o texto está — o alto da foto fica
     como é. A opacidade segue o --dock que o field.ts publica (o quanto a
     foto já chegou), e não a linha do tempo do texto: sem isso a página
     escureceria inteira no primeiro quadro da entrada, com a foto ainda
     miniatura do outro lado da tela. O 1.4 adianta o véu em relação à foto,
     porque o texto branco começa a aparecer antes de ela ter chegado. */
  :global(html[data-creations='stage']) [data-layout='full']::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: clamp(0, calc(var(--dock, 0) * 1.4), 1);
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.82) 0%,
      rgba(0, 0, 0, 0.55) 26%,
      rgba(0, 0, 0, 0.12) 55%,
      rgba(0, 0, 0, 0) 78%
    );
  }

  /* O texto por cima do véu. Trocar --ink e --ink-rgb aqui vira todas as
     linhas de uma vez (rótulo, título, descrição, link já se descrevem em
     função deles) — e continua branco nos dois temas, porque quem manda no
     contraste agora é a foto, não o tema da página. */
  :global(html[data-creations='stage']) [data-layout='full'] .cc-copy {
    --ink: #fff;
    --ink-rgb: 255, 255, 255;
    position: absolute;
    z-index: 1;
    left: 0;
    bottom: 0;
    padding: clamp(1.6rem, 5vw, 5rem);
    padding-right: clamp(3.2rem, 8vw, 7rem);
    max-width: min(42rem, 100%);
    color: #fff;
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.4);
  }

  /* no palco a moldura é só o lugar medido pelo motor: transparente, com a
     própria foto invisível — quem aparece ali é a foto do canva se
     encaixando. A <img> continua no documento pelo alt. */
  :global(html[data-creations='stage']) .cc-media {
    background: none;
  }

  :global(html[data-creations='stage']) .cc-media img {
    visibility: hidden;
  }

  .cc-copy {
    max-width: 30rem;
  }

  .cc-kicker {
    margin-bottom: 1.1rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  .cc-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  .cc-desc {
    margin-top: clamp(1.1rem, 2.4vh, 1.6rem);
    color: rgba(var(--ink-rgb), 0.68);
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.62;
    transition: color var(--theme-fade);
  }

  .cc-link {
    display: inline-block;
    margin-top: 1.6rem;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(var(--ink-rgb), 0.25);
    text-underline-offset: 3px;
    transition: color var(--theme-fade), text-decoration-color 0.25s ease;
  }

  .cc-link:hover,
  .cc-link:focus-visible {
    text-decoration-color: currentColor;
  }

  /* ——— o fechamento ——— */
  .cc-closing {
    min-height: var(--viewport-h);
    display: grid;
    place-items: center;
    padding: clamp(5rem, 12vh, 8rem) clamp(1.5rem, 6vw, 6rem);
    text-align: center;
  }

  .cc-closing-inner {
    display: grid;
    justify-items: center;
  }

  .cc-closing h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.6rem, 6vw, 5.4rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .cc-closing .lead {
    max-width: 28rem;
  }

  .cc-closing nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    margin-top: clamp(2rem, 5vh, 3rem);
    font-size: 0.85rem;
  }

  .cc-closing nav a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(var(--ink-rgb), 0.25);
    text-underline-offset: 3px;
    transition: color var(--theme-fade), text-decoration-color 0.25s ease;
  }

  .cc-closing nav a:hover,
  .cc-closing nav a:focus-visible {
    text-decoration-color: currentColor;
  }

  /* ——— o indicador ———
     A opacidade sai de uma variável: no palco o GSAP a anima de 0 a 1 junto
     com a saída da abertura, e a classe `is-done` (fim da sequência) apaga
     por cima sem disputar a propriedade. Na versão simples a variável não
     existe e vale 1. */
  .cc-nav {
    position: fixed;
    top: 50%;
    right: calc(1.5rem + var(--viewport-right));
    z-index: 6;
    display: grid;
    justify-items: end;
    gap: 1rem;
    opacity: var(--nav-alpha, 1);
    transition: opacity 0.3s ease;
  }

  :global(html[data-creations='stage']) .cc-nav {
    --nav-alpha: 0;
  }

  .cc-nav.is-done {
    opacity: 0;
    pointer-events: none;
  }

  .cc-nav-count {
    color: rgba(var(--ink-rgb), 0.55);
    font-size: 0.68rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    transition: color var(--theme-fade);
  }

  .cc-nav-sep {
    margin: 0 0.3em;
    opacity: 0.5;
  }

  .cc-nav ol {
    display: grid;
    gap: 0.55rem;
    justify-items: end;
    list-style: none;
  }

  .cc-nav a {
    --p: 0;
    display: grid;
    grid-auto-flow: column;
    align-items: center;
    gap: 0.6rem;
    padding: 0.2rem 0;
    color: rgba(var(--ink-rgb), 0.5);
    text-decoration: none;
    transition: color var(--theme-fade);
  }

  .cc-nav-num {
    font-size: 0.62rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .cc-nav a:hover .cc-nav-num,
  .cc-nav a:focus-visible .cc-nav-num,
  .cc-nav a[aria-current] .cc-nav-num {
    opacity: 1;
  }

  /* o traço: um trilho fino, e por cima o preenchimento (--p) que o script
     escreve a cada quadro — o traço ativo é também a barra de progresso da
     criação */
  .cc-nav-mark {
    position: relative;
    width: 1.4rem;
    height: 2px;
    overflow: hidden;
    background: rgba(var(--ink-rgb), 0.2);
    transition: width 0.3s ease, background-color var(--theme-fade);
  }

  .cc-nav-mark::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleX(var(--p));
    transform-origin: left center;
    transition: background-color var(--theme-fade);
  }

  .cc-nav a[aria-current] .cc-nav-mark {
    width: 2.6rem;
  }

  /* ——— o cromo fixo (o mesmo das outras páginas secundárias) ——— */
  /* ——— o cromo sobre foto ———
     "‹ Voltar", o botão de tema e o indicador lateral são tinta escura no
     tema claro. Uma composição que cobre a tela de foto os apaga: a página
     fica linda e sem navegação visível.

     O motor mede quanto da tela a foto encaixada está cobrindo e marca
     data-over-photo na raiz quando passa da metade (ver field.ts). Aqui o
     cromo só vira claro — o mesmo que ele já é no tema escuro, então é
     redefinir --ink e --ink-rgb e todas as regras existentes seguem, sem
     nenhuma precisar saber deste caso.

     Vira sem piscar porque cada uma dessas regras já tem transition de cor
     (era pra troca de tema); a mudança de variável entra por ela. */
  :global(html[data-over-photo]) .back,
  :global(html[data-over-photo]) .theme,
  :global(html[data-over-photo]) .cc-nav {
    --ink: #fff;
    --ink-rgb: 255, 255, 255;
  }

  /* Branco não basta, e foi preciso ver pra saber: a primeira foto full tem
     céu claro justamente no alto, onde o "‹ Voltar" e o botão de tema ficam,
     e o texto branco sumiu no branco. Escurecer o topo da foto inteira
     resolveria e custaria a foto; então o que ganha fundo é o CONTROLE, não a
     imagem — uma pastilha escura atrás de cada um, do tamanho dele.

     A pastilha é opaca o bastante pra dar contraste de verdade sobre céu
     branco (0.5 sobre branco dá cinza ~115, contra branco é ~4:1), e o
     desfoque atrás dela a costura na foto em vez de recortá-la.

     O padding e o recuo negativo do .back moram na regra normal, com fundo
     transparente: assim a pastilha só ACENDE aqui, sem mexer no lugar do
     texto — trocar padding junto empurraria o rótulo no meio da transição. */
  :global(html[data-over-photo]) .back,
  :global(html[data-over-photo]) .theme {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-color: rgba(255, 255, 255, 0.24);
  }

  /* o indicador são traços de 2px: pastilha ficaria maior que o conteúdo, e
     uma sombra própria já dá a eles a borda escura que falta no claro */
  :global(html[data-over-photo]) .cc-nav {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.75));
  }

  .back {
    position: fixed;
    top: calc(1.5rem + env(safe-area-inset-top));
    left: 2rem;
    z-index: 6;
    /* o recuo cancela o padding lateral: a pastilha de over-photo cresce em
       volta do rótulo sem tirá-lo do lugar em que ele sempre esteve */
    padding: 0.35rem 0.75rem;
    margin-left: -0.75rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--theme-fade), background-color 0.25s ease,
      border-color var(--theme-fade);
  }

  .back::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.12rem;
    left: 1.05rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .back:hover::after,
  .back:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .theme {
    position: fixed;
    top: calc(1.3rem + env(safe-area-inset-top));
    right: 1.5rem;
    z-index: 6;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(var(--ink-rgb), 0.12);
    border-radius: 999px;
    background: rgba(90, 90, 90, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink);
    cursor: pointer;
    transition:
      background 0.2s,
      color var(--theme-fade),
      border-color var(--theme-fade);
  }

  .theme:hover {
    background: rgba(90, 90, 90, 0.42);
  }

  .theme svg {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: opacity var(--theme-fade), transform var(--theme-fade);
  }

  .theme .icon-sun {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-moon {
    opacity: 0;
    transform: rotate(90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-sun {
    opacity: 1;
    transform: none;
  }

  /* ——— celular: moldura em cima, texto embaixo ———
     O orçamento vertical aqui é o que define LAYOUT.MIN_STAGE_HEIGHT no
     config: moldura de 36dvh + título de duas linhas + três frases + link
     precisam caber numa tela presa. O padding direito maior é pro texto não
     passar por baixo do indicador. */
  @media (max-width: 46rem) {
    .cc-hero {
      padding: 6.5rem 1.35rem 6rem;
    }

    .cc-hero h1 {
      font-size: clamp(3.4rem, 17vw, 6.5rem);
    }

    .cc-slide {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-content: center;
      row-gap: 1.3rem;
      padding: 4.5rem 2.9rem 2.5rem 1.35rem;
    }

    /* ——— as composições no celular ———
       Uma coluna só não tem "outro lado", mas as composições não eram sobre
       lado: eram sobre QUANTO da tela a foto toma e de onde ela sai. Isso o
       empilhado tem, e a régua aqui é vertical — foto e texto dividem a
       altura, então cada composição é uma fatia diferente dela.

       --phone-frame é a fatia normal, e cada composição é um fator dela. Um
       knob só: o celular baixo (iPhone SE, mais abaixo) muda a base e todas
       as composições encolhem junto, na proporção. O teto de cada uma foi
       escolhido pelo pior caso — foto + rótulo + título de 2 linhas +
       descrição de 3 frases + link cabendo SEM rolar, porque a tela está
       presa. */
    .cc-media {
      --phone-frame: 36dvh;
      --frame-h: var(--phone-frame);
      justify-self: start;
    }

    /* flip: encosta na direita. A moldura ocupa pouco mais da metade da
       largura, então a travessia é de uns 150px — bem visível.

       Ela para antes da borda porque o indicador lateral é fixo, vive no meio
       da altura e é mais largo que o padding direito do slide: o contador
       "02 / 08" avança uns 13px sobre a área de conteúdo. Nunca importou
       (nada encostava ali, e o texto que chega perto passa em outra altura),
       mas a moldura da direita cruza justamente o meio, e sem esta folga o
       nav (z 6) atravessa a foto. */
    /* Todas escopadas ao palco, como as do desktop. Sem isto elas vazam pra
       versão simples (data-creations="static"), que é uma pilha comum sem
       canva nem tela presa — e ali o -8vw do edge não teria quem o cortasse
       (o overflow: hidden do slide também é do palco), virando rolagem
       horizontal numa página que não deveria ter nenhuma. */
    :global(html[data-creations='stage']) [data-layout='flip'] .cc-media {
      --frame-h: calc(var(--phone-frame) * 0.94);
      justify-self: end;
      margin-right: 1.4rem;
    }

    /* tower: come metade da tela e sobra o justo pro texto */
    :global(html[data-creations='stage']) [data-layout='tower'] .cc-media {
      --frame-h: calc(var(--phone-frame) * 1.28);
      --frame-cap: 62vw;
      justify-self: end;
      margin-right: 1.4rem;
    }

    /* quiet: o selo pequeno. Aqui o título é que cresce e manda na tela */
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-media {
      --frame-h: calc(var(--phone-frame) * 0.66);
      justify-self: end;
      margin-right: 1.4rem;
    }
    :global(html[data-creations='stage']) [data-layout='quiet'] .cc-title {
      font-size: clamp(2.2rem, 9.5vw, 3.2rem);
    }

    /* edge: sangra pra fora da esquerda. No celular a saída é menor (8vw
       contra 16 do desktop) porque a largura toda é menor: o mesmo 16vw aqui
       levaria junto o assunto da foto, não só a borda dela */
    :global(html[data-creations='stage']) [data-layout='edge'] .cc-media {
      --frame-h: calc(var(--phone-frame) * 1.15);
      --frame-cap: 92vw;
      justify-self: start;
      margin-left: -8vw;
    }

    .cc-kicker {
      margin-bottom: 0.7rem;
      font-size: 0.62rem;
    }

    .cc-title {
      font-size: clamp(1.9rem, 7.6vw, 2.5rem);
    }

    .cc-desc {
      margin-top: 0.8rem;
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .cc-link {
      margin-top: 1rem;
      font-size: 0.8rem;
    }

    .cc-closing h2 {
      font-size: clamp(2.4rem, 11vw, 4rem);
    }

    /* sem margem onde acender no celular: o canva vira textura, com metade
       das fotos e sem passar do teto — o número vem do config (FIELD.MOBILE),
       escrito inline pelo build, pra não morar em dois lugares */
    .cc-field {
      --lit-cap: var(--lit-cap-mobile);
    }

    .cc-card.is-wide-only {
      display: none;
    }

    .cc-nav {
      right: calc(0.9rem + var(--viewport-right));
      gap: 0.7rem;
    }

    .cc-nav ol {
      gap: 0.45rem;
    }

    .cc-nav-num {
      display: none;
    }

    .cc-nav-mark {
      width: 1rem;
    }

    .cc-nav a[aria-current] .cc-nav-mark {
      width: 1.8rem;
    }

    .back {
      left: 1.35rem;
    }

    .theme {
      right: 1rem;
      width: 40px;
      height: 40px;
    }
  }

  /* celular baixo (iPhone SE e afins): ainda cabe, com tudo um pouco menor */
  @media (max-width: 46rem) and (max-height: 700px) {
