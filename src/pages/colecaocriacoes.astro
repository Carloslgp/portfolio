---
// /colecaocriacoes — a Coleção de Criações como uma sequência dirigida pelo
// scroll: abertura, uma criação por tela (presa enquanto a animação dela
// acontece) e um fechamento, com um indicador lateral de posição.
//
// Esta página não conhece nenhuma frase: tudo que aparece vem de
// src/data/creations.ts (com o guia src/data/creations.md ao lado). Os
// números da rolagem, dos efeitos e do campo de fotos ao fundo vêm de
// src/scripts/creations/config.ts, e o motor é src/scripts/creations/. Aqui
// só há markup, CSS e a checagem do build logo abaixo.
//
// Sem a cena 3D nem a transição de água do craft, de propósito: o vocabulário
// é o clássico do site (papel/tinta + botão de tema).
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import {
  CLOSING, CREATIONS, EFFECT_NAMES, FIELD_PHOTOS, KIND_LABEL, OPENING, UI,
} from '../data/creations';
import { EFFECTS, FIELD, FIELD_IMAGE, IMAGE, LAYOUT } from '../scripts/creations/config';
import { layoutField } from '../scripts/creations/fieldLayout';

const pad = (n: number) => String(n).padStart(2, '0');

// ——— o que o build recusa ———
//
// O tipo já impede um efeito inexistente no editor, mas a regra das vizinhas
// e a dos ids repetidos só existem em tempo de build — e é aqui que a lista
// inteira está à mão. A mensagem diz QUAL criação e O QUE fazer, porque quem
// vai ler é quem acabou de reordenar a lista, não quem escreveu isto.
const known = new Set<string>(EFFECT_NAMES);
const ids = new Set<string>();
CREATIONS.forEach((creation, i) => {
  const here = `a criação ${pad(i + 1)} ("${creation.id}")`;
  if (!known.has(creation.effect)) {
    throw new Error(
      `Coleção de Criações: ${here} usa o efeito "${creation.effect}", que não existe. ` +
        `Os efeitos são: ${EFFECT_NAMES.join(', ')} (src/data/creations.ts).`,
    );
  }
  if (ids.has(creation.id)) {
    throw new Error(
      `Coleção de Criações: ${here} repete um id que já existe na lista. ` +
        `Cada criação precisa de um id próprio (src/data/creations.ts).`,
    );
  }
  ids.add(creation.id);
  const prev = CREATIONS[i - 1];
  if (prev && prev.effect === creation.effect) {
    throw new Error(
      `Coleção de Criações: as criações ${pad(i)} ("${prev.id}") e ${pad(i + 1)} ("${creation.id}") ` +
        `usam o mesmo efeito "${creation.effect}" em sequência. Troque o efeito de uma delas ` +
        `em src/data/creations.ts.`,
    );
  }
});

// As variantes de cada imagem saem do pipeline do Astro no build (ver IMAGE
// no config). A proporção viaja como variável CSS: é ela que dimensiona a
// moldura, então uma foto deitada e uma em pé cabem na mesma tela sem que
// nenhuma seja cortada pra caber numa caixa fixa.
const slides = await Promise.all(
  CREATIONS.map(async (creation, index) => {
    const img = await getImage({
      src: creation.image,
      widths: [...IMAGE.WIDTHS],
      format: IMAGE.FORMAT,
      quality: IMAGE.QUALITY,
    });
    return {
      ...creation,
      index,
      number: pad(index + 1),
      anchor: `criacao-${pad(index + 1)}`,
      src: img.src,
      srcset: img.srcSet.attribute,
      ratio: creation.image.width / creation.image.height,
      from: creation.from ?? 'right',
    };
  }),
);

const total = pad(CREATIONS.length);
const pieceIndexes = Array.from({ length: EFFECTS.PIECES.COUNT }, (_, k) => k);

// O campo de fotos ao fundo: posições, tamanhos, deriva e constelações vêm
// prontos do build (ver scripts/creations/fieldLayout.ts) — um trecho pra
// abertura e um pra cada criação. A proporção de cada foto viaja como
// variável CSS pelo mesmo motivo das molduras.
const fieldCards = await Promise.all(
  layoutField(FIELD_PHOTOS.length ? FIELD.COUNT : 0, CREATIONS.length + 1).map(async (card) => {
    const photo = FIELD_PHOTOS[card.index % FIELD_PHOTOS.length];
    const img = await getImage({ src: photo, ...FIELD_IMAGE });
    return { ...card, src: img.src, ratio: photo.width / photo.height };
  }),
);
---

<Layout lang="pt">
  <Fragment slot="head">
    <title>Coleção de Criações · Carlos Leonardo</title>
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="preload"
      href="/fonts/playfair-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Palco ou versão simples? Decidido AQUI, antes do primeiro paint, e não
        no bundle: os dois layouts têm alturas de página muito diferentes (um
        palco de uma tela contra oito criações empilhadas), e trocar de um pro
        outro depois do primeiro quadro é a página inteira pulando.

        A resposta vem de duas perguntas. Baixa animação: a escolha feita no
        portão do site (sessionStorage, ver scripts/motion.ts) manda; o
        prefers-reduced-motion do sistema só vale pra quem entrou por link
        direto e nunca passou pelo portão. E "cabe?": abaixo de uma altura
        mínima a tela presa não tem onde pôr moldura + texto (ver LAYOUT no
        config). Sem JS nada disto roda, a marca não existe e o CSS entrega a
        versão simples — que é o layout padrão de propósito. */}
    <script is:inline define:vars={{ minStageHeight: LAYOUT.MIN_STAGE_HEIGHT }}>
      try {
        var mode = sessionStorage.getItem('motion-mode');
        if (mode === 'full' || mode === 'reduced')
          document.documentElement.dataset.motion = mode;
        var reduced = mode === 'reduced' ||
          (!mode && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        var fits = window.innerHeight >= minStageHeight;
        document.documentElement.dataset.creations = !reduced && fits ? 'stage' : 'static';
      } catch (e) {}
    </script>
  </Fragment>

  <div class="paper" aria-hidden="true"></div>

  {/* O `noreferrer` é o que faz a home rodar a abertura inteira ao voltar daqui.
      Ela decide entre a descida da câmera e o anel instantâneo pelo referrer
      (main.ts → isInternalArrival), e pular a descida só faz sentido pras
      páginas do anel: quem volta de lá já a assistiu e ainda renasce no
      segmento de onde saiu. Esta página não está no anel e não é linkada em
      lugar nenhum — chega-se nela pela URL — então sair daqui é uma chegada de
      verdade, não um passo atrás. Sem isto o anel aparecia estático depois da
      cortina de carregamento. */}
  <a class="back" href="/" rel="noreferrer">‹ Voltar</a>

  <button
    class="theme"
    data-theme-toggle
    aria-pressed="false"
    aria-label="Alternar tema claro/escuro"
    title="Tema claro / escuro"
  >
    <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>

  <main class="cc-page">
    {/* O palco: no modo 'stage' é uma tela de altura, presa pelo ScrollTrigger,
        com a abertura e as criações empilhadas em camadas dentro dele; na
        versão simples é só um contêiner, e as mesmas peças viram blocos de
        uma tela cada. Mesmo HTML, dois CSS. */}
    <div class="cc-stage" data-cc-stage>
      {/* O campo de fotos: atrás de tudo, decorativo (sem alt, fora da árvore
          de acessibilidade) e só no palco. As que passam de FIELD.MOBILE.COUNT
          levam uma classe que o CSS esconde no celular. */}
      <div
        class="cc-field"
        data-cc-field
        aria-hidden="true"
        style={`--lit-cap-mobile:${FIELD.MOBILE.LIT_CAP}`}
      >
        {fieldCards.map((c) => (
          <figure
            class:list={['cc-card', { 'is-wide-only': c.index >= FIELD.MOBILE.COUNT }]}
            data-cc-card
            data-dx={c.dx.toFixed(2)}
            data-dy={c.dy.toFixed(2)}
            data-levels={c.levels.join(',')}
            style={`--x:${c.x.toFixed(2)};--y:${c.y.toFixed(2)};--w:${c.w};--ratio:${c.ratio.toFixed(4)}`}
          >
            <img src={c.src} alt="" loading="lazy" decoding="async" draggable="false" />
          </figure>
        ))}
      </div>

      <header class="cc-hero" data-cc-hero>
        <p class="eyebrow" data-cc-hero-kicker>{OPENING.kicker}</p>
        <h1 data-cc-hero-title>{OPENING.title.line1}<br /><em>{OPENING.title.line2}</em></h1>
        <p class="lead" data-cc-hero-lead>{OPENING.lead}</p>
        <p class="cc-hint" data-cc-hero-hint aria-hidden="true"><span>{OPENING.hint}</span></p>
      </header>

      {slides.map((s) => (
        <section
          class="cc-slide"
          id={s.anchor}
          data-cc-slide
          data-effect={s.effect}
          data-from={s.from}
          aria-labelledby={`${s.anchor}-titulo`}
          style={`--ratio:${s.ratio.toFixed(4)}`}
        >
          {/* A moldura. Pro efeito `pieces` ela vira N tiras, cada uma com a
              MESMA <img> deslocada pra mostrar só a sua fatia (a largura da
              img é N vezes a da tira; o left desloca k tiras). Em repouso as
              tiras formam a imagem inteira — é o que a versão simples mostra —
              e é um pedido só de rede, porque a URL é a mesma. */}
          <div
            class:list={['cc-media', { 'is-pieces': s.effect === 'pieces' }]}
            data-cc-media
            style={s.effect === 'pieces' ? `--n:${EFFECTS.PIECES.COUNT}` : undefined}
          >
            {s.effect === 'pieces' ? (
              pieceIndexes.map((k) => (
                <div class="cc-piece" data-cc-piece style={`--k:${k}`}>
                  <img
                    src={s.src}
                    srcset={s.srcset}
                    sizes={IMAGE.SIZES}
                    alt={k === 0 ? s.alt : ''}
                    loading={s.index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    draggable="false"
                  />
                </div>
              ))
            ) : (
              <img
                src={s.src}
                srcset={s.srcset}
                sizes={IMAGE.SIZES}
                alt={s.alt}
                loading={s.index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                draggable="false"
              />
            )}
          </div>

          <div class="cc-copy">
            <p class="cc-kicker" data-cc-line>
              {UI.item} {s.number} · {KIND_LABEL[s.kind]}{s.date && ` · ${s.date}`}
            </p>
            <h2 class="cc-title" id={`${s.anchor}-titulo`} data-cc-line>{s.title}</h2>
            <p class="cc-desc" data-cc-line>{s.description}</p>
            {s.link && (
              <a class="cc-link" data-cc-line href={s.link.href} target="_blank" rel="noopener">
                {s.link.label} <span aria-hidden="true">{UI.linkMark}</span>
              </a>
            )}
          </div>

          {s.effect === 'curtain' && <div class="cc-curtain" data-cc-curtain aria-hidden="true"></div>}
        </section>
      ))}
    </div>

    <footer class="cc-closing" data-cc-closing>
      <div class="cc-closing-inner" data-cc-closing-inner>
        <p class="eyebrow">{CLOSING.kicker}</p>
        <h2>{CLOSING.title}</h2>
        <p class="lead">{CLOSING.text}</p>
        <nav aria-label="Voltar pro resto do site">
          {CLOSING.links.map((link) => (
            <a href={link.href} rel={link.href === '/' ? 'noreferrer' : undefined}>{link.label}</a>
          ))}
        </nav>
      </div>
    </footer>
  </main>

  {/* O indicador: um traço por criação e o contador. Os traços são âncoras de
      verdade — na versão simples o navegador as resolve sozinho, e no palco o
      script troca o destino pela posição de scroll da criação. */}
  <nav class="cc-nav" data-cc-nav aria-label={UI.nav}>
    <p class="cc-nav-count" aria-live="polite">
      <span data-cc-nav-current>—</span><span class="cc-nav-sep">/</span><span>{total}</span>
    </p>
    <ol>
      {slides.map((s) => (
        <li>
          <a
            href={`#${s.anchor}`}
            data-cc-nav-item
            aria-label={`${UI.jump} ${s.number} de ${total}: ${s.title}`}
          >
            <span class="cc-nav-num" aria-hidden="true">{s.number}</span>
            <span class="cc-nav-mark" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</Layout>

<script>
  import { initTheme } from '../scripts/theme';
  import { initCreations } from '../scripts/creations/main';

  initTheme();
  initCreations();
</script>

<style>
  .paper {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    transition: background-color var(--theme-fade);
  }

  /* A página rola — e o global.css dá a html e body o `height: 100%` +
     `overflow: hidden` de que a HOME precisa (canvas fixo, quem rola lá é o
     Lenis). Aqui os dois voltam ao normal, como na /work e na /craft. Sem
     isto o sintoma engana: o overflow do body propaga pro viewport, a página
     aparece inteira e nenhum gesto chega nela. */
  :global(html:has(.cc-page)),
  :global(html:has(.cc-page) body) {
    height: auto;
    overflow: visible;
  }

  .cc-page {
    position: relative;
    z-index: 1;
    color: var(--ink);
    transition: color var(--theme-fade);
  }

  /* ——— o palco ———
     O CSS padrão é a VERSÃO SIMPLES (blocos empilhados, uma tela cada). O
     palco só existe sob html[data-creations='stage'], que o script inline do
     <head> escreve quando há JS, animação e altura pra isso. Errar pro lado
     do empilhado é errar pro lado que sempre funciona. */
  .cc-stage {
    position: relative;
  }

  :global(html[data-creations='stage']) .cc-stage {
    height: var(--viewport-h);
    overflow: hidden;
  }

  /* ——— o campo de fotos ao fundo ———
     Só existe no palco: empilhada, a página é uma lista e um fundo de fotos
     posicionado em % de um contêiner de nove telas não faria sentido.

     A opacidade de cada foto é o PRODUTO de duas variáveis que o GSAP anima
     separadamente (ver field.ts): --level, o nível dela no trecho atual, e
     --breath, a respiração do campo inteiro. --lit-cap é o teto do celular. */
  .cc-field {
    --breath: 1;
    position: absolute;
    inset: 0;
    z-index: 0;
    display: none;
    overflow: hidden;
    pointer-events: none;
  }

  :global(html[data-creations='stage']) .cc-field {
    display: block;
  }

  /* --x/--y são o CENTRO da foto em % do palco e --w a largura em vmin; o
     canto sai da conta aqui, sem transform, porque o transform é do GSAP (a
     deriva) e um translate de centralização no CSS seria sobrescrito. */
  .cc-card {
    --level: 0;
    position: absolute;
    left: calc(var(--x) * 1% - var(--w) * 0.5vmin);
    top: calc(var(--y) * 1% - var(--w) * 0.5vmin / var(--ratio));
    width: calc(var(--w) * 1vmin);
    aspect-ratio: var(--ratio);
    margin: 0;
    opacity: calc(min(var(--level), var(--lit-cap, 1)) * var(--breath));
    will-change: transform, opacity;
  }

  .cc-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* a abertura e as criações ficam por cima do campo */
  :global(html[data-creations='stage']) .cc-hero,
  :global(html[data-creations='stage']) .cc-slide {
    z-index: 1;
  }

  /* ——— a abertura ——— */
  .cc-hero {
    position: relative;
    min-height: var(--viewport-h);
    display: grid;
    align-content: center;
    padding: clamp(6.5rem, 13vh, 9rem) clamp(1.5rem, 6vw, 6rem) clamp(6rem, 14vh, 8rem);
  }

  :global(html[data-creations='stage']) .cc-hero {
    position: absolute;
    inset: 0;
    min-height: 0;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  .cc-hero h1 {
    max-width: 10ch;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(4rem, min(11vw, 15vh), 8.8rem);
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.065em;
  }

  .cc-hero h1 em {
    font-weight: 400;
  }

  .lead {
    max-width: 31rem;
    margin-top: clamp(1.4rem, 3.5vh, 2.2rem);
    color: rgba(var(--ink-rgb), 0.68);
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.62;
    transition: color var(--theme-fade);
  }

  /* a dica de rolar: um rótulo e um fio que pulsa. Só no palco — na versão
     simples a página é uma lista e ninguém precisa ser convidado a rolar */
  .cc-hint {
    position: absolute;
    left: 50%;
    bottom: calc(1.6rem + env(safe-area-inset-bottom));
    display: none;
    justify-items: center;
    gap: 0.7rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transform: translateX(-50%);
    transition: color var(--theme-fade);
  }

  :global(html[data-creations='stage']) .cc-hint {
    display: grid;
  }

  .cc-hint::after {
    content: '';
    width: 1px;
    height: 2.4rem;
    background: currentColor;
    animation: cc-hint-pulse 1.8s ease-in-out infinite alternate;
  }

  @keyframes cc-hint-pulse {
    from { opacity: 0.25; transform: scaleY(0.6); transform-origin: top; }
    to { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  /* ——— as criações ——— */
  .cc-slide {
    position: relative;
    min-height: var(--viewport-h);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(4.5rem, 9vh, 6rem) clamp(1.5rem, 6vw, 6rem);
  }

  /* No palco as criações são camadas: mesma caixa, uma sobre a outra, e o
     GSAP decide qual está visível. O `visibility: hidden` aqui é o estado
     antes de o bundle rodar — sem ele, o quadro entre o script inline e o
     módulo mostraria as oito empilhadas na mesma tela. O GSAP escreve
     visibility inline (autoAlpha) e o inline ganha desta regra. */
  :global(html[data-creations='stage']) .cc-slide {
    position: absolute;
    inset: 0;
    min-height: 0;
    visibility: hidden;
  }

  /* A moldura tem a PROPORÇÃO da imagem (--ratio, escrita no build) e é
     limitada por altura (--frame-h) e pela coluna. A largura sai da conta
     explícita em vez de deixar o navegador transferir o max-height pela
     aspect-ratio: dá o mesmo resultado, sem depender de como cada motor
     resolve essa transferência. */
  .cc-media {
    --frame-h: min(72dvh, 46rem);
    position: relative;
    justify-self: end;
    width: min(100%, calc(var(--frame-h) * var(--ratio)));
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: rgba(var(--ink-rgb), 0.06);
    transition: background-color var(--theme-fade);
  }

  .cc-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* as tiras do `pieces`: a moldura deixa de recortar (as tiras voam pra
     fora dela ao entrar) e vira uma fileira; cada tira recorta a sua fatia */
  .cc-media.is-pieces {
    display: flex;
    overflow: visible;
    background: none;
  }

  .cc-piece {
    position: relative;
    flex: 1 0 0;
    overflow: hidden;
    background: rgba(var(--ink-rgb), 0.06);
  }

  .cc-piece img {
    left: calc(var(--k) * -100%);
    width: calc(var(--n) * 100%);
    /* o preflight do Tailwind (global.css) dá `max-width: 100%` a toda <img>,
       e aqui a imagem tem que ser N vezes mais larga que a tira que a
       recorta — sem isto ela encolhe pra largura da tira e as tiras 2..N
       ficam vazias (a imagem inteira, deslocada pra fora delas) */
    max-width: none;
  }

  .cc-copy {
    max-width: 30rem;
  }

  .cc-kicker {
    margin-bottom: 1.1rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  .cc-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  .cc-desc {
    margin-top: clamp(1.1rem, 2.4vh, 1.6rem);
    color: rgba(var(--ink-rgb), 0.68);
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.62;
    transition: color var(--theme-fade);
  }

  .cc-link {
    display: inline-block;
    margin-top: 1.6rem;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(var(--ink-rgb), 0.25);
    text-underline-offset: 3px;
    transition: color var(--theme-fade), text-decoration-color 0.25s ease;
  }

  .cc-link:hover,
  .cc-link:focus-visible {
    text-decoration-color: currentColor;
  }

  /* o painel do `curtain`: tinta sobre a criação inteira. Só faz sentido com
     o palco — empilhada, a criação tem que estar à vista */
  .cc-curtain {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    background: var(--ink);
    transform-origin: top center;
