---
// index.astro — frontmatter roda no build. Three.js NÃO vem aqui.
import Layout from '../layouts/Layout.astro';
import { SECTIONS } from '../components/carousel/config';

const first = SECTIONS[0];

// CONTEÚDO MOCK do About — tudo abaixo é placeholder pra trocar depois pelo
// texto real. Está marcado com o selo "placeholder" no próprio layout pra não
// escapar despercebido numa publicação.
const skills = [
  'TypeScript', 'Three.js', 'GSAP', 'React',
  'Astro', 'WebGL / GLSL', 'Node.js', 'Design de interface',
];
---

<Layout>
  <!-- a palavra gigante do fundo NÃO mora mais aqui: virou geometria na cena
       (Backdrop.ts), pra pegar perspectiva e descer junto com a câmera.
       A classe .bg-portfolio continua viva porque a cortina ainda a usa. -->
  <canvas id="scene"></canvas>

  <!-- Linha miúda do topo. Fica FORA do .overlay de propósito: aquele bloco tem
       z-index e por isso cria contexto de empilhamento próprio, onde o
       mix-blend-mode da .intro só enxergaria o próprio .overlay (vazio) em vez
       da cena. Aqui na raiz ela mistura com o canvas. -->
  <p class="intro" data-intro>
    <a href="#about" class="name">Carlos Leonardo</a> is a developer from Brazil.
  </p>

  <!-- camada 2D sobreposta -->
  <div class="overlay">
    <!-- a label da seção ativa agora é texto 3D de vidro dentro do canvas (Labels.ts);
         este h1 fica só pra semântica/leitores de tela -->
    <h1 class="sr-only" data-active-label>{first.label}</h1>

    <!-- card de categoria na base -->
    <div class="card">
      <button class="nav" data-step="1" aria-label="Anterior">‹</button>
      <img class="thumb" data-active-thumb src={first.texture} alt={first.label} />
      <div class="meta">
        <span class="meta-k">Category</span>
        <span class="meta-v" data-active-category>{first.label.toUpperCase()}</span>
      </div>
      <button class="nav" data-step="-1" aria-label="Próximo">›</button>
    </div>

    <!-- toggle de modo: botão redondo (curvo ↔ reto) -->
    <button class="mode" data-mode-toggle data-flat="false" aria-pressed="false" aria-label="Alternar curvo/reto" title="Curvo / Reto">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 0 1 15-6.7L21 8" />
        <path d="M21 3v5h-5" />
        <path d="M21 12a9 9 0 0 1-15 6.7L3 16" />
        <path d="M3 21v-5h5" />
      </svg>
    </button>
  </div>

  <!-- cursor sutil que segue o mouse com atraso -->
  <div class="cursor" data-cursor aria-hidden="true"></div>

  <!-- ——— About: MESMA página, revelada pela descida ———
       Fica fora de .overlay porque não é HUD sobre o canvas: quando abre, ele É
       a página.

       Nada aqui tem fundo próprio, e essa ausência é o efeito: o branco do
       <body> já é o papel, então o canvas fica visível por baixo do painel
       inteiro e os cacos que sobraram da quebra emolduram o texto — em cima e
       nas duas laterais. Pôr um fundo em qualquer um destes blocos taparia a
       moldura.

       .about-well é só o respiro do topo: o espaço onde os cacos de cima ficam,
       acima da primeira linha de texto. -->
  <section class="about" data-about hidden>
    <div class="about-well" aria-hidden="true"></div>

    <div class="about-sheet">
      <button class="about-close" data-about-close aria-label="Voltar ao carrossel">‹ Voltar</button>

      <div class="about-inner">
        <header class="about-head">
          <span class="tag">Placeholder — conteúdo mock</span>
          <h2>Sobre mim</h2>
          <p class="lead">
            [Espaço reservado] Desenvolvedor de interfaces que gosta de misturar código com
            teimosia visual. Este parágrafo de abertura é só um substituto até o texto real
            entrar no lugar.
          </p>
        </header>

        <div class="about-body">
          <p>
            [Placeholder] Comecei a programar mexendo em coisas que não deveriam ser mexidas e
            nunca mais parei. Hoje trabalho em algum ponto entre engenharia e design, tentando
            fazer telas que funcionem bem e que também dêem vontade de ficar olhando.
          </p>
          <p>
            [Placeholder] Fora do teclado, gosto de fotografia, café mal coado e de reescrever a
            mesma função três vezes até ela ficar simples o suficiente. Este texto, como os
            outros, é rascunho esperando a versão de verdade.
          </p>
        </div>

        <div class="about-skills">
          <h3>Stack &amp; skills <span class="tag tag-sm">mock</span></h3>
          <ul>{skills.map((s) => <li>{s}</li>)}</ul>
        </div>

        <div class="about-cta">
          <h3>Vamos conversar?</h3>
          <p>[Placeholder] Disponível para novos projetos e boas conversas sobre interfaces.</p>
          <div class="cta-actions">
            <a class="btn btn-solid" href="mailto:placeholder@example.com">Enviar e-mail</a>
            <button type="button" class="btn btn-glass" disabled>Baixar currículo</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- cortina: cobre a cena até fotos, fonte e shaders estarem prontos.
       Sai antes de a câmera começar a descer (ver scripts/loading.ts).
       O PORTFOLIO aqui é a MESMA classe do fundo da página, de propósito: ele
       cai exatamente em cima do outro, então a cortina abre sem a palavra pular -->
  <div class="loader" data-loader>
    <div class="bg-portfolio" aria-hidden="true">PORTFOLIO</div>
    <span class="loader-track"><i data-loader-bar></i></span>
  </div>
</Layout>

<script>
  import { bootstrap } from '../scripts/main';
  import { initUI } from '../scripts/ui';
  initUI();
  bootstrap();
</script>

<style>
  #scene {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    display: block;
    z-index: 1;
    touch-action: none;         /* arrasto controla o carrossel, não a página */
  }

  /* cortina de carregamento — acima de tudo (canvas 1, cursor 2, overlay 3) */
  .loader {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: var(--paper);
    transition: opacity 0.6s ease;
  }
  .loader.is-done {
    opacity: 0;
    pointer-events: none;
  }
  .loader-track {
    position: absolute;
    top: 46%;
    left: 50%;
    transform: translateX(-50%);
    width: min(220px, 42vw);
    height: 1px;
    background: rgba(10, 10, 10, 0.14);
    overflow: hidden;
  }
  .loader-track i {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  /* fundo gigante atrás do canvas */
  .bg-portfolio {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 7vh;              /* mais pra cima */
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 600;
    font-size: 15.5vw;           /* cabe na largura da tela com folga */
    letter-spacing: -0.02em;
    line-height: 1;
    color: #1a1a1a;
    user-select: none;
    white-space: nowrap;
  }

  /* overlay: transparente a clique; só filhos interativos capturam */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .overlay a,
  .overlay button {
    pointer-events: auto;
  }

  .intro {
    position: fixed;
    top: 2rem;
    left: 50%;
    z-index: 4;
    font-size: 0.9rem;
    font-weight: 400;
    white-space: nowrap;

    /* Legibilidade sobre QUALQUER fundo, pixel a pixel: 'difference' devolve o
       inverso do que está atrás. Sobre o branco da página a letra sai preta;
       onde passar o PORTFOLIO escuro ou uma foto escura, sai branca. Como a
       conta é por pixel, uma letra pega metade em cada lado quando a borda do
       preto corta ela no meio — não é um liga/desliga do texto inteiro. */
    color: #fff;
    mix-blend-mode: difference;

    /* só entra depois que a câmera assenta (a classe vem do main.ts) */
    opacity: 0;
    transform: translateX(-50%) translateY(-6px);
    transition: opacity 0.9s ease, transform 0.9s ease;

    /* fora do .overlay ela deixaria de ser "furada" a clique e viraria uma
       faixa morta em cima do canvas; só o link precisa capturar ponteiro */
    pointer-events: none;
  }
  .intro.is-in {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .intro .name {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    pointer-events: auto;
  }

  /* h1 invisível mas acessível (a versão visual é o texto 3D no canvas) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .card {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.5rem 0.7rem 0.5rem 0.5rem;
    border-radius: 999px;
    background: rgba(90, 90, 90, 0.28);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .card .thumb {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    object-fit: cover;
    transform: rotate(90deg);   /* alinha o thumbnail com a cena */
  }
  .card .meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 7ch;
    color: #fff;
  }
  .meta-k {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .meta-v {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .card .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    font-size: 1.1rem;
    line-height: 1;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .card .nav:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  /* luz que segue o mouse: glow radial quente que ilumina as imagens (blend screen).
     Sobre o branco vazio quase não aparece; sobre as fotos, vira uma luz suave. */
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 460px;
    height: 460px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      rgba(255, 244, 224, 0.1) 0%,
      rgba(255, 236, 206, 0.04) 32%,
      rgba(255, 232, 200, 0.015) 55%,
      transparent 72%
    );
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 2;                 /* acima do canvas, abaixo da UI (z-index: 3) */
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 0.6s ease;
    will-change: transform;
    filter: blur(8px);
  }
  @media (hover: none) {
    .cursor { display: none; }   /* sem luz em touch */
  }

  /* toggle redondo, encostado à direita do card */
  .mode {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(calc(-50% + 170px));
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    color: #fff;
    background: rgba(90, 90, 90, 0.28);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, transform 0.5s ease;
  }
  .mode:hover {
    background: rgba(90, 90, 90, 0.42);
  }
  .mode.is-flat {
    background: rgba(20, 20, 20, 0.55);   /* estado "reto" ativo */
  }
  .mode.is-flat svg {
    transform: rotate(180deg);
    transition: transform 0.5s ease;
  }

  /* Mergulho em curso: a UI do carrossel sai antes do impacto, senão a linha do
     topo e o card ficam boiando sobre o vidro quebrando. Precisa vir daqui (e
     não do global.css) por causa do .intro.is-in logo acima: no escopo do Astro
     estas regras ganham o atributo de escopo e passam à frente dele. */
  body.is-diving .intro.is-in,
  body.is-diving .card,
  body.is-diving .mode,
  body.is-diving .cursor {
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  /* ——— About: a página que sobe enquanto o vidro assenta ———
     Entra deslocado pra baixo da dobra e sobe na mesma timeline da câmera
     (ver scripts/main.ts → label 'descent'). */
  .about {
    position: relative;
    z-index: 5;
    /* SEM fundo, aqui e na .about-sheet: o branco do <body> já é o papel, e
       qualquer fundo neste caminho taparia a moldura de cacos no canvas. */
    background: transparent;

    /* respiro do topo: a faixa onde os cacos de cima ficam. Casa com
       BORDER.topBand, que os põe acima de 55% da meia-altura da tela. */
    --about-well-h: clamp(150px, 34svh, 340px);
  }
  .about[hidden] {
    display: none;
  }

  .about-well {
    height: var(--about-well-h);
  }

  .about-sheet {
    background: transparent;
    min-height: calc(100svh - var(--about-well-h));
  }

  .about-close {
    position: fixed;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 6;
    padding: 0.55rem 1.1rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
    background: rgba(90, 90, 90, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(10, 10, 10, 0.1);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .about-close:hover {
    background: rgba(90, 90, 90, 0.2);
  }

  .about-inner {
    max-width: 42rem;
    margin: 0 auto;
    /* menos respiro no topo do que antes: o poço acima já dá o ar */
    padding: 4rem 1.5rem 6rem;
  }

  .tag {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.55);
    background: rgba(10, 10, 10, 0.05);
    border: 1px solid rgba(10, 10, 10, 0.12);
    border-radius: 999px;
  }
  .tag-sm {
    margin: 0 0 0 0.5rem;
    vertical-align: middle;
  }

  .about h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 600;
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }
  .about h3 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 600;
    font-size: 1.6rem;
    margin-bottom: 1.2rem;
  }

  .lead {
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(10, 10, 10, 0.7);
  }
  .about-body {
    margin: 3.5rem 0;
  }
  .about-body p {
    line-height: 1.75;
    color: rgba(10, 10, 10, 0.78);
    margin-bottom: 1.25rem;
  }

  .about-skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
  }
  .about-skills li {
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(10, 10, 10, 0.8);
    background: rgba(10, 10, 10, 0.05);
    border: 1px solid rgba(10, 10, 10, 0.1);
    border-radius: 999px;
  }

  .about-cta {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
    text-align: center;
  }
  .about-cta p {
    color: rgba(10, 10, 10, 0.65);
    margin-bottom: 2rem;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .btn {
    padding: 0.75rem 1.5rem;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: opacity 0.2s, background 0.2s;
  }
  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
  .btn-solid {
    background: var(--ink);
    color: var(--paper);
  }
  .btn-solid:hover {
    opacity: 0.85;
  }
  .btn-glass {
    color: var(--ink);
    background: rgba(90, 90, 90, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(10, 10, 10, 0.12);
  }

  /* ——— telas estreitas: card ancora à esquerda, toggle à direita ———
     (o offset fixo de 170px do .mode estouraria a largura no celular) */
  @media (max-width: 700px) {
    .intro {
      top: 1.2rem;
      width: calc(100vw - 2rem);
      text-align: center;
      white-space: normal;
      font-size: 0.85rem;
    }

    .bg-portfolio {
      padding-top: calc(3rem + 4vh);   /* abre espaço pro .intro, que pode quebrar em 2 linhas */
      font-size: 17vw;
    }

    .card {
      left: 1rem;
      transform: none;
      bottom: calc(1.2rem + env(safe-area-inset-bottom));
      gap: 0.6rem;
      padding: 0.4rem 0.55rem 0.4rem 0.4rem;
    }
    .card .thumb {
      width: 40px;
      height: 40px;
    }
    .card .nav {
      width: 30px;
      height: 30px;
      font-size: 1rem;
    }
    .meta-v {
      font-size: 0.85rem;
    }

    .mode {
      left: auto;
      right: 1rem;
      transform: none;
      bottom: calc(1.2rem + env(safe-area-inset-bottom));
      width: 48px;
      height: 48px;
    }
  }

  /* paisagem baixa (celular deitado): comprime os respiros verticais */
  @media (max-height: 480px) {
    .bg-portfolio { padding-top: 1.2rem; }
    .intro { top: 0.8rem; }
    .card, .mode { bottom: 1rem; }
  }
</style>
