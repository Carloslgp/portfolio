---
// index.astro — frontmatter roda no build. Three.js NÃO vem aqui.
import Layout from '../layouts/Layout.astro';
import { SECTIONS } from '../components/carousel/config';

const first = SECTIONS[0];
---

<Layout>
  <!-- fundo: palavra gigante ATRÁS do canvas (canvas é transparente) -->
  <div class="bg-portfolio" aria-hidden="true">PORTFOLIO</div>

  <canvas id="scene"></canvas>

  <!-- camada 2D sobreposta -->
  <div class="overlay">
    <!-- linha miúda do topo (elemento separado do PORTFOLIO) -->
    <p class="intro">
      <a href="#about" class="name">Carlos Leonardo</a> is a developer from Brazil.
    </p>

    <!-- label grande e semitransparente da seção ativa, sobre o segmento central -->
    <h1 class="active-label" data-active-label>{first.label}</h1>

    <!-- card de categoria na base -->
    <div class="card">
      <button class="nav" data-step="1" aria-label="Anterior">‹</button>
      <img class="thumb" data-active-thumb src={first.texture} alt={first.label} />
      <div class="meta">
        <span class="meta-k">Category</span>
        <span class="meta-v" data-active-category>{first.label.toUpperCase()}</span>
      </div>
      <button class="nav" data-step="-1" aria-label="Próximo">›</button>
    </div>

    <!-- toggle de modo: botão redondo (curvo ↔ reto) -->
    <button class="mode" data-mode-toggle data-flat="false" aria-pressed="false" aria-label="Alternar curvo/reto" title="Curvo / Reto">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 0 1 15-6.7L21 8" />
        <path d="M21 3v5h-5" />
        <path d="M21 12a9 9 0 0 1-15 6.7L3 16" />
        <path d="M3 21v-5h5" />
      </svg>
    </button>
  </div>

  <!-- cursor sutil que segue o mouse com atraso -->
  <div class="cursor" data-cursor aria-hidden="true"></div>
</Layout>

<script>
  import { bootstrap } from '../scripts/main';
  import { initUI } from '../scripts/ui';
  initUI();
  bootstrap();
</script>

<style>
  #scene {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    display: block;
    z-index: 1;
    touch-action: none;         /* arrasto controla o carrossel, não a página */
  }

  /* fundo gigante atrás do canvas */
  .bg-portfolio {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 7vh;              /* mais pra cima */
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 600;
    font-size: 15.5vw;           /* cabe na largura da tela com folga */
    letter-spacing: -0.02em;
    line-height: 1;
    color: #1a1a1a;
    user-select: none;
    white-space: nowrap;
  }

  /* overlay: transparente a clique; só filhos interativos capturam */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .overlay a,
  .overlay button {
    pointer-events: auto;
  }

  .intro {
    position: absolute;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--ink);
    white-space: nowrap;
  }
  .intro .name {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .active-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.6rem, 8vw, 9rem);
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.6);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
    user-select: none;
    pointer-events: none;
  }

  .card {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.5rem 0.7rem 0.5rem 0.5rem;
    border-radius: 999px;
    background: rgba(90, 90, 90, 0.28);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .card .thumb {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    object-fit: cover;
    transform: rotate(90deg);   /* alinha o thumbnail com a cena */
  }
  .card .meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 7ch;
    color: #fff;
  }
  .meta-k {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .meta-v {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .card .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    font-size: 1.1rem;
    line-height: 1;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .card .nav:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  /* luz que segue o mouse: glow radial quente que ilumina as imagens (blend screen).
     Sobre o branco vazio quase não aparece; sobre as fotos, vira uma luz suave. */
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 460px;
    height: 460px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      rgba(255, 244, 224, 0.1) 0%,
      rgba(255, 236, 206, 0.04) 32%,
      rgba(255, 232, 200, 0.015) 55%,
      transparent 72%
    );
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 2;                 /* acima do canvas, abaixo da UI (z-index: 3) */
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 0.6s ease;
    will-change: transform;
    filter: blur(8px);
  }
  @media (hover: none) {
    .cursor { display: none; }   /* sem luz em touch */
  }

  /* toggle redondo, encostado à direita do card */
  .mode {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(calc(-50% + 170px));
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    color: #fff;
    background: rgba(90, 90, 90, 0.28);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, transform 0.5s ease;
  }
  .mode:hover {
    background: rgba(90, 90, 90, 0.42);
  }
  .mode.is-flat {
    background: rgba(20, 20, 20, 0.55);   /* estado "reto" ativo */
  }
  .mode.is-flat svg {
    transform: rotate(180deg);
    transition: transform 0.5s ease;
  }

  /* ——— telas estreitas: card ancora à esquerda, toggle à direita ———
     (o offset fixo de 170px do .mode estouraria a largura no celular) */
  @media (max-width: 700px) {
    .intro {
      top: 1.2rem;
      width: calc(100vw - 2rem);
      text-align: center;
      white-space: normal;
      font-size: 0.85rem;
    }

    .bg-portfolio {
      padding-top: calc(3rem + 4vh);   /* abre espaço pro .intro, que pode quebrar em 2 linhas */
      font-size: 17vw;
    }

    .card {
      left: 1rem;
      transform: none;
      bottom: calc(1.2rem + env(safe-area-inset-bottom));
      gap: 0.6rem;
      padding: 0.4rem 0.55rem 0.4rem 0.4rem;
    }
    .card .thumb {
      width: 40px;
      height: 40px;
    }
    .card .nav {
      width: 30px;
      height: 30px;
      font-size: 1rem;
    }
    .meta-v {
      font-size: 0.85rem;
    }

    .mode {
      left: auto;
      right: 1rem;
      transform: none;
      bottom: calc(1.2rem + env(safe-area-inset-bottom));
      width: 48px;
      height: 48px;
    }
  }

  /* paisagem baixa (celular deitado): comprime os respiros verticais */
  @media (max-height: 480px) {
    .bg-portfolio { padding-top: 1.2rem; }
    .intro { top: 0.8rem; }
    .card, .mode { bottom: 1rem; }
  }
</style>
