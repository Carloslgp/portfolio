  /* ——— tópicos (ver src/data/about.ts) ———
     Um bloco por assunto. O espaço entre eles é o que separa: sem linha, sem
     caixa — o título já é a fronteira. */
  .topic + .topic {
    margin-top: 3.5rem;
  }
  .topic {
    position: relative;
  }
  .topic h3 {
    /* mais discreto que os títulos de fora (Stack, Let's talk): estes são
       divisórias dentro de um texto corrido, não seções da página */
    font-size: 1.35rem;
    margin-bottom: 0.9rem;
  }
  /* o último parágrafo do tópico não precisa de respiro embaixo: quem dá o
     intervalo até o próximo título é o .topic + .topic */
  .topic > :last-child {
    margin-bottom: 0;
  }

  /* ——— fotos e espaços reservados ———
     A moldura tem medida própria (aspect-ratio), então ela ocupa o mesmo
     lugar vazia ou com a imagem: acrescentar o src depois não empurra o texto
     em volta nem muda a altura da página. */
  .shot {
    margin: 2rem 0;
    overflow: hidden;
    border-radius: 2px;
    aspect-ratio: 3 / 2;
  }
  /* <video> entra na MESMA moldura da foto: o bloco de animação é um bloco de
     foto que se mexe, e a medida da página não pode depender de qual dos dois é */
  .shot img,
  .shot video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shot .is-contained {
    object-fit: contain;
    background: #000;
  }

  /* A exceção à moldura: uma imagem que não é fotografia entra no tamanho em
     que nasceu. A tirinha do fim tem 415px de origem — a coluna tem ~624 e a
     esticaria, e o corte da moldura comeria os balões, que são a imagem
     inteira. Sem aspect-ratio a figure passa a ter a altura da imagem; o
     fit-content dá a ela a largura do ARQUIVO, então o teto é o pixel que
     existe e não tem número mágico aqui pra sair de sincronia com a imagem
     depois — reenquadrar a tirinha é trocar o arquivo, sem tocar no CSS. Em
     coluna estreita o max-width devolve a mão pro container. */
  .shot.is-natural {
    width: fit-content;
    margin-inline: auto;
    aspect-ratio: auto;
  }
  .shot.is-natural img {
    width: auto;
    height: auto;
    max-width: 100%;
  }

  /* Só enquanto está vazio. O tracejado é de propósito: um retângulo cinza
     liso passaria por decisão de design e escaparia numa publicação. */
  .shot.is-empty {
