---
// index.astro — frontmatter roda no build. Three.js NÃO vem aqui.
import Layout from '../layouts/Layout.astro';
import { SECTIONS } from '../components/carousel/config';

const first = SECTIONS[0];

// CONTEÚDO MOCK do About — tudo abaixo é placeholder pra trocar depois pelo
// texto real. Está marcado com o selo "placeholder" no próprio layout pra não
// escapar despercebido numa publicação.
const skills = [
  'TypeScript', 'Three.js', 'GSAP', 'React',
  'Astro', 'WebGL / GLSL', 'Node.js', 'Design de interface',
];
---

<Layout>
  <!-- a palavra gigante do fundo NÃO mora mais aqui: virou geometria na cena
       (Backdrop.ts), pra pegar perspectiva e descer junto com a câmera.
       A classe .bg-portfolio continua viva porque a cortina ainda a usa. -->
  <canvas id="scene"></canvas>

  <!-- Linha miúda do topo. Fica FORA do .overlay de propósito: aquele bloco tem
       z-index e por isso cria contexto de empilhamento próprio, onde o
       mix-blend-mode da .intro só enxergaria o próprio .overlay (vazio) em vez
       da cena. Aqui na raiz ela mistura com o canvas. -->
  <p class="intro" data-intro>
    <!-- o aria-label fixa o nome acessível: o hover (e o Tab) trocam o texto por
         ruído por meio segundo, e sem ele um leitor de tela leria o ruído -->
    <a href="#about" class="name" data-scramble aria-label="Carlos Leonardo">Carlos Leonardo</a> is a developer from Brazil.
  </p>

  <!-- Os dois cantos do topo. Ficam fora do .overlay pelo mesmo motivo do
       .intro: precisam do mix-blend-mode enxergando o canvas, não o overlay.
       O conteúdo dos dois é preenchido no cliente (scripts/hud.ts) — vazios no
       HTML de propósito, já que hora e frase são estado de agora, não de build. -->
  <p class="hud clock" data-hud>
    <span data-clock-time></span><span class="clock-place">, <span class="hot" data-scramble>Curitiba</span></span>
  </p>

  <p class="hud quote" data-hud>
    <span data-quote></span>
  </p>

  <!-- camada 2D sobreposta -->
  <div class="overlay">
    <!-- a label da seção ativa agora é texto 3D de vidro dentro do canvas (Labels.ts);
         este h1 fica só pra semântica/leitores de tela -->
    <h1 class="sr-only" data-active-label>{first.label}</h1>

    <!-- card de categoria na base -->
    <div class="card">
      <button class="nav" data-step="1" aria-label="Anterior">‹</button>
      <img class="thumb" data-active-thumb src={first.texture} alt={first.label} />
      <div class="meta">
        <span class="meta-k">Category</span>
        <span class="meta-v" data-active-category>{first.label.toUpperCase()}</span>
      </div>
      <button class="nav" data-step="-1" aria-label="Próximo">›</button>
    </div>

    <!-- toggle de modo: botão redondo (curvo ↔ reto) -->
    <button class="mode" data-mode-toggle data-flat="false" aria-pressed="false" aria-label="Alternar curvo/reto" title="Curvo / Reto">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 0 1 15-6.7L21 8" />
        <path d="M21 3v5h-5" />
        <path d="M21 12a9 9 0 0 1-15 6.7L3 16" />
        <path d="M3 21v-5h5" />
      </svg>
    </button>
  </div>

  <!-- cursor sutil que segue o mouse com atraso -->
  <div class="cursor" data-cursor aria-hidden="true"></div>

  <!-- ——— About: MESMA página, revelada pela descida ———
       Fica fora de .overlay porque não é HUD sobre o canvas: quando abre, ele É
       a página.

       Nada aqui tem fundo próprio, e essa ausência é o efeito: o branco do
       <body> já é o papel, então o canvas fica visível por baixo do painel
       inteiro e os cacos que sobraram da quebra formam o cabeçalho, no alto.
       Pôr um fundo em qualquer um destes blocos taparia o vidro.

       .about-well é o respiro do topo: o espaço onde os cacos ficam, acima da
       primeira linha de texto. É ele que garante que o texto NUNCA seja lido
       por cima de um pedaço de foto — os cacos param em v ≥ 0.52 (BORDER.topBand),
       que na tela é o quarto superior, e o poço é mais alto do que isso. -->
  <section class="about" data-about hidden>
    <div class="about-well" aria-hidden="true"></div>

    <div class="about-sheet">
      <button class="about-close" data-about-close aria-label="Voltar ao carrossel">‹ Voltar</button>

      <div class="about-inner">
        <header class="about-head">
          <span class="tag">Placeholder — conteúdo mock</span>
          <h2>Sobre mim</h2>
          <p class="lead">
            [Espaço reservado] Desenvolvedor de interfaces que gosta de misturar código com
            teimosia visual. Este parágrafo de abertura é só um substituto até o texto real
            entrar no lugar.
          </p>
        </header>

        <div class="about-body">
          <p>
            [Placeholder] Comecei a programar mexendo em coisas que não deveriam ser mexidas e
            nunca mais parei. Hoje trabalho em algum ponto entre engenharia e design, tentando
            fazer telas que funcionem bem e que também dêem vontade de ficar olhando.
          </p>
          <p>
            [Placeholder] Fora do teclado, gosto de fotografia, café mal coado e de reescrever a
            mesma função três vezes até ela ficar simples o suficiente. Este texto, como os
            outros, é rascunho esperando a versão de verdade.
          </p>
        </div>

        <div class="about-skills">
          <h3>Stack &amp; skills <span class="tag tag-sm">mock</span></h3>
          <ul>{skills.map((s) => <li>{s}</li>)}</ul>
        </div>

        <div class="about-cta">
          <h3>Vamos conversar?</h3>
          <p>[Placeholder] Disponível para novos projetos e boas conversas sobre interfaces.</p>
          <div class="cta-actions">
            <a class="btn btn-solid" href="mailto:placeholder@example.com">Enviar e-mail</a>
            <button type="button" class="btn btn-glass" disabled>Baixar currículo</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- cortina: cobre a cena até fotos, fonte e shaders estarem prontos.
       Sai antes de a câmera começar a descer (ver scripts/loading.ts).
       O PORTFOLIO aqui é a MESMA classe do fundo da página, de propósito: ele
       cai exatamente em cima do outro, então a cortina abre sem a palavra pular -->
  <div class="loader" data-loader>
    <div class="bg-portfolio" aria-hidden="true">PORTFOLIO</div>
    <span class="loader-track"><i data-loader-bar></i></span>

    <!-- O portão. A cortina não sai enquanto não houver escolha (ver
         scripts/loading.ts → awaitGate). role="dialog" porque é exatamente
         isto: uma pergunta que bloqueia o resto da página até ser respondida. -->
    <div class="gate" data-gate role="dialog" aria-modal="true" aria-labelledby="gate-q">
      <p class="gate-q" id="gate-q">Como você prefere ver este site?</p>

      <div class="gate-opts">
        <button type="button" class="gate-btn" data-gate-motion="full">
          Com animação
          <small>a experiência completa: câmera, vidro e transições</small>
        </button>
        <button type="button" class="gate-btn" data-gate-motion="reduced">
          Baixa animação
          <small>sem mergulho de câmera nem estilhaço — o conteúdo direto</small>
        </button>
      </div>

      <!-- Ainda sem função: o destino (versão simples, navegável por Tab) não
           existe. Fica desabilitado e dizendo "em breve" de propósito — um
           botão vivo que não leva a lugar nenhum seria pior justamente pra
           quem depende dele. Pra ligar: trocar por <a href> pro site simples. -->
      <button type="button" class="gate-help" data-gate-a11y disabled aria-disabled="true">
        Precisa de auxílio para navegação? <span>em breve</span>
      </button>
    </div>
  </div>
</Layout>

<script>
  import { bootstrap } from '../scripts/main';
  import { initUI } from '../scripts/ui';
  import { initHud } from '../scripts/hud';
  import { initScramble } from '../scripts/scramble';
  initUI();
  initHud();
  initScramble();
  bootstrap();
</script>

<style>
  #scene {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    display: block;
    z-index: 1;
    touch-action: none;         /* arrasto controla o carrossel, não a página */
  }

  /* cortina de carregamento — acima de tudo (canvas 1, cursor 2, overlay 3) */
  .loader {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: var(--paper);
    transition: opacity 0.6s ease;
  }
  .loader.is-done {
    opacity: 0;
    pointer-events: none;
  }
  .loader-track {
    position: absolute;
    top: 46%;
    left: 50%;
    transform: translateX(-50%);
    width: min(220px, 42vw);
    height: 1px;
    background: rgba(10, 10, 10, 0.14);
    overflow: hidden;
  }
  .loader-track i {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  /* ——— portão de entrada (ver scripts/loading.ts) ——— */
  .gate {
    position: absolute;
    top: 54%;
    left: 50%;
    transform: translateX(-50%);
    width: min(560px, 88vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  /* some assim que a escolha é feita, e não junto com a cortina: a resposta
     precisa sumir antes, senão os botões ficariam por cima da cena descendo */
  .gate.is-chosen {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .gate-q {
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .gate-opts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
  }
  .gate-btn {
    flex: 1 1 220px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1.1rem;
    background: transparent;
    border: 1px solid rgba(10, 10, 10, 0.22);
    color: var(--ink);
    font: inherit;
    font-size: 0.85rem;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .gate-btn:hover,
  .gate-btn:focus-visible {
    border-color: var(--ink);
    background: rgba(10, 10, 10, 0.04);
  }
  .gate-btn small {
    font-size: 0.7rem;
    line-height: 1.35;
    opacity: 0.55;
  }
  .gate-help {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 0.72rem;
    color: rgba(10, 10, 10, 0.45);
    cursor: not-allowed;
  }
  .gate-help span {
    margin-left: 0.35rem;
    padding: 0 0.3rem;
    border: 1px solid currentColor;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Escolheu baixa animação: as transições puramente decorativas do DOM saem
     junto com as do canvas. O seletor mora no <html> (ver scripts/motion.ts),
     então isto vale pra página inteira sem o JS ter de tocar em cada elemento.
     A cortina fica de fora — ela ainda precisa sumir com fade, senão o site
     aparece num corte seco. */
  :global(html[data-motion='reduced']) .quote span,
  :global(html[data-motion='reduced']) .card,
  :global(html[data-motion='reduced']) .cursor {
    transition: none;
  }
  :global(html[data-motion='reduced']) .cursor {
    display: none;
  }

  /* fundo gigante atrás do canvas */
  .bg-portfolio {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 7vh;              /* mais pra cima */
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 600;
    font-size: 15.5vw;           /* cabe na largura da tela com folga */
    letter-spacing: -0.02em;
    line-height: 1;
    color: #1a1a1a;
    user-select: none;
    white-space: nowrap;
  }

  /* overlay: transparente a clique; só filhos interativos capturam */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .overlay a,
  .overlay button {
    pointer-events: auto;
  }

  .intro {
    position: fixed;
    top: 2rem;
    left: 50%;
    z-index: 4;
    font-size: 0.9rem;
    font-weight: 400;
    white-space: nowrap;

    /* Legibilidade sobre QUALQUER fundo, pixel a pixel: 'difference' devolve o
       inverso do que está atrás. Sobre o branco da página a letra sai preta;
       onde passar o PORTFOLIO escuro ou uma foto escura, sai branca. Como a
       conta é por pixel, uma letra pega metade em cada lado quando a borda do
       preto corta ela no meio — não é um liga/desliga do texto inteiro. */
    color: #fff;
    mix-blend-mode: difference;

    /* só entra depois que a câmera assenta (a classe vem do main.ts) */
    opacity: 0;
    transform: translateX(-50%) translateY(-6px);
    transition: opacity 0.9s ease, transform 0.9s ease;

    /* fora do .overlay ela deixaria de ser "furada" a clique e viraria uma
       faixa morta em cima do canvas; só o link precisa capturar ponteiro */
    pointer-events: none;
  }
  .intro.is-in {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .intro .name {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    pointer-events: auto;
  }

  /* ——— cantos do topo: hora à esquerda, frase à direita ———
     Mesmo truque de legibilidade do .intro (difference sobre o canvas) e mesma
     entrada: nascem apagados e só acendem quando o main.ts põe .is-in, com a
     cena já parada. Sem is-in eles simplesmente não existem na tela — que é o
     comportamento certo se o JS não rodar, já que estariam vazios. */
  .hud {
    position: fixed;
    top: 2rem;
    z-index: 4;
    font-size: 0.8rem;
    line-height: 1.55;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;

    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  .hud.is-in {
    opacity: 1;
    transform: translateY(0);
  }

  .clock {
    left: 2rem;
    letter-spacing: 0.06em;
    /* dígitos de mesma largura: a virada do minuto não empurra o ", Curitiba" */
    font-variant-numeric: tabular-nums;
  }
  .clock-place {
    color: inherit;
    opacity: 0.62;
  }

  .quote {
    right: 2rem;
    max-width: min(26ch, 26vw);
    text-align: right;
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.4;
  }
  /* o crossfade da troca mora no span de dentro; a opacidade de fora é da
     entrada, e misturar as duas faria uma cancelar a outra.
     inline-block (e não block) porque a caixa precisa encolher até o texto: em
     block ela ocuparia a max-width inteira e sobraria uma área invisível
     capturando ponteiro em cima do canvas, onde se arrasta o carrossel. */
  .quote span {
    display: inline-block;
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .quote span.is-out {
    opacity: 0;
    transform: translateY(-4px);
  }

  /* ——— hover de decifração ———
     Os alvos precisam voltar a capturar ponteiro (o .hud inteiro é furado a
     clique), e só onde existe ponteiro de verdade: em touch isto seria só uma
     área morta sobre o canvas. O inline-block é o que deixa o script travar a
     largura da caixa enquanto o texto é ruído — ver scripts/scramble.ts. */
  @media (hover: hover) {
    .clock .hot,
    .quote span {
      pointer-events: auto;
    }
  }
  .is-scrambling {
    display: inline-block;
    /* a largura está travada e os glifos sorteados podem ser mais largos que a
       letra que substituem; sem isto, uma linha vazaria a caixa por um frame */
    overflow: hidden;
  }
  .clock .hot {
    cursor: default;
  }

  /* h1 invisível mas acessível (a versão visual é o texto 3D no canvas) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .card {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.5rem 0.7rem 0.5rem 0.5rem;
    border-radius: 999px;
    background: rgba(90, 90, 90, 0.28);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .card .thumb {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    object-fit: cover;
    transform: rotate(90deg);   /* alinha o thumbnail com a cena */
  }
  .card .meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 7ch;
    color: #fff;
  }
  .meta-k {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .meta-v {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .card .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    font-size: 1.1rem;
    line-height: 1;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .card .nav:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  /* luz que segue o mouse: glow radial quente que ilumina as imagens (blend screen).
     Sobre o branco vazio quase não aparece; sobre as fotos, vira uma luz suave. */
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 460px;
    height: 460px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      rgba(255, 244, 224, 0.1) 0%,
      rgba(255, 236, 206, 0.04) 32%,
      rgba(255, 232, 200, 0.015) 55%,
      transparent 72%
    );
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 2;                 /* acima do canvas, abaixo da UI (z-index: 3) */
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 0.6s ease;
    will-change: transform;
    filter: blur(8px);
  }
  @media (hover: none) {
    .cursor { display: none; }   /* sem luz em touch */
  }

  /* toggle redondo, encostado à direita do card */
  .mode {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(calc(-50% + 170px));
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    color: #fff;
    background: rgba(90, 90, 90, 0.28);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, transform 0.5s ease;
  }
  .mode:hover {
    background: rgba(90, 90, 90, 0.42);
  }
  .mode.is-flat {
    background: rgba(20, 20, 20, 0.55);   /* estado "reto" ativo */
  }
  .mode.is-flat svg {
    transform: rotate(180deg);
    transition: transform 0.5s ease;
  }

  /* Mergulho em curso: a UI do carrossel sai antes do impacto, senão a linha do
     topo e o card ficam boiando sobre o vidro quebrando. Precisa vir daqui (e
     não do global.css) por causa do .intro.is-in logo acima: no escopo do Astro
     estas regras ganham o atributo de escopo e passam à frente dele. */
  body.is-diving .intro.is-in,
  body.is-diving .hud.is-in,
  body.is-diving .card,
  body.is-diving .mode,
  body.is-diving .cursor {
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  /* ——— About: a página que sobe enquanto o vidro assenta ———
     Entra deslocado pra baixo da dobra e sobe na mesma timeline da câmera
     (ver scripts/main.ts → label 'descent'). */
  .about {
    position: relative;
    z-index: 5;
    /* SEM fundo, aqui e na .about-sheet: o branco do <body> já é o papel, e
       qualquer fundo neste caminho taparia o cabeçalho de cacos no canvas. */
    background: transparent;

    /* respiro do topo: a faixa onde os cacos ficam. Casa com BORDER.topBand,
       que os põe acima de 52% da meia-altura da tela — ou seja, dentro do
       quarto superior. Encurtar isto joga a primeira linha de texto pra dentro
       do vidro. */
    --about-well-h: clamp(150px, 34svh, 340px);
  }
  .about[hidden] {
    display: none;
  }

  .about-well {
    height: var(--about-well-h);
  }

  .about-sheet {
    background: transparent;
    min-height: calc(100svh - var(--about-well-h));
  }

  .about-close {
    position: fixed;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 6;
    padding: 0.55rem 1.1rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
    background: rgba(90, 90, 90, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(10, 10, 10, 0.1);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .about-close:hover {
    background: rgba(90, 90, 90, 0.2);
  }

  .about-inner {
    max-width: 42rem;
    margin: 0 auto;
    /* menos respiro no topo do que antes: o poço acima já dá o ar */
    padding: 4rem 1.5rem 6rem;
  }

  .tag {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.55);
