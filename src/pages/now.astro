---
// now.astro — a página /now. O TEXTO todo mora em src/data/now.ts; aqui só
// existe a forma de desenhá-lo.
//
// A chegada é a segunda metade de uma transição que começou no anel (ver
// scripts/main.ts → initNowLink). O último quadro da home é: a pintura do
// segmento subida e lavada de luz, e a hora de Curitiba gigante no meio da
// tela. Esta página NASCE nesse quadro — os mesmos dois elementos, no mesmo
// lugar — e só então ele se desfaz: a pintura desce e sai de quadro, e a hora
// encolhe até assentar como o carimbo do cabeçalho.
//
// A hora não é passada de uma página pra outra. Os dois documentos perguntam
// `new Date()` pela mesma função (scripts/nowNavigation.ts → nowTime) e chegam
// na mesma string porque é o mesmo instante. É a emenda mais barata que este
// site tem: não há nada a sincronizar.
import Layout from '../layouts/Layout.astro';
import { NOW_SEAM, NOW_TZ } from '../scripts/nowNavigation';
import { ASIDES, HORIZONS, LEAD, NOW_NOTE, PANELS, PLACE, STRANDS, UPDATED } from '../data/now';

const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

/** 'YYYY-MM' → "August 2026". Duas linhas em vez de um import do data/work.ts:
 *  o `stamp` de lá abrevia o mês ("Aug") porque ali ele divide linha com um
 *  intervalo inteiro. Aqui cada data aparece sozinha e cabe por extenso. */
function month(value: string): string {
  const [year, m] = value.split('-');
  return m ? `${MONTHS[Number(m) - 1]} ${year}` : year;
}

/** A página em passos de animação, na mesma contagem da /work.
 *
 *  O passo 1 é a fileira de abas: ela ocupa altura entre o cabeçalho e a lista,
 *  então precisa ocupar tempo também — senão a primeira linha entra antes do
 *  controle que a comanda. O 2 é a nota do painel, e as linhas começam no 3. */
const TABS_STEP = 1;
const NOTE_STEP = TABS_STEP + 1;

/** Quantas linhas do painel de abertura entram escalonadas com a cortina.
 *
 *  Só o painel que a página abre mostrando entra escalonado: o outro nasce fora
 *  da tela, e animar quem ninguém vê é composição pura. Três porque a conta
 *  muda com a tela — num notebook baixo a terceira já fica fora, num monitor
 *  alto ela está lá, e uma linha visível que NÃO entra escalonada aparece mais
 *  do que uma invisível que entra. */
const REVEAL_ROWS = 3;

/** O passo de uma linha do primeiro painel, ou null pra quem não é animado:
 *  as linhas de baixo da dobra e o painel inteiro que nasce fora da tela. */
function step(panel: number, row: number): number | null {
  return panel === 0 && row < REVEAL_ROWS ? NOTE_STEP + 1 + row : null;
}
---

<Layout lang="en">
  <Fragment slot="head">
    <title>Now · Carlos Leonardo</title>
    <meta
      name="description"
      content="What Carlos Leonardo is working on, building and learning right now."
    />
    <link rel="prefetch" href="/" />

    {/* A hora gigante é a primeira coisa que esta página pinta, e ela é
        Playfair. Sem o preload o navegador só descobre a fonte depois de baixar
        e analisar o CSS, e o primeiro quadro sairia na fonte do sistema — num
        tamanho diferente, no lugar errado, e a emenda com a home apareceria
        justamente no quadro em que ela não pode aparecer. É o único preload
        desta página além do Inter que o Layout já faz. */}
    <link
      rel="preload"
      href="/fonts/playfair-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* As medidas da emenda descem pro CSS aqui, e não como literais na folha
        de estilo: elas são o contrato com a home (ver scripts/nowNavigation.ts)
        e o mesmo punhado de números tem que valer nos dois documentos. */}
    <script
      is:inline
      define:vars={{
        nowAspect: NOW_SEAM.aspect,
        nowOverscan: NOW_SEAM.overscan,
        nowRotation: NOW_SEAM.rotation,
        nowDrift: NOW_SEAM.drift,
      }}
    >
      document.documentElement.style.setProperty('--now-aspect', nowAspect);
      document.documentElement.style.setProperty('--now-overscan', nowOverscan);
      document.documentElement.style.setProperty('--now-rotation', nowRotation + 'deg');
      document.documentElement.style.setProperty('--now-drift', nowDrift + 'dvh');
      /* A marca que liga o modo painel, igual à da /work: a página vira duas
         telas que deslizam, em vez de duas listas empilhadas. Ela nasce AQUI,
         antes do primeiro paint, e não no bundle — recortar a página em duas
         depois do primeiro quadro é um salto de layout visível pra quem entra
         por link direto (quem vem do anel não veria, porque a cortina cobre).

         E ela nasce do JS de propósito: sem script as abas não trocam nada, e
         uma página presa numa aba mostrando metade do que tem seria conteúdo
         perdido. Sem a marca o CSS devolve as duas listas em sequência. */
      document.documentElement.dataset.nowPanels = '';
      try {
        if (sessionStorage.getItem('portfolio:now-entry')) {
          sessionStorage.removeItem('portfolio:now-entry');
          document.documentElement.dataset.nowEntry = 'armed';
        }
      } catch (e) {}
    </script>
  </Fragment>

  <div class="paper" aria-hidden="true"></div>

  {/* ——— o céu ———
      Ela NÃO é animada: está aqui desde o primeiro quadro, escondida atrás da
      cortina, e aparece porque a cortina DESLIZA pra fora. Uma transição a
      menos, e o resultado é o que se quer — a claridade não "chega" na página,
      ela já era da página; o que estava por cima é que era foto. Quem entra por
      link direto vê só isto, que é o cabeçalho da página em qualquer caso. */}
  <div class="now-sky" aria-hidden="true"></div>

  {/* ——— a cortina: o último quadro da home, parado ———
      Os mesmos dois elementos do portal de lá (index.astro), nas mesmas
      medidas. A hora fica FORA da .now-seam porque a pintura sai de quadro e
      ela não — cada uma tem o seu caminho. */}
  <div class="now-entry" data-now-entry aria-hidden="true">
    <div class="now-seam" data-now-entry-seam>
      <img src="/textures/now.jpg" alt="" />
    </div>
  </div>
  <span class="now-clock" data-now-entry-clock aria-hidden="true"></span>

  <a class="back" href="/" data-now-back>‹ Back</a>

  <button
    class="theme"
    data-theme-toggle
    aria-pressed="false"
    aria-label="Toggle dark theme"
    title="Light / dark theme"
  >
    <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>

  <main class="now-page">
    <div class="now-inner">
      <header class="now-head">
        {/* O carimbo é onde a hora gigante ATERRISSA, e por isso ele é o único
            bloco do cabeçalho que não entra deslizando: os outros sobem 18px
            até o lugar, e um alvo que se move enquanto está sendo mirado faria
            a hora pousar 18px fora. Aqui só a opacidade anda — a caixa está no
            lugar final desde o primeiro quadro, que é o que o scripts/now.ts
            precisa medir.

            A hora é Playfair pelo mesmo motivo: ela e a hora gigante têm que
            ser o MESMO desenho, na mesma família, pra que o pouso seja uma
            sobreposição e não uma troca. */}
        <p class="now-stamp" data-now-stamp>
          <span class="now-stamp-time" data-now-time></span>
          <span class="now-stamp-rest">
            in {PLACE}<span class="now-stamp-dot" aria-hidden="true"> · </span
            ><span data-now-date></span>
          </span>
        </p>

        <div class="now-title is-arriving" style="--i:0">
          <p class="eyebrow">Now</p>
          <h1>Now, and next</h1>
          <p class="lead">{LEAD}</p>
        </div>
      </header>

      {/* ——— as duas abas ———
          A mesma fileira da /work, na mesma voz de versalete, e pelo mesmo
          motivo: é um CONTROLE, e um controle que grita compete com o título
          pela hierarquia. O que separa a ativa da outra é opacidade e a régua
          embaixo, não tamanho — trocar de aba não pode mudar a altura da linha.

          Aqui elas fazem uma coisa a mais do que fazem lá: são o TEMPO VERBAL
          da lista embaixo delas. "Now" é relato, "Next" é intenção, e ler as
          duas de seguida como uma lista só seria a página prometendo no mesmo
          tom em que ela conta. */}
      <div
        class:list={['now-tabs', 'is-arriving']}
        style={`--i:${TABS_STEP}`}
        role="tablist"
        aria-label="What is happening now, and what comes next"
        data-now-tabs
      >
        {PANELS.map((panel, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`now-tab-${panel.id}`}
            aria-controls={`now-panel-${panel.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {panel.label}
          </button>
        ))}
        {/* A régua acompanha a aba ativa. A medida vem do JS (offsetLeft e
            offsetWidth da aba) porque as duas têm larguras diferentes e o
            rótulo é conteúdo — deduzir a posição no CSS exigiria congelar a
            largura, que é a única coisa que não posso prometer sobre texto. */}
        <span class="tab-rule" aria-hidden="true"></span>
      </div>

      <div class="now-track" data-now-track>
        <div class="now-rail" data-now-rail>
          {PANELS.map((panel, index) => (
            <section
              class="now-panel"
              role="tabpanel"
              id={`now-panel-${panel.id}`}
              aria-labelledby={`now-tab-${panel.id}`}
              tabindex="0"
            >
              <div class="now-column">
                <p
                  class:list={['panel-note', index === 0 && 'is-arriving']}
                  style={index === 0 ? `--i:${NOTE_STEP}` : undefined}
                >
                  {panel.note}
                </p>

                {panel.id === 'now' ? (
                  <>
                    <ol class="strands">
                      {STRANDS.map((strand, row) => (
                        <li
                          class:list={['strand', step(index, row) !== null && 'is-arriving']}
                          style={`--row:${row + 1}${step(index, row) !== null ? `;--i:${step(index, row)}` : ''}`}
                        >
                          <p class="strand-label">{strand.label}</p>
                          <div class="strand-body">
                            <h2>
                              {strand.href
                                ? <a href={strand.href} target="_blank" rel="noopener noreferrer">{strand.title}</a>
                                : strand.title}
                            </h2>
                            {strand.since && <p class="strand-since">Since {month(strand.since)}</p>}
                            <p>{strand.body}</p>
                          </div>
                        </li>
                      ))}
                    </ol>

                    <ul class="asides">
                      {ASIDES.map((aside, row) => (
                        <li class="aside" style={`--row:${STRANDS.length + 1 + row}`}>
                          <span class="aside-label">{aside.label}</span>
                          <span class="aside-body">{aside.body}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : HORIZONS.length > 0 ? (
                  <ol class="strands">
                    {HORIZONS.map((horizon, row) => (
                      <li class="strand" style={`--row:${row + 1}`}>
                        <p class="strand-label">{horizon.label}</p>
                        <div class="strand-body">
                          <h2>
                            {horizon.href
                              ? <a href={horizon.href} target="_blank" rel="noopener noreferrer">{horizon.title}</a>
                              : horizon.title}
                          </h2>
                          {/* "By", e não "Since": é a única palavra que separa
                              esta lista da outra linha por linha, e ela é o que
                              impede uma data futura de ser lida como currículo
                              já cumprido. Horizonte sem data não ganha linha
                              nenhuma — ver o comentário do `when` em data/now.ts. */}
                          {horizon.when && <p class="strand-since">By {month(horizon.when)}</p>}
                          <p>{horizon.body}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                ) : null}
              </div>
            </section>
          ))}
        </div>
      </div>

      <footer class="now-foot">
        <p>{NOW_NOTE}</p>
        <p class="now-doors">
          <a href="/work">the record</a>
          <span aria-hidden="true"> · </span>
          <a href="/#about">the person</a>
        </p>
        <p class="now-updated">
          Last updated <time datetime={UPDATED}>{month(UPDATED)}</time>. The
          clock above it is live.
        </p>
      </footer>
    </div>
  </main>
</Layout>

{/* Preenche a hora e a data ANTES do primeiro pixel. Precisa ser aqui, no
    corpo e depois dos elementos, e não no <head>: um script do head roda
    enquanto o corpo ainda não existe, e o querySelector devolveria null.

    Sem isto, a chegada costurada nasceria com o carimbo vazio e a hora gigante
    em branco — o único quadro do site em que uma emenda apareceria. O
    scripts/now.ts assume daqui e passa a acertar o relógio na virada do
    minuto. */}
<script is:inline define:vars={{ tz: NOW_TZ }}>
  (function () {
    var at = new Date();
    var time = new Intl.DateTimeFormat('en-US', {
      timeZone: tz, hour: 'numeric', minute: '2-digit', hour12: true,
    }).format(at);
    var date = new Intl.DateTimeFormat('en-US', {
      timeZone: tz, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    }).format(at);

    document.querySelectorAll('[data-now-time], [data-now-entry-clock]')
      .forEach(function (el) { el.textContent = time; });
    var d = document.querySelector('[data-now-date]');
    if (d) d.textContent = date;
  })();
</script>

<script>
  import { initTheme } from '../scripts/theme';
  import { initNow } from '../scripts/now';
  import { initPanels } from '../scripts/panels';

  initTheme();
  initPanels({ tabs: '[data-now-tabs]', track: '[data-now-track]', rail: '[data-now-rail]' });
  initNow();
</script>

<style>
  .paper {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    transition: background-color var(--theme-fade);
  }

  /* A /now rola de cima a baixo, com script ou sem ele — e o global.css dá a
     html e body o `height: 100%` de que a HOME precisa (canvas fixo, quem rola
     lá é o Lenis) junto com o `overflow: hidden` do body. Aqui os dois voltam
     ao normal, pelo mesmo motivo e com a mesma forma da /work. Sem isto a
     página aparece inteira e nenhuma rolagem chega nela — visível e
     inalcançável, que é pior que um corte. */
  :global(html:has(.now-page)),
  :global(html:has(.now-page) body) {
    height: auto;
    overflow: visible;
  }

  /* A goteira reservada SEMPRE, e não só quando a barra existe. Travar a
     rolagem durante a cortina devolveria ~15px de largura à página, e a coluna
     inteira daria um pulo lateral bem no quadro em que a hora está pousando —
     que é o único quadro desta página que não pode se mexer. */
  :global(html:has(.now-page)) {
    scrollbar-gutter: stable;
  }

  /* ——— a chegada ———
     Enquanto a cortina está de pé a página não rola: o que está na tela é o
     quadro que a home entregou, e uma barra de rolagem nele seria a emenda
     aparecendo. `!important` porque a regra acima acabou de devolver a rolagem
     ao body e as duas convivem — vale enquanto a cortina existe, armada E
     abrindo. */
  :global(html[data-now-entry] body),
  :global(html[data-now-exit] body) {
    overflow: hidden !important;
  }

  .now-entry {
    position: fixed;
    inset: 0;
    width: var(--viewport-w);
    height: var(--viewport-h);
    z-index: 12;
    visibility: hidden;
    pointer-events: none;
  }

  /* A pintura. Tudo aqui tem que bater com o .now-seam do index.astro — é o
     mesmo retângulo, do outro lado da troca de documento. Os números vêm das
     mesmas variáveis (--now-aspect, --now-overscan, --now-rotation), postas no
     <html> pelo script do <head> a partir do NOW_SEAM. */
  .now-seam {
    --now-seam-w: calc(max(var(--viewport-w), var(--viewport-h) * var(--now-aspect)) * var(--now-overscan));
    --now-seam-h: calc(var(--now-seam-w) / var(--now-aspect));
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--now-seam-w);
    height: var(--now-seam-h);
    overflow: hidden;
    background: #2f3034;
    opacity: 0;
    /* a pose de CHEGADA já é a deriva: este é o último quadro da home, não o
       repouso de nada */
    transform: translate(-50%, calc(-50% + var(--now-drift)));
    transform-origin: center;
  }

  .now-seam img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--now-seam-h);
    height: var(--now-seam-w);
    display: block;
    max-width: none;
    max-height: none;
    object-fit: fill;
    transform: translate(-50%, -50%) rotate(var(--now-rotation));
  }

  /* A hora gigante. Mesma declaração do .now-clock do index.astro, e o tamanho
     vem do --now-clock-size do global.css — o único lugar onde ele existe,
     justamente pra não haver duas versões do mesmo número. */
  .now-clock {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 13;
    color: #23252b;
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 600;
    font-size: var(--now-clock-size);
    line-height: 0.82;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -50%);
    transform-origin: center;
    pointer-events: none;
  }

  /* ARMADA: o quadro que a home entregou, parado. Sem marca de entrada (link
     direto, reload, baixa animação) nada disto existe e a página é só a
     página. */
  :global(html[data-now-entry]) .now-entry {
    visibility: visible;
  }
  :global(html[data-now-entry]) .now-seam {
    opacity: 1;
  }
  :global(html[data-now-entry]) .now-clock {
    opacity: 1;
    visibility: visible;
  }

  /* ——— o céu que fica ———
     Fixo, atrás de tudo, sem animação nenhuma. A pintura sai e ele aparece.
     Em px de altura e não em vh: ele emoldura o CABEÇALHO, e num celular
     deitado 60vh cobriria a página inteira. */
  .now-sky {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: min(72vh, 640px);
    pointer-events: none;
    background:
      radial-gradient(120% 100% at 50% -12%,
        rgba(255, 246, 236, 0.9) 0%,
        rgba(232, 233, 238, 0.55) 42%,
        rgba(232, 233, 238, 0) 82%);
  }

  /* No escuro a mesma luz, muito mais fraca e um pouco mais fria: o papel aqui
     é quase preto, e a claridade do meio-dia por cima dele viraria um borrão
     leitoso em vez de céu. */
  :global(html[data-theme='dark']) .now-sky {
    background:
      radial-gradient(120% 100% at 50% -12%,
        rgba(150, 176, 196, 0.22) 0%,
        rgba(120, 138, 158, 0.12) 44%,
        rgba(120, 138, 158, 0) 82%);
  }

  /* ——— a página ———
     A coluna de leitura virou variável, como na /work, porque agora duas coisas
     precisam dela: o miolo, que vive dentro dela, e o trilho dos painéis, que
     SANGRA pra fora e depois devolve o texto a ela. Com a medida em dois
     lugares, o dia em que a coluna mudar é o dia em que o painel que sai passa a
     evaporar no lugar errado. O gutter saiu do padding da página e entrou na
     conta da coluna pelo mesmo motivo — o sangramento mede a partir dela. */
  .now-page {
    --column: min(100% - 4rem, 46rem);
    position: relative;
    z-index: 1;
    min-height: 100dvh;
    padding: clamp(5.5rem, 12vh, 9rem) 0 clamp(4rem, 10vh, 7rem);
    color: var(--ink);
    transition: color var(--theme-fade);
  }

  .now-inner {
    width: var(--column);
    margin-inline: auto;
  }

  .now-stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.6rem;
    margin-bottom: clamp(2rem, 5vh, 3.2rem);
  }

  /* ——— o alvo do pouso ———
     Cada linha abaixo é a MESMA do .now-clock, e isso não é coincidência de
     estilo: é o que torna o pouso possível.

     O clockWarp mapeia uma caixa na outra com uma escala UNIFORME, e ele só
     pode ser uniforme se os dois textos forem o mesmo desenho em tamanhos
     diferentes. Mesma família, mesmo peso, mesmo tracking, mesma entrelinha,
     mesma string. Bastava o letter-spacing divergir (estava -0.03em contra
     -0.045em) pra hora gigante chegar com a largura certa e as letras no lugar
     errado — e a entrelinha divergir (1 contra 0.82) pra ela pousar uns pixels
     acima do carimbo, porque o warp alinha os CENTROS das caixas e uma caixa
     mais alta tem outro centro.

     Só o font-size muda. É ele que a escala resolve. */
  .now-stamp-time {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.045em;
    /* dígitos de mesma largura: a virada do minuto não pode empurrar o resto da
       linha — e, mais importante, não pode mudar a caixa em que a hora gigante
       acabou de pousar */
    font-variant-numeric: tabular-nums;
  }

  .now-stamp-rest {
    color: rgba(var(--ink-rgb), 0.55);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    transition: color var(--theme-fade);
  }

  .eyebrow {
    margin-bottom: 0.7rem;
    color: rgba(var(--ink-rgb), 0.5);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  .now-head h1 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.2rem, min(6.5vw, 7vh), 4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .lead {
    max-width: 34rem;
    margin-top: 1.1rem;
    color: rgba(var(--ink-rgb), 0.72);
    font-size: 1rem;
    line-height: 1.62;
    transition: color var(--theme-fade);
  }

  /* ——— as abas ———
     O mesmo desenho das abas da /work, e isso é o ponto: é o mesmo controle,
     então tem que ser o mesmo controle. Duas fileiras de abas desenhadas
     diferente no mesmo site seriam dois vocabulários pra uma ideia só — a mesma
     disciplina que já vale pro "‹ Back" nesta página.

     O que difere é UM número, o espaço debaixo da fileira, e ele difere porque
     aqui há uma nota logo abaixo (ver o .now-tabs) — lá embaixo da fileira
     começa uma lista, que não briga com o fio pela vizinhança. Se a /work
     ganhar uma nota um dia, o número volta a ser o mesmo nas duas. */
  .now-tabs {
    position: relative;
    display: flex;
    gap: clamp(1.1rem, 3vw, 2rem);
    align-items: center;
    margin-top: clamp(2.4rem, 6vh, 3.6rem);
    /* O espaço embaixo saiu do PADDING e virou MARGEM, e a diferença é a régua:
       ela mora no `bottom: 0` desta caixa, então todo padding de baixo é
       distância entre o rótulo e o fio dele. Com os 21px que havia aqui, o fio
       ficava a um respiro da nota em itálico e a três da palavra "NOW" — e um
       fio lê como pertencendo ao que está mais perto. Ele volta pra debaixo da
       aba; o ar que a lista precisa vira margem, que a régua não enxerga. */
    margin-bottom: clamp(1.5rem, 3.6vh, 2.2rem);
    padding: clamp(0.65rem, 2.1vh, 1.4rem) 0 0.5rem;
  }

  .tab {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.2rem 0;
    border: 0;
    background: transparent;
    color: rgba(var(--ink-rgb), 0.42);
    font: inherit;
    font-size: clamp(0.62rem, 1.5vw, 0.68rem);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .tab:hover {
    color: rgba(var(--ink-rgb), 0.7);
  }

  .tab[aria-selected='true'] {
    color: var(--ink);
    cursor: default;
  }

  /* O único fio horizontal da página. Ele não decora: é a resposta à pergunta
     "qual das duas estou lendo" — que aqui é a pergunta "em que tempo verbal
     estou". As bordas dos fios correm no outro eixo e dizem outra coisa
     ("isto é uma lista"), então os dois não competem. */
  .tab-rule {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: var(--rule-width, 0);
    transform: translateX(var(--rule-x, 0));
    background: var(--ink);
    transition:
      transform 480ms cubic-bezier(0.2, 0.86, 0.24, 1),
      width 480ms cubic-bezier(0.2, 0.86, 0.24, 1),
      background-color var(--theme-fade);
  }

  /* Antes da primeira medida a régua não tem onde estar, e nascer com largura
     zero no canto esquerdo faria ela DESLIZAR do nada até a primeira aba no
     carregamento. Fica escondida até o JS medir. */
  .now-tabs:not([data-ready]) .tab-rule {
    opacity: 0;
  }

  /* ——— o trilho ———
     A janela recorta; quem anda é o rail. O rail tem a largura da janela e os
     painéis TRANSBORDAM dele (flex: 0 0 100% de 100%), e é isso que faz
     translateX(-100%) valer exatamente um painel — se o rail medisse a soma dos
     painéis, cada -100% pularia os dois de uma vez.

     E ele SANGRA pra fora da coluna, até a tela inteira: recortado nas 46rem da
     coluna, o painel que sai evaporaria a meia tela da borda do monitor, com
     página em branco depois dele — a troca leria como um cartão desaparecendo
     no meio da tela, não como uma tela dando lugar à outra. A conta devolve
     exatamente a largura que a coluna tirou, dos dois lados. */
  .now-track {
    min-height: 0;
  }

  :global(html[data-now-panels]) .now-track {
    overflow: hidden;
    margin-inline: calc(50% - 50vw);
  }

  .now-rail {
    display: flex;
    width: 100%;
  }

  /* A altura do rail é a do painel ATIVO, medida pelo panels.ts. Sem isto, os
     dois ficam lado a lado numa fileira flex e a fileira fica com a altura do
     MAIOR: o "Now" carrega os fios E as coisas leves, então o "Next" herdaria
     algumas centenas de pixels de branco no fim da página — rolagem que não
     leva a lugar nenhum. `align-items: start` é o que impede o painel curto de
     ser esticado até lá.

     A altura entra na mesma transição do deslize, e com a mesma curva: os dois
     acontecem no mesmo gesto, e uma página que muda de tamanho num degrau
     enquanto o conteúdo desliza lê como dois eventos em vez de um. */
  :global(html[data-now-panels]) .now-rail {
    align-items: start;
    height: var(--rail-height, auto);
    transform: translate3d(calc(var(--panel, 0) * -100% + var(--drag, 0px)), 0, 0);
    transition:
      transform var(--slide-dur, 620ms) cubic-bezier(0.5, 0, 0.15, 1),
      height var(--slide-dur, 620ms) cubic-bezier(0.5, 0, 0.15, 1);
  }

  /* Enquanto o dedo está na tela o rail SEGUE o dedo: uma transição aqui
     colocaria um atraso entre o toque e o desenho, que é a diferença entre
     arrastar uma coisa e pedir pra ela ir. */
  :global(html[data-now-panels]) .now-rail.is-dragging {
    transition: none;
  }

  /* O portão de movimento do site (motion.ts), que é escolha do usuário e não
     preferência do sistema — o @media lá embaixo não a enxerga. Quem carimba é
     o panels.ts, com o mesmo booleano que já decide não animar as linhas. */
  :global(html[data-now-panels]) .now-rail[data-still] {
    transition: none;
  }

  .now-panel {
    min-width: 0;
  }

  :global(html[data-now-panels]) .now-panel {
    flex: 0 0 100%;
    /* o gesto vertical rola a página; o horizontal continua sendo nosso */
    touch-action: pan-y;
  }

  :global(html[data-now-panels]) .now-panel:focus-visible {
    outline: 2px solid rgba(var(--ink-rgb), 0.4);
    outline-offset: -2px;
  }

  /* O trilho sangra pra tela inteira; quem devolve o texto à coluna de leitura
     é esta caixa, aqui dentro. */
  :global(html[data-now-panels]) .now-column {
    width: var(--column);
    margin-inline: auto;
  }

  /* Sem script os dois painéis ficam empilhados, um depois do outro, e a página
     rola como qualquer outra. */
  :global(html:not([data-now-panels])) .now-rail {
    display: block;
  }

  :global(html:not([data-now-panels])) .now-panel + .now-panel {
    margin-top: clamp(2.4rem, 6vh, 3.6rem);
  }

  /* A linha que enquadra a lista. No "Next" ela é o aviso legal da metade
     inteira, e por isso não é opcional: sem ela, cinco coisas boas escritas no
     futuro leem como currículo antecipado. Playfair itálico, o mesmo aparte
     serifado do .badge da /work e do verso no Songs — trocar de tipo já diz
     "isto não é o corpo do texto", e diz sem acrescentar linha nenhuma. */
  .panel-note {
    max-width: 32rem;
    color: rgba(var(--ink-rgb), 0.55);
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    font-size: clamp(0.9rem, 1.9vw, 0.98rem);
    line-height: 1.5;
    transition: color var(--theme-fade);
  }

  /* ——— os fios ———
     Duas colunas: o verbo à esquerda, sempre na mesma coluna, e o corpo à
     direita. A coluna do verbo é o que faz a página se ler como uma lista de
     coisas ACONTECENDO — os rótulos ficam alinhados um embaixo do outro e dá
     pra varrer só eles. A mesma forma serve às duas abas de propósito: o que
     muda de uma pra outra é o tempo verbal, não o desenho, e desenhar o futuro
     diferente sugeriria que ele é outro tipo de coisa. */
  .strands {
    margin-top: clamp(1.4rem, 3.5vh, 2.2rem);
    list-style: none;
  }

  .strand {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    padding: 1.7rem 0;
    border-top: 1px solid rgba(var(--ink-rgb), 0.1);
    transition: border-color var(--theme-fade);
  }

  .strand-label {
    color: rgba(var(--ink-rgb), 0.42);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* alinha com a primeira linha do título, e não com o topo da caixa */
    padding-top: 0.34rem;
    transition: color var(--theme-fade);
  }

  .strand-body h2 {
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .strand-body h2 a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(var(--ink-rgb), 0.28);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.3s ease, color var(--theme-fade);
  }

  .strand-body h2 a:hover {
    text-decoration-color: rgba(var(--ink-rgb), 0.8);
  }

  .strand-since {
    margin-top: 0.24rem;
    color: rgba(var(--ink-rgb), 0.45);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    transition: color var(--theme-fade);
  }

  .strand-body p:last-child {
    margin-top: 0.7rem;
    color: rgba(var(--ink-rgb), 0.74);
    font-size: 0.92rem;
    line-height: 1.62;
    transition: color var(--theme-fade);
  }

  /* ——— as coisas leves ———
     Uma linha cada, e sem borda: elas não são fios abertos, são o rodapé da
     pessoa. Empilhar com o mesmo peso dos de cima daria a uma bonsai a mesma
     importância de um emprego. */
  .asides {
    margin-top: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(var(--ink-rgb), 0.1);
    list-style: none;
    transition: border-color var(--theme-fade);
  }

  .aside {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    padding: 0.42rem 0;
    color: rgba(var(--ink-rgb), 0.6);
    font-size: 0.86rem;
    line-height: 1.55;
    transition: color var(--theme-fade);
  }

  .aside-label {
    color: rgba(var(--ink-rgb), 0.42);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-top: 0.2rem;
    transition: color var(--theme-fade);
  }

  /* ——— a troca de painel ———
     O rail desliza inteiro, mas um retângulo rígido voando pro lado lê como
     cartão sendo empurrado, não como página trocando. Então as linhas do painel
     que ENTRA assentam um pouco atrás do rail, escalonadas, e vindo do lado de
     onde o painel veio: --dir é +1 quando ele entra pela direita e -1 pela
     esquerda.

     É ATRASO, não aparição: nada aqui mexe em opacidade. Uma linha que nasce
     transparente no meio da tela surge do nada, que é o contrário de entrar
     pela borda — o painel inteiro atravessa opaco, e o escalonamento só faz as
     linhas arrastarem um pouco atrás dele.

     O teto do escalonamento (o min) existe porque ele mede posição na lista, e
     numa lista longa o atraso da última linha passaria da duração do próprio
     deslize — a linha assentaria depois de o painel já ter chegado. */
  @keyframes row-settle {
    from {
      transform: translate3d(calc(var(--dir, 1) * 24px), 0, 0);
    }
  }

  .now-panel.is-entering .panel-note,
  .now-panel.is-entering .strand,
  .now-panel.is-entering .aside {
    animation: row-settle 460ms cubic-bezier(0.2, 0.86, 0.24, 1) backwards;
    animation-delay: calc(min(var(--row, 0), 7) * 30ms + 40ms);
  }

  .now-foot {
    margin-top: clamp(3rem, 8vh, 5rem);
    color: rgba(var(--ink-rgb), 0.6);
    font-size: 0.88rem;
    line-height: 1.6;
    transition: color var(--theme-fade);
  }

  .now-doors {
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }

  .now-doors a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--theme-fade);
  }

  .now-updated {
    margin-top: 1.6rem;
    color: rgba(var(--ink-rgb), 0.42);
    font-size: 0.76rem;
    transition: color var(--theme-fade);
  }

  .back {
    position: fixed;
    top: calc(1.5rem + env(safe-area-inset-top));
    left: 2rem;
    z-index: 6;
    padding: 0.35rem 0;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--theme-fade);
  }

  /* O mesmo fio da /work, e não um `text-decoration` no :hover: o sublinhado
     do texto nasce e morre de um quadro pro outro, e num canto onde nada mais
     se mexe isso lê como se o botão não tivesse respondido ao mouse. O fio
     CRESCE, e cresce da esquerda — a direção pra onde o link leva. */
  .back::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .back:hover::after,
  .back:focus-visible::after {
    transform: scaleX(1);
  }

  /* ——— o botão de tema ———
     O mesmo botão da /work — mesmo tamanho, mesma quina da direita —, mas na
     beira de BAIXO. O topo desta página é por onde a hora gigante desce e
     pousa; é o único quadro que não pode ter um controle piscando na quina
     disputando o olho com ela. Descendo, ele sai da rota do pouso e ainda fica
     onde o polegar já está no telefone.

     `env(safe-area-inset-bottom)` no lugar do -top pelo mesmo motivo de lá: o
     iPhone tem a barra de gestos embaixo, e um botão colado nela é um botão que
     o sistema intercepta antes da página. */
  .theme {
    position: fixed;
    bottom: calc(1.3rem + env(safe-area-inset-bottom));
    right: 1.5rem;
    z-index: 6;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(var(--ink-rgb), 0.12);
    border-radius: 999px;
    background: rgba(90, 90, 90, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, color var(--theme-fade), border-color var(--theme-fade);
  }

  .theme:hover {
    background: rgba(90, 90, 90, 0.42);
  }

  /* absolutos e sobrepostos: os dois ícones ocupam a MESMA célula, e a troca é
     um cruzamento de opacidade com giro. Em fluxo eles empilhariam e o botão
     teria 40px de altura de ícone dentro de 44px de botão. */
  .theme svg {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: opacity var(--theme-fade), transform var(--theme-fade);
  }

  .theme .icon-sun {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-moon {
    opacity: 0;
    transform: rotate(90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-sun {
    opacity: 1;
    transform: none;
  }

  /* ——— o conteúdo CHEGA, não estava esperando ———
     Mesma regra da /work, e pelo mesmo motivo: a lista já montada por baixo da
     cortina faria o movimento morrer na borda dela. O carimbo é a exceção
     explicada no markup — ele só acende, nunca desliza, porque é o alvo de um
     pouso medido. */
  :global(html[data-now-entry]) .is-arriving {
    opacity: 0;
    transform: translateY(18px);
  }

  :global(html[data-now-entry]) .now-stamp {
    opacity: 0;
  }

  /* A pintura agora desce, então a página é DESCOBERTA de cima pra baixo — a
     mesma direção em que o escalonamento já corria. Os dois se somam: cada
     bloco já está no lugar quando a beirada passa por ele, e o que se vê é uma
     página pronta sendo revelada, não uma página se montando. */
  :global(html[data-now-entry='opening']) .is-arriving {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.75s ease calc(0.24s + var(--i, 0) * 0.08s),
      transform 0.85s cubic-bezier(0.2, 0.86, 0.24, 1) calc(0.24s + var(--i, 0) * 0.08s);
  }

  /* O carimbo NÃO acende junto com o resto, e por isso não há regra de
     'opening' pra ele aqui: quem o acende é o scripts/now.ts, no instante exato
     em que a hora gigante para em cima dele.

     O estado armado (opacity: 0, logo acima) continua sendo CSS porque precisa
     valer antes do primeiro pixel. O acender virou JS porque precisa saber
     QUANDO a hora pousa, e esse número mora lá. Enquanto os dois estavam
     separados, o carimbo aparecia no meio do voo — dava pra ler o horário antes
     de a animação chegar nele. */

  /* ——— ABERTA ———
     A pintura FORA DE QUADRO, e fora de quadro de verdade: ela sai inteira pela
     borda de baixo, sem apagar em lugar nenhum.

     Antes ela derivava 22vh e quem fazia o sumiço era a opacidade — e era isso
     que se via como a foto esbranquiçando. Não havia véu nenhum sobrando: uma
     fotografia apagando sobre papel branco É uma fotografia esbranquiçando. A
     única forma de tirar aquilo era ela parar de apagar, e pra parar de apagar
     ela precisa ter pra onde ir.

     A conta do destino sai da própria caixa, e não de um número chutado por
     tela: `50dvh` leva o centro dela até a borda de baixo do viewport e
     `--now-seam-h / 2` leva a beirada de cima junto. Os 3dvh são folga contra
     arredondamento subpixel — sem eles sobra uma tira de um pixel em algumas
     densidades de tela. Serve pra qualquer proporção de janela, inclusive as
     bem largas, onde a caixa passa de 120vh de altura.

     O MESMO estado serve pro fim da chegada e pro começo da saída, e escrevê-lo
     uma vez só é o ponto: duas descrições de "aberta" seriam duas chances de as
     duas pontas divergirem no próximo ajuste — e a saída tem que partir
     exatamente de onde a chegada parou. (Mesma disciplina da cortina da /work.) */
  :global(html[data-now-entry='opening']) .now-seam,
  :global(html[data-now-exit='armed']) .now-seam {
    opacity: 1;
    transform: translate(-50%, calc(-50% + 50dvh + var(--now-seam-h) / 2 + 3dvh));
  }

  /* Só quem ABRE ou FECHA transiciona. `[data-now-exit='armed']` sozinho é uma
     pose, não um movimento: é ela que dá à pintura um ponto de partida real
     antes de 'closing' entrar.

     A curva ACELERA (ease-in), ao contrário de quase tudo neste site. É o certo
     pra quem vai embora: o teto começa a ceder devagar, ganha velocidade e sai.
     Uma curva que frease no fim deixaria a beirada da foto rastejando pela
     borda de baixo da tela nos últimos quadros, que é onde ela mais aparece. */
  :global(html[data-now-entry='opening']) .now-seam {
    transition: transform 1.55s cubic-bezier(0.5, 0, 0.9, 0.45);
  }

  /* ——— a saída pelo "‹ Back" ———
     A mesma cortina, ao contrário. A hora é levada pelo scripts/now.ts (que
     mede o carimbo na hora); aqui vem a pintura descendo de volta ao quadro que
     a home sabe receber, e o conteúdo apagando.

     A curva é outra, e não por gosto: quem fecha tem que ENCOSTAR, não
     assentar — o último quadro daqui é o primeiro de lá. */
  :global(html[data-now-exit]) .now-entry,
  :global(html[data-now-exit]) .now-clock {
    visibility: visible;
  }

  :global(html[data-now-exit='closing']) .now-seam {
    opacity: 1;
    transform: translate(-50%, calc(-50% + var(--now-drift)));
    transition: transform 1.05s cubic-bezier(0.24, 0.6, 0.2, 1);
  }

  :global(html[data-now-exit='closing']) .is-arriving,
  :global(html[data-now-exit='closing']) .now-stamp {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  @media (max-width: 46rem) {
    /* O gutter mora na coluna, e não no padding da página: quem sangra pra
       fora dela precisa saber exatamente quanto ela tirou. */
    .now-page {
      --column: min(100% - 2.8rem, 46rem);
    }

    .back {
      left: 1.4rem;
    }

    .now-tabs {
      gap: 0.9rem;
    }

    .tab {
      letter-spacing: 0.1em;
    }

    .theme {
      right: 1rem;
      width: 40px;
      height: 40px;
    }

    /* Uma coluna: 7.5rem de rótulo mais o texto não cabem num telefone sem
       espremer o corpo a quatro palavras por linha. O verbo vira uma linha
       própria acima do título, que é como ele já se lê. */
    .strand,
    .aside {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
    }

    .strand-label,
    .aside-label {
      padding-top: 0;
    }

    /* só o tamanho muda no celular — o resto continua tendo que ser o mesmo
       desenho da hora gigante (ver a regra acima) */
    .now-stamp-time {
      font-size: 1.3rem;
    }
  }

  /* Baixa animação: nada chega, nada sai. A cortina nunca é armada (o
     scripts/now.ts checa antes), mas o estado de repouso precisa valer mesmo se
     a marca tiver ficado no <html> por qualquer motivo. */
  :global(html[data-motion='reduced']) .is-arriving,
  :global(html[data-motion='reduced']) .now-stamp {
