  }
  .impact li:last-child {
    margin-bottom: 0;
  }

  /* ——— chips: TEXTO, e nada além disso ———
     Mesma micro-tipografia do .slot-note do About. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.2rem;
    list-style: none;
  }
  .chips li {
    padding: 0.28rem 0.6rem;
    border: 1px solid rgba(var(--ink-rgb), 0.16);
    border-radius: 999px;
    background: rgba(var(--ink-rgb), 0.02);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(var(--ink-rgb), 0.6);
    transition: color var(--theme-fade), border-color var(--theme-fade),
      background-color var(--theme-fade);
  }

  /* ——— o bloco condensado ———
     Um nó só, e por dentro as pistas seguem linha a linha: é aqui que duas das
     quatro coisas simultâneas de mar–jun 2025 moram, e uma calha de bloco
     inteiro apagaria justamente o encontro. */
  .entry.cluster {
    grid-template-columns: var(--year-w) var(--spine-w) minmax(0, 1fr);
  }
  .cluster-body {
    grid-column: 3;
  }
  /* o rótulo e a calha que atravessa a altura dele, lado a lado */
  .cluster-head {
    display: grid;
    grid-template-columns: var(--lanes-w) minmax(0, 1fr);
    align-items: stretch;
  }
  .cluster-head .lanes {
    grid-column: 1;
  }
  .cluster-label {
    grid-column: 2;
    padding-left: var(--card-pad);
    font-family: "Inter", sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--ink-rgb), 0.6);
    transition: color var(--theme-fade);
  }
  /* o respiro abaixo do rótulo é do RÓTULO, não da lista: posto na lista ele
     ficaria fora das duas faixas e abriria de novo um vão na pista */
  .cluster-label {
    margin-bottom: 0.5rem;
  }
  .cluster-rows {
    list-style: none;
  }
  .cluster-row {
    /* --node-y aqui é o meio da linha de texto, não do título do bloco: é onde
       as pistas desta linha começam e terminam */
    --node-y: 0.72rem;
    display: grid;
    grid-template-columns: var(--lanes-w) minmax(0, 1fr);
    align-items: stretch;
  }
  .cluster-row .lanes {
    grid-column: 1;
  }
  /* mesmo motivo do .card lá em cima: o respiro precisa estar DENTRO da faixa
     da grade, senão a pista não atravessa o intervalo entre as linhas */
  .cluster-row:not(:last-child) .cluster-text {
    margin-bottom: 0.7rem;
  }
  .cluster-text {
    grid-column: 2;
    padding-left: var(--card-pad);
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(var(--ink-rgb), 0.6);
    transition: color var(--theme-fade);
  }
  .cluster-title {
    color: rgba(var(--ink-rgb), 0.75);
    transition: color var(--theme-fade);
  }
  .cluster-row .org {
    font-weight: 400;
    color: rgba(var(--ink-rgb), 0.6);
  }

  /* ——— a saída pro /craft ——— */
  .craft-note {
    margin-top: 5rem;
    padding-left: calc(var(--year-w) + var(--spine-w) + var(--lanes-w) + var(--card-pad));
    font-size: 0.9rem;
    color: rgba(var(--ink-rgb), 0.6);
    transition: color var(--theme-fade);
  }
  .craft-note a {
    color: rgba(var(--ink-rgb), 0.75);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.3);
    transition: border-color 160ms ease, color var(--theme-fade);
  }
  .craft-note a:hover,
  .craft-note a:focus-visible {
    border-bottom-color: currentColor;
  }

  /* ——— foco: a mesma linha visível do resto do site ——— */
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ——— a revelação ———
     O sinalizador vive no <html> com nome PRÓPRIO (data-work-reveal), separado
     do [data-reveal] que marca cada pedaço a revelar: fossem o mesmo nome, um
     querySelectorAll('[data-reveal]') solto acharia o <html> junto com os
     cards e tentaria animar a raiz do documento.
     Ele é posto pelo script inline do <head>, e SÓ quando há movimento:
     sem JS, com JS quebrado ou em baixa animação, nada aqui existe e a página
     nasce no estado final. Só opacity — a altura é a mesma nos dois casos. */
  :global(html[data-work-reveal='armed']) [data-reveal] {
    opacity: 0;
  }

  /* ——— telas estreitas ———
     A linha vira um trilho à esquerda e a calha aperta, mas nenhum card perde
     conteúdo: peso 1 continua com parágrafo, tópicos e chips. */
  @media (max-width: 46rem) {
    .work {
      --year-w: 2.4rem;
      --spine-w: 1.4rem;
      --lane-col: 0.4rem;
      --node: 8px;
      --card-pad: 1rem;
    }
    .work-inner {
      padding: 5rem 1rem 5rem;
    }
    .card,
    .cluster-text {
      padding-left: var(--card-pad);
    }
    .cluster-label {
      padding-left: calc(var(--lanes-w) + var(--card-pad));
    }
    .craft-note {
      padding-left: calc(var(--year-w) + var(--spine-w) + var(--lanes-w) + var(--card-pad));
    }
    .back {
      left: 1rem;
    }
    .theme {
      right: 1rem;
      width: 40px;
      height: 40px;
    }
    .year {
      padding-right: 0.5rem;
      font-size: 0.62rem;
      letter-spacing: 0.06em;
    }
  }

  /* 320px. A moldura à esquerda (ano + nó + calha) é fixa, então cada décimo
     que ela ocupa sai direto da medida do texto — aqui ela é espremida até o
     mínimo legível pra sobrarem ~200px de coluna de leitura. A calha continua
     com as quatro pistas: é justamente na tela mais estreita que a informação
     "isto tudo ao mesmo tempo" tem menos chance de aparecer sozinha. */
  @media (max-width: 22.5rem) {
    .work {
      --year-w: 2rem;
      --spine-w: 1.2rem;
      --lane-col: 0.35rem;
      --lane-line: 2px;
      --card-pad: 0.75rem;
    }
    .card,
