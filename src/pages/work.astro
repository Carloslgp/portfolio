  }
  a.org:hover,
  a.org:focus-visible {
    border-bottom-color: currentColor;
  }

  /* o reconhecimento dito por extenso — o losango na linha diz que existe, e
     isto diz o quê */
  .badge {
    display: inline-block;
    margin-top: 0.7rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(var(--ink-rgb), 0.22);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(var(--ink-rgb), 0.6);
    transition: color var(--theme-fade), border-color var(--theme-fade);
  }

  .summary {
    margin-top: 0.9rem;
    line-height: 1.75;
    color: rgba(var(--ink-rgb), 0.78);
    transition: color var(--theme-fade);
  }
  .w2 .summary {
    font-size: 0.95rem;
  }

  .impact {
    margin-top: 1.1rem;
    padding-left: 1.1rem;
    list-style: none;
  }
  .impact li {
    position: relative;
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
