---
import Layout from '../layouts/Layout.astro';
import { ENTRIES, groups, range, type Entry } from '../data/work';
import { WORK_SEAM } from '../scripts/workNavigation';

/** A cor do selo é presa ao id, e não à posição na lista.
 *
 *  A lista e os diálogos percorrem coleções DIFERENTES — os diálogos pulam
 *  quem não tem detalhe —, e a página agora quebra a lista em dois grupos.
 *  Ler a posição em cada percurso dava à mesma entrada uma cor no card e
 *  outra no diálogo assim que os dois deixassem de andar juntos. A ordem de
 *  ENTRIES é a única que nenhum recorte da página mexe. */
const HUE = new Map(ENTRIES.map((e, i) => [e.id, (i * 47 + 258) % 360]));

const entryType: Record<Entry['kind'], string> = {
  role: 'Experience',
  build: 'Project',
  recognition: 'Recognition',
};

function monogram(entry: Entry) {
  const source = entry.org ?? entry.title;
  const words = source.match(/[A-Za-zÀ-ÿ0-9]+/g) ?? [];
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
}

function preview(entry: Entry) {
  if (!entry.summary) return entryType[entry.kind];
  return entry.summary.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim() ?? entry.summary;
}

/** Quantas linhas do painel de abertura entram escalonadas com a cortina.
 *
 *  Agora que cada painel cabe na tela, "as que cabem" é praticamente o painel
 *  inteiro. O teto continua existindo pelo motivo de sempre — animar o que
 *  está fora da dobra é pôr o navegador pra compor camada que ninguém vê, e os
 *  últimos atrasos caem já no fim da abertura, que é onde apareciam os quadros
 *  longos no celular. Ele volta a morder no dia em que um grupo crescer além
 *  da tela e o painel passar a rolar por dentro. */
const REVEAL_ROWS = 6;

/** A página em passos de animação.
 *
 *  Só o painel que a página abre mostrando entra escalonado: o outro nasce
 *  fora da tela, e animar quem ninguém vê é composição pura. O passo 1 é a
 *  fileira de abas — ela ocupa altura entre o cabeçalho e a lista, então
 *  precisa ocupar tempo, senão a primeira linha entra antes do controle que a
 *  comanda. */
const TABS_STEP = 1;

const sections = groups().map((group, panel) => ({
  ...group,
  panel,
  rows: group.entries.map((entry, row) => ({
    entry,
    row,
    step: panel === 0 && row < REVEAL_ROWS ? TABS_STEP + 1 + row : null,
  })),
}));

function hasDetails(entry: Entry) {
  return Boolean(entry.summary || entry.impact?.length || entry.stack?.length || entry.badge || entry.href);
}

/** As entradas que têm um <dialog>, na mesma ordem em que a página as lista. */
const detailed = sections.flatMap((section) => section.entries).filter(hasDetails);
---

<Layout lang="en">
  <Fragment slot="head">
    <title>Experience — Carlos Leonardo</title>
    <meta
      name="description"
      content="Carlos Leonardo's professional experience, projects and recognition."
    />
    <link rel="prefetch" href="/" />

    {/* A home termina coberta pela pintura do segmento Work. Esta marca nasce
        antes do primeiro paint para a página começar no mesmo quadro e só
        então abrir as duas folhas sobre o conteúdo.

        As três medidas da emenda descem junto, e pelo mesmo motivo do outro
        lado da troca (ver index.astro): elas são o contrato entre os dois
        documentos, e um número que só valesse aqui já seria uma emenda
        visível. */}
    <script
      is:inline
      define:vars={{
        seamAspect: WORK_SEAM.aspect,
        seamOverscan: WORK_SEAM.overscan,
        seamRotation: WORK_SEAM.rotation,
      }}
    >
      document.documentElement.style.setProperty('--seam-aspect', seamAspect);
      document.documentElement.style.setProperty('--seam-overscan', seamOverscan);
      document.documentElement.style.setProperty('--seam-rotation', seamRotation + 'deg');
      /* A marca que liga o modo painel: a página vira duas telas que deslizam,
         em vez de uma lista que rola. Ela nasce AQUI, antes do primeiro paint,
         e não no bundle — pôr a página em tela cheia depois do primeiro quadro
         é um salto de layout visível pra quem entra por link direto (quem vem
         pela home não veria, porque a cortina cobre).

         E ela nasce do JS de propósito, e não do HTML: sem script as abas não
         trocam nada, e uma página presa em 100dvh mostrando só metade das
         entradas seria conteúdo perdido. Sem a marca o CSS devolve as duas
         listas empilhadas e a rolagem normal. */
      document.documentElement.dataset.workPanels = '';
      try {
        if (sessionStorage.getItem('portfolio:work-entry')) {
          sessionStorage.removeItem('portfolio:work-entry');
          document.documentElement.dataset.workEntry = 'armed';
        }
      } catch (e) {}
    </script>
  </Fragment>

  <div class="paper" aria-hidden="true"></div>

  <div class="work-transition" data-work-transition aria-hidden="true">
    <div class="work-transition-panel is-left">
      <div class="work-seam"><img src="/textures/work.jpg" alt="" /></div>
    </div>
    <div class="work-transition-panel is-right">
      <div class="work-seam"><img src="/textures/work.jpg" alt="" /></div>
    </div>
    <span class="work-transition-title">
      <small>Selected</small>
      <strong>WORK</strong>
    </span>
  </div>

  <a class="back" href="/" data-work-back>‹ Back</a>

  <button
    class="theme"
    data-theme-toggle
    aria-pressed="false"
    aria-label="Toggle dark theme"
    title="Light / dark theme"
  >
    <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>

  <main class="work-page">
    <div class="work-inner">
      <header class="work-head">
        <p class="eyebrow">Work</p>
        <h1>Experience</h1>
        <p class="lead">A concise view of the roles, projects and communities I’ve helped build.</p>
      </header>

      <div
        class:list={['work-tabs', 'is-arriving']}
        style={`--i:${TABS_STEP}`}
        role="tablist"
        aria-label="Sections of this page"
        data-work-tabs
      >
        {sections.map((section) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`work-tab-${section.id}`}
            aria-controls={`work-panel-${section.id}`}
            aria-selected={section.panel === 0 ? 'true' : 'false'}
            tabindex={section.panel === 0 ? 0 : -1}
            data-panel={section.panel}
          >
            {section.label}
          </button>
        ))}
        {/* A régua acompanha a aba ativa. A medida vem do JS (offsetLeft e
            offsetWidth da aba) porque as duas têm larguras diferentes e o
            rótulo é conteúdo — deduzir a posição no CSS exigiria congelar a
            largura, que é a única coisa que não posso prometer sobre texto. */}
        <span class="tab-rule" aria-hidden="true"></span>
      </div>

      <div class="work-track" data-work-track>
        <div class="work-rail" data-work-rail>
          {sections.map((section) => (
            <section
              class="work-panel"
              role="tabpanel"
              id={`work-panel-${section.id}`}
              aria-labelledby={`work-tab-${section.id}`}
              data-panel={section.panel}
              tabindex="0"
            >
              <ol class="experience-list">
                {section.rows.map(({ entry, row, step }) => {
                  const dates = range(entry);
                  const dialogId = `work-details-${entry.id}`;
                  const details = hasDetails(entry);

                  return (
                    <li
                      class:list={['experience-item', step !== null && 'is-arriving']}
                      style={`--row:${row}${step !== null ? `;--i:${step}` : ''}`}
                    >
                      <div
                        class:list={['experience-mark', entry.logo && 'has-image']}
                        style={`--mark-hue:${HUE.get(entry.id)}`}
                        aria-hidden="true"
                      >
                        {entry.logo ? (
                          <img
                            src={entry.logo}
                            alt=""
                            loading={section.panel === 0 ? 'eager' : 'lazy'}
                            decoding="async"
                          />
                        ) : monogram(entry)}
                      </div>

                      <article class="experience-main">
                        <h2>{entry.title}</h2>
                        <p class="meta">
                          <span class="company">{entry.org ?? entryType[entry.kind]}</span>
                          {/* o ponto vive DENTRO do período, que é nowrap: solto
                              entre os dois, ele ficava órfão no fim da linha
                              quando a data quebrava pra baixo */}
                          <span class="period">
                            <span class="dot" aria-hidden="true">·</span>
                            <time datetime={dates.from.dt}>{dates.from.label}</time>
                            {dates.to && <><span aria-hidden="true"> — </span><time datetime={dates.to.dt}>{dates.to.label}</time></>}
                            {dates.present && <><span aria-hidden="true"> — </span>Present</>}
                          </span>
                        </p>
                      </article>

                      {details && (
                        <button
                          class="row-open"
                          type="button"
                          data-dialog-open={dialogId}
                          aria-haspopup="dialog"
                          aria-controls={dialogId}
                        >
                          {/* O rótulo visível é a seta; o nome acessível diz de
                              QUEM são os detalhes. Numa lista de nove linhas,
                              nove botões chamados "Read more" mandam o leitor
                              de tela adivinhar em qual delas ele está. */}
                          <span class="sr-only">Read more about {entry.title}</span>
                          <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 3l5 5-5 5"></path>
                          </svg>
                        </button>
                      )}
                    </li>
                  );
                })}
              </ol>
            </section>
          ))}
        </div>
      </div>

      <p class="craft-note">
        Personal experiments and things made for the joy of making live on <a href="/craft">/craft</a>.
      </p>
    </div>
  </main>

  {detailed.map((entry) => {
    const dates = range(entry);
    const dialogId = `work-details-${entry.id}`;

    return (
      <dialog class="work-dialog" id={dialogId} data-work-dialog aria-labelledby={`${dialogId}-title`}>
        <div class="dialog-shell">
          <header class="dialog-head">
            <div>
              <p class="dialog-kicker">{entryType[entry.kind]}</p>
              <h2 id={`${dialogId}-title`}>{entry.title}</h2>
              <p class="dialog-company">{entry.org}</p>
            </div>

            <button class="dialog-close" type="button" data-dialog-close aria-label={`Close ${entry.title} details`}>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M5 5l14 14M19 5 5 19"></path>
              </svg>
            </button>
          </header>

          <div class="dialog-body">
            <div class="dialog-meta">
              <span class:list={['dialog-mark', entry.logo && 'has-image']} style={`--mark-hue:${HUE.get(entry.id)}`} aria-hidden="true">
                {entry.logo ? <img src={entry.logo} alt="" decoding="async" /> : monogram(entry)}
              </span>
              <p>
                <time datetime={dates.from.dt}>{dates.from.label}</time>
                {dates.to && <><span aria-hidden="true"> — </span><time datetime={dates.to.dt}>{dates.to.label}</time></>}
                {dates.present && <><span aria-hidden="true"> — </span>Present</>}
              </p>
            </div>

            {entry.badge && <p class="badge">{entry.badge}</p>}

            {entry.summary && (
              <section class="dialog-section" aria-labelledby={`${dialogId}-overview`}>
                <h3 id={`${dialogId}-overview`}>Overview</h3>
                <p class="dialog-summary">{entry.summary}</p>
              </section>
            )}

            {entry.impact?.length && (
              <section class="dialog-section" aria-labelledby={`${dialogId}-contributions`}>
                <h3 id={`${dialogId}-contributions`}>What I did</h3>
                <ul class="impact-list">
                  {entry.impact.map((line) => <li>{line}</li>)}
                </ul>
              </section>
            )}

            {entry.stack?.length && (
              <section class="dialog-section" aria-labelledby={`${dialogId}-tools`}>
                <h3 id={`${dialogId}-tools`}>Tools & technologies</h3>
                <ul class="chips">
                  {entry.stack.map((tech) => <li>{tech}</li>)}
                </ul>
              </section>
            )}

            {entry.href && (
              <a class="project-link" href={entry.href} target="_blank" rel="noopener noreferrer">
                Visit {entry.org ?? entry.title}
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 3h7v7M13 3 5 11M11 9v4H3V5h4"></path>
                </svg>
              </a>
            )}
          </div>
        </div>
      </dialog>
    );
  })}
</Layout>

<script>
  import { initTheme } from '../scripts/theme';
  import { initWork } from '../scripts/work';
  import { initWorkPanels } from '../scripts/workPanels';

  initTheme();
  initWorkPanels();
  initWork();
</script>

<style>
  .paper {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    transition: background-color var(--theme-fade);
  }

  /* Sem o modo painel (script desligado) a página é a lista de sempre: as duas
     seções empilhadas e rolagem normal. Com ele, html e body ficam com o
     height:100% / overflow:hidden que o global.css já dá — quem rola, se
     precisar, é o painel. */
  :global(html:not([data-work-panels]):has(.work-page)),
  :global(html:not([data-work-panels]):has(.work-page) body) {
    height: auto;
    overflow: visible;
  }

  /* A goteira da barra de rolagem fica reservada SEMPRE. Sem isto, travar a
     rolagem (na cortina e nos diálogos) devolvia ~15px de largura à página, e
     a lista inteira dava um pulo lateral no meio da abertura — bem no momento
     em que ela está entrando. Como esta página rola de qualquer jeito, o
     espaço reservado não custa nada fora da transição. */
  :global(html:not([data-work-panels]):has(.work-page)) {
    scrollbar-gutter: stable;
  }

  :global(body.has-work-dialog) {
    overflow: hidden !important;
  }

  /* Vale enquanto a cortina existe — armada E abrindo. Só em 'armed' a
     rolagem voltava assim que a abertura começava. */
  :global(html[data-work-entry] body),
  :global(body.has-work-transition) {
    overflow: hidden !important;
  }

  /* ——— a pintura se abre em duas folhas ———
     As folhas são MÁSCARAS, não cópias: cada uma recorta metade da mesma
     emenda — a pintura inteira, na proporção da fita e girada como a fita a
     gira (ver scripts/workNavigation.ts → WORK_SEAM). É o mesmo retângulo que
     a home desenha no último quadro dela, com a mesma conta, então a troca de
     documento não troca o desenho.

     Os números da abertura estão logo abaixo, e cada um responde a uma coisa
     que fazia o corte parecer duro:

     --open-dur / --open-ease  A curva anterior (cubic-bezier(0.76,0,0.24,1))
        para, chicoteia e para de novo, e o chicote caía justamente no meio da
        tela. Esta sai depressa — herdando a velocidade com que a pintura
        chegou — e passa o resto do tempo assentando.

     --seam-parallax  Quanto a pintura ANDA CONTRA a folha que a descobre. Em 1
        ela ficaria imóvel e só a máscara correria; em 0 a folha vira um cartão
        rígido voando pro lado, que era o efeito antigo. Perto de 1 é o que faz
        a página parecer descoberta, e não empurrada.

     --seam-breath  A pintura continua crescendo enquanto abre. Sem isso ela
        congela no quadro em que a página troca e só então a cortina se mexe —
        e parada seguida de movimento é exatamente o que se lê como tranco. */
  .work-transition {
    --open-dur: 1.15s;
    --open-ease: cubic-bezier(0.32, 0.12, 0.16, 1);
    --close-dur: 0.9s;
    --close-ease: cubic-bezier(0.36, 0, 0.22, 1);
    --seam-parallax: 0.86;
    --seam-breath: 1.05;
    --panel-travel: 51vw;
    position: fixed;
    top: 0;
    left: 0;
    /* 100vw, e não `inset: 0`: com a goteira reservada, o bloco de contenção
       de um fixo para 15px antes da beirada da janela, e a cortina deixava uma
       tira de papel aparecendo à direita. vw conta a janela inteira. */
    width: 100vw;
    height: 100vh;
    z-index: 20;
    visibility: hidden;
    overflow: hidden;
    pointer-events: none;
  }

  .work-transition-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    transform: translateX(var(--panel-x, 0px));
  }

  .work-transition-panel.is-left {
    left: 0;
  }

  .work-transition-panel.is-right {
    right: 0;
  }

  /* A emenda vive DENTRO de cada folha, mas é medida pela JANELA: por isso ela
     se ancora na beirada que encosta no centro da tela (100% na folha da
     esquerda, 0 na da direita). As duas cópias caem no mesmo lugar e a costura
     entre elas some. */
  .work-transition .work-seam {
    --seam-w: calc(max(100vw, 100vh * var(--seam-aspect)) * var(--seam-overscan));
    --seam-h: calc(var(--seam-w) / var(--seam-aspect));
    position: absolute;
    top: 50%;
    width: var(--seam-w);
    height: var(--seam-h);
    overflow: hidden;
    background: #171411;
    transform: translate(-50%, -50%) translateX(var(--seam-x, 0px)) scale(var(--seam-scale, 1));
  }

  .work-transition-panel.is-left .work-seam {
    left: 100%;
  }

  .work-transition-panel.is-right .work-seam {
    left: 0;
  }

  /* a pintura chega deitada da fita — ver a mesma regra em index.astro */
  .work-transition .work-seam img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--seam-h);
    height: var(--seam-w);
    display: block;
    max-width: none;
    max-height: none;
    object-fit: fill;
    transform: translate(-50%, -50%) rotate(var(--seam-rotation));
  }

  .work-transition .work-seam::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 7, 6, 0.08), rgba(8, 7, 6, 0.48));
  }

  /* O título entra e sai por opacidade e ESCALA, nunca por letter-spacing.
     Havia uma animação de tracking aqui, e ela era invisível: `small` e
     `strong` declaram o próprio espaçamento, então o do contêiner não chegava
     a lugar nenhum. Custava, porém, o preço cheio — mexer numa propriedade
     herdada invalida a subárvore, e o navegador refazia layout e pintura de
     uma palavra em Playfair de 15vw a cada quadro. Medido num celular emulado:
     82 layouts e 194 pinturas na abertura, contra 16 e 63 sem ela. Era essa a
     travada do celular; escala e opacidade ficam no compositor. */
  .work-transition-title {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    color: #fff;
    text-align: center;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.42);
    opacity: 0;
    transform: scale(var(--title-scale, 1));
  }

  .work-transition-title small {
    margin-bottom: 0.4rem;
    font-size: clamp(0.6rem, 1vw, 0.75rem);
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .work-transition-title strong {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(4rem, 15vw, 12rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.065em;
  }

  /* ——— os três estados da cortina ———
     FECHADA é o estado natural das regras acima (folhas em 0, pintura em 1):
     é o quadro que a home entrega e o quadro em que a saída termina. Só a
     visibilidade precisa ser dita. */
  :global(html[data-work-entry]) .work-transition,
  .work-transition.is-preparing-exit,
  .work-transition.is-closing {
    visibility: visible;
    pointer-events: auto;
  }

  :global(html[data-work-entry]) .work-transition-title {
    opacity: 1;
  }

  /* A promoção a camada acontece enquanto a pintura ainda está PARADA, não no
     quadro em que ela começa a andar. Com o will-change só nos estados de
     movimento, a primeira rasterização das duas folhas (imagem grande, em tela
     de celular densa) caía dentro do primeiro quadro da abertura — e era um
     quadro de 50 a 80ms, o tranco inicial. Aqui ele cabe na espera pela thread
     livre (ver work.ts → calmFrame), onde não custa nada. E sai junto com a
     cortina: fora dela seriam duas camadas do tamanho da tela guardadas numa
     página que rola. */
  :global(html[data-work-entry]) .work-transition-panel,
  .work-transition.is-preparing-exit .work-transition-panel,
  .work-transition.is-closing .work-transition-panel {
    will-change: transform, opacity;
  }

  :global(html[data-work-entry]) .work-seam,
  .work-transition.is-preparing-exit .work-seam,
  .work-transition.is-closing .work-seam {
    will-change: transform;
  }

  /* ABERTA. O mesmo estado serve para o fim da entrada e para o começo da
     saída — descrever "aberto" duas vezes seria deixar as duas pontas livres
     para divergirem no próximo ajuste. */
  .work-transition.is-opening .work-transition-panel,
  .work-transition.is-preparing-exit .work-transition-panel {
    opacity: 0;
  }

  /* Folha e pintura são poses da MESMA folha: as duas variáveis moram no
     painel e a emenda as herda. Não é arrumação — é o que mantém todos os
     estados com a mesma forma de seletor. Com `--seam-x` escrito no
     `.work-seam`, a regra de "aberta" ficava com uma classe a mais que a de
     "fechando", e como as duas classes convivem na saída (a pose primeiro, o
     movimento depois) a mais específica vencia: as folhas voltavam ao centro
     mas a pintura ficava parada no deslocamento do parallax — dois retângulos
     no meio da tela e papel nas beiradas. */
  .work-transition.is-opening .is-left,
  .work-transition.is-preparing-exit .is-left {
    --panel-x: calc(var(--panel-travel) * -1);
    --seam-x: calc(var(--panel-travel) * var(--seam-parallax));
    --seam-scale: var(--seam-breath);
  }

  .work-transition.is-opening .is-right,
  .work-transition.is-preparing-exit .is-right {
    --panel-x: var(--panel-travel);
    --seam-x: calc(var(--panel-travel) * var(--seam-parallax) * -1);
    --seam-scale: var(--seam-breath);
  }

  .work-transition.is-opening .work-transition-title,
  .work-transition.is-preparing-exit .work-transition-title {
    opacity: 0;
    --title-scale: 1.06;
  }

  /* Só quem ABRE ou FECHA transiciona. `is-preparing-exit` sozinho é uma pose,
     não um movimento: é ela que dá às folhas um ponto de partida real antes de
     `is-closing` entrar.

     O will-change não mora aqui: ele é aplicado antes, com a cortina ainda
     fechada — ver a regra da promoção acima. */
  .work-transition.is-opening .work-transition-panel,
  .work-transition.is-closing .work-transition-panel {
    transition:
      transform var(--open-dur) var(--open-ease),
      opacity calc(var(--open-dur) * 0.4) linear calc(var(--open-dur) * 0.6);
  }

  .work-transition.is-opening .work-seam,
  .work-transition.is-closing .work-seam {
    transition: transform var(--open-dur) var(--open-ease);
  }

  .work-transition.is-opening .work-transition-title,
  .work-transition.is-closing .work-transition-title {
    transition: opacity calc(var(--open-dur) * 0.4) ease, transform var(--open-dur) var(--open-ease);
  }

  /* FECHANDO. Vem depois da regra de "aberta" de propósito: as duas têm a
     mesma especificidade, e é a ordem que faz o estado final vencer o inicial
     no mesmo elemento. A curva é outra — quem fecha tem que ENCOSTAR, não
     assentar, senão o último quadro daqui não bate com o primeiro da home. */
  .work-transition.is-closing .work-transition-panel {
    --panel-x: 0px;
    --seam-x: 0px;
    --seam-scale: 1;
    opacity: 1;
    transition:
      transform var(--close-dur) var(--close-ease),
      opacity calc(var(--close-dur) * 0.4) linear;
  }

  .work-transition.is-closing .work-seam {
    transition: transform var(--close-dur) var(--close-ease);
  }

  /* O título espera a pintura chegar. Sem o atraso ele acendia sobre a lista
     ainda em papel branco, e a palavra aparecia antes do fundo dela. */
  .work-transition.is-closing .work-transition-title {
    opacity: 1;
    --title-scale: 1;
    transition:
      opacity calc(var(--close-dur) * 0.45) ease calc(var(--close-dur) * 0.4),
      transform var(--close-dur) var(--close-ease);
  }

  /* ——— o conteúdo CHEGA, não estava esperando ———
     Antes a lista já estava montada por baixo e a cortina só a descobria: o
     movimento acabava na borda das folhas e a página aparecia inteira, parada.
     O atraso base põe a primeira linha em movimento com a cortina ainda quase
     fechada, e o escalonamento faz a leitura descer com ela. Sem marca de
     entrada (link direto, reload, baixa animação) nada disso existe. */
  :global(html[data-work-entry]) .work-head,
  :global(html[data-work-entry]) .is-arriving {
    opacity: 0;
    transform: translateY(18px);
  }

  :global(html[data-work-entry='opening']) .work-head,
  :global(html[data-work-entry='opening']) .is-arriving {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s ease calc(0.16s + var(--i, 0) * 0.06s),
      transform 0.8s cubic-bezier(0.2, 0.86, 0.24, 1) calc(0.16s + var(--i, 0) * 0.06s);
  }

  .back {
    position: fixed;
    top: 1.5rem;
    left: 2rem;
    z-index: 6;
    padding: 0.35rem 0;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--theme-fade);
  }

  .back::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .back:hover::after,
  .back:focus-visible::after {
    transform: scaleX(1);
  }

  .theme {
    position: fixed;
    top: 1.3rem;
    right: 1.5rem;
    z-index: 6;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(var(--ink-rgb), 0.12);
    border-radius: 999px;
    background: rgba(90, 90, 90, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, color var(--theme-fade), border-color var(--theme-fade);
  }

  .theme:hover {
    background: rgba(90, 90, 90, 0.42);
  }

  .theme svg {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: opacity var(--theme-fade), transform var(--theme-fade);
  }

  .theme .icon-sun {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-moon {
    opacity: 0;
    transform: rotate(90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-sun {
    opacity: 1;
    transform: none;
  }

  .work-page {
    min-height: 100vh;
  }

  /* A medida vertical desta página passou a ser vh, e não vw.
     Enquanto ela rolava, o respiro podia crescer com a largura — o que
     transbordasse ia pra baixo da dobra e ninguém se machucava. Agora o
     conteúdo TEM que caber, e num notebook de 720px de altura um cabeçalho
     dimensionado pela largura come a lista inteira. Cada clamp abaixo é lido
     pela altura porque é a altura que é escassa. */
  /* A COLUNA de leitura, num lugar só. O trilho passou a ocupar a tela inteira
     (ver mais abaixo) e a lista dentro dele voltou a se estreitar por conta
     própria — as duas medidas precisam ser a mesma, e duas cópias do mesmo
     min() é como elas deixam de ser. */
  .work-page {
    --column: min(100% - 3rem, 920px);
  }

  .work-inner {
    width: var(--column);
    margin: 0 auto;
    padding: clamp(2.75rem, 8.5vh, 7.5rem) 0 clamp(1rem, 2.6vh, 2.5rem);
  }

  :global(html[data-work-panels]) .work-page {
    height: 100dvh;
    overflow: hidden;
  }

  /* auto auto 1fr auto: cabeçalho, abas e o rodapé do /craft pedem o tamanho
     que têm, e o trilho fica com o que sobrar. O minmax(0, 1fr) é o que
     autoriza esse resto a ser MENOR que o conteúdo — sem ele a faixa cresce
     até caber a lista e volta a empurrar a página pra fora da tela, que é
     exatamente o que este layout existe pra impedir. */
  :global(html[data-work-panels]) .work-inner {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    height: 100dvh;
  }

  .work-head {
    padding-bottom: clamp(1.1rem, 3vh, 2rem);
  }

  .eyebrow,
  .dialog-kicker {
    margin-bottom: 0.75rem;
    color: rgba(var(--ink-rgb), 0.5);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  .work-head h1 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.4rem, min(7vw, 7.4vh), 4.6rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .lead {
    max-width: 36rem;
    margin-top: clamp(0.6rem, 1.6vh, 1.1rem);
    color: rgba(var(--ink-rgb), 0.62);
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    line-height: 1.65;
    transition: color var(--theme-fade);
  }

  /* ——— as abas ———
     Elas falam na voz do .eyebrow lá do topo — versalete, entrelinha larga,
     meio-tom — e não na do <h1>: são um CONTROLE, e um controle que grita
     compete com o título da página pela hierarquia. O que separa a ativa da
     outra é opacidade e a régua embaixo, não tamanho: trocar de aba não pode
     fazer a linha inteira mudar de altura. */
  .work-tabs {
    position: relative;
    display: flex;
    gap: clamp(1.1rem, 3vw, 2rem);
    align-items: center;
    padding: clamp(0.65rem, 2.1vh, 1.4rem) 0;
  }

  .tab {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.2rem 0;
    border: 0;
    background: transparent;
    color: rgba(var(--ink-rgb), 0.42);
    font: inherit;
    font-size: clamp(0.62rem, 1.5vw, 0.68rem);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .tab:hover {
    color: rgba(var(--ink-rgb), 0.7);
  }

  .tab[aria-selected='true'] {
    color: var(--ink);
    cursor: default;
  }

  /* O único fio que sobrou na página. Ele não decora: é a resposta à pergunta
     "qual das duas estou vendo". Todos os outros — as bordas da fileira, os
     separadores entre as linhas, o traço acima do rodapé — eram divisões que
     o espaço em branco já fazia, e cada um deles competia com este. */
  .tab-rule {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: var(--rule-width, 0);
    transform: translateX(var(--rule-x, 0));
    background: var(--ink);
    transition:
      transform 480ms cubic-bezier(0.2, 0.86, 0.24, 1),
      width 480ms cubic-bezier(0.2, 0.86, 0.24, 1),
      background-color var(--theme-fade);
  }

  /* Antes da primeira medida a régua não tem onde estar, e nascer com largura
     zero no canto esquerdo faria ela DESLIZAR do nada até a primeira aba no
     carregamento. Fica escondida até o JS medir. */
  .work-tabs:not([data-ready]) .tab-rule {
    opacity: 0;
  }

  /* ——— o trilho ———
     A janela recorta; quem anda é o rail. O rail tem a largura da janela e os
     painéis TRANSBORDAM dele (flex: 0 0 100% de 100%), e é isso que faz
     translateX(-100%) valer exatamente um painel — se o rail medisse a soma
     dos painéis, cada -100% pularia os dois de uma vez. */
  .work-track {
    min-height: 0;
  }

  /* O trilho SANGRA pra fora da coluna e ocupa a tela inteira.
     Recortado na coluna de 920px, o painel que saía evaporava a 260px da borda
     do monitor, com página em branco depois dele — a troca lia como um cartão
     desaparecendo no meio da tela, não como uma tela dando lugar à outra. É a
     borda do MONITOR que precisa ser a linha onde um some e o outro nasce.

     A conta: 50% da coluna menos 50% da janela, dos dois lados, devolve
     exatamente a largura que a coluna tirou. Só no modo painel — no retorno
     sem script a página rola, tem barra, e 100vw ali criaria rolagem lateral. */
  :global(html[data-work-panels]) .work-track {
    overflow: hidden;
    margin-inline: calc(50% - 50vw);
  }

  .work-rail {
    display: flex;
    width: 100%;
    height: 100%;
  }

  /* A curva do deslize é a ÚNICA da página que não é de desaceleração pura.
     A cubic-bezier(0.2, 0.86, 0.24, 1) que o resto usa serve pra coisa que
     CHEGA — ela larga a 64% do caminho em 100ms e passa o resto assentando. Um
     painel do tamanho da tela com essa curva já saiu antes de a vista
     acompanhar: o cruzamento nas duas bordas, que é o movimento inteiro,
     acontece num quadro. Esta sai devagar, cruza no meio do tempo e assenta —
     é o percurso que se lê, não só o destino. */
  :global(html[data-work-panels]) .work-rail {
    transform: translate3d(calc(var(--panel, 0) * -100% + var(--drag, 0px)), 0, 0);
    transition: transform var(--slide-dur, 620ms) cubic-bezier(0.5, 0, 0.15, 1);
  }

  /* Enquanto o dedo está na tela o rail SEGUE o dedo: uma transição aqui
     colocaria um atraso entre o toque e o desenho, que é a diferença entre
     arrastar uma coisa e pedir pra ela ir. */
  :global(html[data-work-panels]) .work-rail.is-dragging {
    transition: none;
  }

  /* O portão de movimento do site (motion.ts), que é uma escolha do usuário e
     não a preferência do sistema — o @media lá embaixo não a enxerga. Quem
     carimba é o workPanels.ts, com o mesmo booleano que já decide não animar
     as linhas do painel que entra. */
  :global(html[data-work-panels]) .work-rail[data-still] {
    transition: none;
  }

  .work-panel {
    min-width: 0;
  }

  :global(html[data-work-panels]) .work-panel {
    flex: 0 0 100%;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    /* o painel é o fim da linha da rolagem: sem isto, chegar ao fim da lista
       repassa o gesto pra página e o documento inteiro balança */
    overscroll-behavior: contain;
    /* o gesto vertical continua rolando o painel; o horizontal é nosso */
    touch-action: pan-y;
  }

  :global(html[data-work-panels]) .work-panel:focus-visible {
    outline: 2px solid rgba(var(--ink-rgb), 0.4);
    outline-offset: -2px;
  }

  /* Sem script os dois painéis ficam empilhados, um depois do outro, e a
     página rola como antes. */
  :global(html:not([data-work-panels])) .work-rail {
    display: block;
  }

  .experience-list {
    list-style: none;
  }

  /* A lista fica no MEIO da faixa que sobrou, não colada no topo dela: um
     grupo tem quatro linhas e o outro cinco, e ancorar as duas em cima deixava
     um buraco de tamanho diferente embaixo de cada painel — a troca de aba
     virava a lista subindo e o vazio mudando de altura.

     margin auto, e não justify-content: center. Os dois centram igual enquanto
     sobra espaço; a diferença aparece quando o painel precisa rolar, e aí o
     centrado empurra o começo da lista pra ACIMA do topo da rolagem, fora do
     alcance. A margem automática vira zero quando não há folga. */
  :global(html[data-work-panels]) .experience-list {
    /* o trilho é a tela inteira; quem devolve o texto à coluna de leitura é a
       lista, aqui dentro — margin auto centra nos dois eixos de uma vez */
    width: var(--column);
    margin: auto;
  }

  /* A linha perdeu a frase de preview pra caber na tela — ela continua no
     diálogo, em "Overview", que é onde alguém que quer ler já vai. O que
     sobrou é o que identifica a entrada de relance: quem, onde, quando. */
  .experience-item {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 0 clamp(0.9rem, 2vw, 1.25rem);
    align-items: center;
    padding: clamp(0.62rem, 1.9vh, 1.3rem) 0;
  }

  .experience-mark,
  .dialog-mark {
    display: grid;
    place-items: center;
    border: 1px solid hsla(var(--mark-hue), 45%, 45%, 0.18);
    background: hsla(var(--mark-hue), 55%, 50%, 0.1);
    color: hsl(var(--mark-hue), 42%, 38%);
    font-weight: 700;
    letter-spacing: -0.04em;
    transition: color var(--theme-fade), background-color var(--theme-fade), border-color var(--theme-fade);
  }

  .experience-mark {
    width: 3rem;
    aspect-ratio: 1;
    border-radius: 0.65rem;
    font-size: 0.8rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .experience-mark.has-image,
  .dialog-mark.has-image {
    padding: 0.42rem;
    overflow: hidden;
    border-color: rgba(10, 10, 10, 0.12);
    background: #fff;
  }

  .experience-mark.has-image img,
  .dialog-mark.has-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  :global(html[data-theme='dark']) .experience-mark,
  :global(html[data-theme='dark']) .dialog-mark {
    color: hsl(var(--mark-hue), 55%, 72%);
  }

  .experience-main {
    min-width: 0;
  }

  .experience-main h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.02rem, 2.2vw, 1.28rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  /* Organização e data na MESMA linha, separadas por um ponto. Data em pílula
     na direita é o que a lista fazia enquanto tinha altura de sobra; aqui ela
     custava uma coluna inteira no desktop e uma linha inteira no celular, e o
     que ela dizia cabe ao lado de onde. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.45rem;
    align-items: baseline;
    margin-top: 0.18rem;
    color: rgba(var(--ink-rgb), 0.58);
    font-size: clamp(0.76rem, 1.7vw, 0.82rem);
    line-height: 1.45;
    transition: color var(--theme-fade);
  }

  .company {
    font-weight: 600;
    color: rgba(var(--ink-rgb), 0.7);
    transition: color var(--theme-fade);
  }

  .dot {
    margin-right: 0.32rem;
    color: rgba(var(--ink-rgb), 0.3);
  }

  .period {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* A seta é o rótulo visível; o alvo é a linha inteira (o ::after abaixo).
     Numa lista desta densidade, um botão de 15px é um alvo cruel no toque, e
     alargar o botão em si empurraria a coluna do texto. */
  .row-open {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(var(--ink-rgb), 0.42);
    cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .row-open::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .experience-item:hover .row-open,
  .row-open:focus-visible {
    background: rgba(var(--ink-rgb), 0.08);
    color: var(--ink);
    transform: translateX(2px);
  }

  /* O realce é da LINHA, porque o alvo é a linha. Sangra pros lados pra
     parecer uma faixa acesa e não um retângulo colado no texto. */
  .experience-item:has(.row-open:hover),
  .experience-item:has(.row-open:focus-visible) {
    background: rgba(var(--ink-rgb), 0.035);
    box-shadow: 0 0 0 0.75rem rgba(var(--ink-rgb), 0.035);
  }

  .craft-note {
    margin-top: clamp(0.9rem, 2.4vh, 1.6rem);
    color: rgba(var(--ink-rgb), 0.52);
    font-size: clamp(0.76rem, 1.7vw, 0.84rem);
    line-height: 1.55;
    transition: color var(--theme-fade);
  }

  /* o rótulo que só o leitor de tela lê (a seta é o rótulo de quem enxerga) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ——— a troca de painel ———
     O rail desliza inteiro, mas um retângulo rígido voando pro lado lê como
     cartão sendo empurrado, não como página trocando — é a mesma queixa que o
     --seam-parallax da cortina responde. Então as linhas do painel que ENTRA
     assentam um pouco atrás do rail, escalonadas, e vindo do lado de onde o
     painel veio: --dir é +1 quando ele entra pela direita e -1 pela esquerda.

     E é ATRASO, não aparição: nada aqui mexe em opacidade. Uma linha que nasce
     transparente no meio da tela surge do nada, que é justamente o contrário
     de entrar pela borda — o painel inteiro atravessa opaco, e o escalonamento
     só faz as linhas arrastarem um pouco atrás dele.

     O escalonamento tem teto (o min) porque ele mede posição na lista, e numa
     lista longa o atraso da última linha passaria da duração do próprio
     deslize — a linha assentaria depois de o painel já ter chegado. */
  @keyframes row-settle {
    from {
      transform: translate3d(calc(var(--dir, 1) * 24px), 0, 0);
    }
  }

  .work-panel.is-entering .experience-item {
    animation: row-settle 460ms cubic-bezier(0.2, 0.86, 0.24, 1) backwards;
    animation-delay: calc(min(var(--row, 0), 7) * 30ms + 40ms);
  }

  .craft-note a {
    color: rgba(var(--ink-rgb), 0.78);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.3);
  }

  .work-dialog {
    width: min(calc(100% - 2rem), 700px);
    max-height: min(86dvh, 780px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(var(--ink-rgb), 0.14);
    border-radius: 1.15rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 26px 80px rgba(0, 0, 0, 0.22);
    opacity: 0;
    transform: translateY(12px) scale(0.985);
    transition: opacity 180ms ease, transform 180ms ease, background-color var(--theme-fade), color var(--theme-fade);
  }

  .work-dialog[open] {
    opacity: 1;
    transform: none;
  }

  .work-dialog::backdrop {
    background: rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .dialog-shell {
    display: flex;
    max-height: min(86dvh, 780px);
    flex-direction: column;
  }

  .dialog-head {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.1);
  }

