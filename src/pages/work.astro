---
import Layout from '../layouts/Layout.astro';
import { ENTRIES, range, type Entry } from '../data/work';

const entries = [...ENTRIES].sort((a, b) => {
  const aCurrent = a.end === 'present';
  const bCurrent = b.end === 'present';

  if (aCurrent !== bCurrent) return aCurrent ? -1 : 1;

  const aAnchor = aCurrent ? a.start : a.end;
  const bAnchor = bCurrent ? b.start : b.end;

  return bAnchor.localeCompare(aAnchor) || b.start.localeCompare(a.start);
});

const entryType: Record<Entry['kind'], string> = {
  role: 'Experience',
  build: 'Project',
  recognition: 'Recognition',
};

function monogram(entry: Entry) {
  const source = entry.org ?? entry.title;
  const words = source.match(/[A-Za-zÀ-ÿ0-9]+/g) ?? [];
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
}

function preview(entry: Entry) {
  if (!entry.summary) return entryType[entry.kind];
  return entry.summary.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim() ?? entry.summary;
}

function hasDetails(entry: Entry) {
  return Boolean(entry.summary || entry.impact?.length || entry.stack?.length || entry.badge || entry.href);
}
---

<Layout lang="en">
  <Fragment slot="head">
    <title>Experience — Carlos Leonardo</title>
    <meta
      name="description"
      content="Carlos Leonardo's professional experience, projects and recognition."
    />
    <link rel="prefetch" href="/" />

    {/* A home termina coberta pela pintura do segmento Work. Esta marca nasce
        antes do primeiro paint para a página começar no mesmo quadro e só
        então abrir as duas folhas sobre o conteúdo. */}
    <script is:inline>
      try {
        if (sessionStorage.getItem('portfolio:work-entry')) {
          sessionStorage.removeItem('portfolio:work-entry');
          document.documentElement.dataset.workEntry = 'armed';
        }
      } catch (e) {}
    </script>
  </Fragment>

  <div class="paper" aria-hidden="true"></div>

  <div class="work-transition" data-work-transition aria-hidden="true">
    <div class="work-transition-panel is-left">
      <img src="/textures/work.jpg" alt="" />
    </div>
    <div class="work-transition-panel is-right">
      <img src="/textures/work.jpg" alt="" />
    </div>
    <span class="work-transition-title">
      <small>Selected</small>
      <strong>WORK</strong>
    </span>
  </div>

  <a class="back" href="/" data-work-back>‹ Back</a>

  <button
    class="theme"
    data-theme-toggle
    aria-pressed="false"
    aria-label="Toggle dark theme"
    title="Light / dark theme"
  >
    <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>

  <main class="work-page">
    <div class="work-inner">
      <header class="work-head">
        <p class="eyebrow">Work</p>
        <h1>Experience</h1>
        <p class="lead">A concise view of the roles, projects and communities I’ve helped build.</p>
      </header>

      <ol class="experience-list">
        {entries.map((entry, index) => {
          const dates = range(entry);
          const dialogId = `work-details-${entry.id}`;

          return (
            <li class="experience-item">
              <div
                class:list={['experience-mark', entry.logo && 'has-image']}
                style={`--mark-hue:${(index * 47 + 258) % 360}`}
                aria-hidden="true"
              >
                {entry.logo ? (
                  <img
                    src={entry.logo}
                    alt=""
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : monogram(entry)}
              </div>

              <article class="experience-main">
                <h2>{entry.title}</h2>
                <p class="company">{entry.org ?? entryType[entry.kind]}</p>
                <p class="preview">{preview(entry)}</p>

                {hasDetails(entry) && (
                  <button
                    class="read-more"
                    type="button"
                    data-dialog-open={dialogId}
                    aria-haspopup="dialog"
                    aria-controls={dialogId}
                  >
                    Read more
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4"></path>
                    </svg>
                  </button>
                )}
              </article>

              <p class="period">
                <time datetime={dates.from.dt}>{dates.from.label}</time>
                {dates.to && <><span aria-hidden="true"> — </span><time datetime={dates.to.dt}>{dates.to.label}</time></>}
                {dates.present && <><span aria-hidden="true"> — </span>Present</>}
              </p>
            </li>
          );
        })}
      </ol>

      <p class="craft-note">
        Personal experiments and things made for the joy of making live on <a href="/craft">/craft</a>.
      </p>
    </div>
  </main>

  {entries.filter(hasDetails).map((entry, index) => {
    const dates = range(entry);
    const dialogId = `work-details-${entry.id}`;

    return (
      <dialog class="work-dialog" id={dialogId} data-work-dialog aria-labelledby={`${dialogId}-title`}>
        <div class="dialog-shell">
          <header class="dialog-head">
            <div>
              <p class="dialog-kicker">{entryType[entry.kind]}</p>
              <h2 id={`${dialogId}-title`}>{entry.title}</h2>
              <p class="dialog-company">{entry.org}</p>
            </div>

            <button class="dialog-close" type="button" data-dialog-close aria-label={`Close ${entry.title} details`}>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M5 5l14 14M19 5 5 19"></path>
              </svg>
            </button>
          </header>

          <div class="dialog-body">
            <div class="dialog-meta">
              <span class:list={['dialog-mark', entry.logo && 'has-image']} style={`--mark-hue:${(index * 47 + 258) % 360}`} aria-hidden="true">
                {entry.logo ? <img src={entry.logo} alt="" decoding="async" /> : monogram(entry)}
              </span>
              <p>
                <time datetime={dates.from.dt}>{dates.from.label}</time>
                {dates.to && <><span aria-hidden="true"> — </span><time datetime={dates.to.dt}>{dates.to.label}</time></>}
                {dates.present && <><span aria-hidden="true"> — </span>Present</>}
              </p>
            </div>

            {entry.badge && <p class="badge">{entry.badge}</p>}

            {entry.summary && (
              <section class="dialog-section" aria-labelledby={`${dialogId}-overview`}>
                <h3 id={`${dialogId}-overview`}>Overview</h3>
                <p class="dialog-summary">{entry.summary}</p>
              </section>
            )}

            {entry.impact?.length && (
              <section class="dialog-section" aria-labelledby={`${dialogId}-contributions`}>
                <h3 id={`${dialogId}-contributions`}>What I did</h3>
                <ul class="impact-list">
                  {entry.impact.map((line) => <li>{line}</li>)}
                </ul>
              </section>
            )}

            {entry.stack?.length && (
              <section class="dialog-section" aria-labelledby={`${dialogId}-tools`}>
                <h3 id={`${dialogId}-tools`}>Tools & technologies</h3>
                <ul class="chips">
                  {entry.stack.map((tech) => <li>{tech}</li>)}
                </ul>
              </section>
            )}

            {entry.href && (
              <a class="project-link" href={entry.href} target="_blank" rel="noopener noreferrer">
                Visit {entry.org ?? entry.title}
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 3h7v7M13 3 5 11M11 9v4H3V5h4"></path>
                </svg>
              </a>
            )}
          </div>
        </div>
      </dialog>
    );
  })}
</Layout>

<script>
  import { initTheme } from '../scripts/theme';
  import { initWork } from '../scripts/work';

  initTheme();
  initWork();
</script>

<style>
  .paper {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    transition: background-color var(--theme-fade);
  }

  :global(html:has(.work-page)),
  :global(body:has(.work-page)) {
    height: auto;
    overflow: visible;
  }

  :global(body.has-work-dialog) {
    overflow: hidden !important;
  }

  :global(html[data-work-entry='armed'] body),
  :global(body.has-work-transition) {
    overflow: hidden !important;
  }

  /* ——— a pintura se abre em duas folhas ———
     Cada metade carrega uma cópia com 200% da largura: juntas elas recompõem
     uma única imagem sem emenda, mas podem sair por lados opostos. */
  .work-transition {
    position: fixed;
    inset: 0;
    z-index: 20;
    visibility: hidden;
    overflow: hidden;
    pointer-events: none;
    perspective: 1200px;
  }

  .work-transition-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    background: #171411;
    transform: translateX(var(--closed-x));
    transition: transform 0.82s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }

  .work-transition-panel.is-left {
    --closed-x: -102%;
    left: 0;
    transform-origin: right center;
  }

  .work-transition-panel.is-right {
    --closed-x: 102%;
    right: 0;
    transform-origin: left center;
  }

  .work-transition-panel img {
    position: absolute;
    top: 0;
    width: 200%;
    height: 100%;
    display: block;
    max-width: none;
    object-fit: cover;
  }

  .work-transition-panel.is-left img {
    left: 0;
  }

  .work-transition-panel.is-right img {
    right: 0;
  }

  .work-transition-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 7, 6, 0.08), rgba(8, 7, 6, 0.48));
  }

  .work-transition-title {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    color: #fff;
    text-align: center;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.42);
    opacity: 0;
    transition: opacity 0.28s ease, letter-spacing 0.45s ease;
  }

  .work-transition-title small {
    margin-bottom: 0.4rem;
    font-size: clamp(0.6rem, 1vw, 0.75rem);
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .work-transition-title strong {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(4rem, 15vw, 12rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.065em;
  }

  :global(html[data-work-entry='armed']) .work-transition,
  .work-transition.is-preparing-exit,
  .work-transition.is-closing {
    visibility: visible;
    pointer-events: auto;
  }

  :global(html[data-work-entry='armed']) .work-transition-panel,
  .work-transition.is-closing .work-transition-panel {
    transform: translateX(0);
  }

  :global(html[data-work-entry='armed']) .work-transition-title,
  .work-transition.is-closing .work-transition-title {
    opacity: 1;
    letter-spacing: 0.08em;
  }

  .work-transition.is-opening .work-transition-panel {
    transform: translateX(var(--closed-x));
  }

  .work-transition.is-opening .work-transition-title {
    opacity: 0;
    letter-spacing: 0.22em;
  }

  .back {
    position: fixed;
    top: 1.5rem;
    left: 2rem;
    z-index: 6;
    padding: 0.35rem 0;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--theme-fade);
  }

  .back::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .back:hover::after,
  .back:focus-visible::after {
    transform: scaleX(1);
  }

  .theme {
    position: fixed;
    top: 1.3rem;
    right: 1.5rem;
    z-index: 6;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(var(--ink-rgb), 0.12);
    border-radius: 999px;
    background: rgba(90, 90, 90, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, color var(--theme-fade), border-color var(--theme-fade);
  }

  .theme:hover {
    background: rgba(90, 90, 90, 0.42);
  }

  .theme svg {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: opacity var(--theme-fade), transform var(--theme-fade);
  }

  .theme .icon-sun {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-moon {
    opacity: 0;
    transform: rotate(90deg);
  }

  :global(html[data-theme='dark']) .theme .icon-sun {
    opacity: 1;
    transform: none;
  }

  .work-page {
    min-height: 100vh;
  }

  .work-inner {
    width: min(100% - 3rem, 920px);
    margin: 0 auto;
    padding: clamp(7rem, 12vw, 10rem) 0 6rem;
  }

  .work-head {
    padding-bottom: clamp(2rem, 5vw, 3.25rem);
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.13);
  }

  .eyebrow,
  .dialog-kicker {
    margin-bottom: 0.75rem;
    color: rgba(var(--ink-rgb), 0.5);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color var(--theme-fade);
  }

  .work-head h1 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .lead {
    max-width: 36rem;
    margin-top: 1.4rem;
    color: rgba(var(--ink-rgb), 0.62);
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    line-height: 1.65;
    transition: color var(--theme-fade);
  }

  .experience-list {
    list-style: none;
  }

  .experience-item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 1.75rem;
    align-items: start;
    padding: clamp(1.75rem, 4vw, 2.6rem) 0;
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.1);
  }

  .experience-mark,
  .dialog-mark {
    display: grid;
    place-items: center;
    border: 1px solid hsla(var(--mark-hue), 45%, 45%, 0.18);
    background: hsla(var(--mark-hue), 55%, 50%, 0.1);
    color: hsl(var(--mark-hue), 42%, 38%);
    font-weight: 700;
    letter-spacing: -0.04em;
    transition: color var(--theme-fade), background-color var(--theme-fade), border-color var(--theme-fade);
  }

  .experience-mark {
    width: 4.5rem;
    aspect-ratio: 1;
    border-radius: 0.8rem;
    font-size: 1.05rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .experience-mark.has-image,
  .dialog-mark.has-image {
    padding: 0.6rem;
    overflow: hidden;
    border-color: rgba(10, 10, 10, 0.12);
    background: #fff;
  }

  .experience-mark.has-image img,
  .dialog-mark.has-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  :global(html[data-theme='dark']) .experience-mark,
  :global(html[data-theme='dark']) .dialog-mark {
    color: hsl(var(--mark-hue), 55%, 72%);
  }

  .experience-main {
    min-width: 0;
  }

  .experience-main h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .company {
    margin-top: 0.3rem;
    color: rgba(var(--ink-rgb), 0.65);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color var(--theme-fade);
  }

  .preview {
    max-width: 37rem;
    margin-top: 0.85rem;
    color: rgba(var(--ink-rgb), 0.62);
    font-size: 0.9rem;
    line-height: 1.6;
    transition: color var(--theme-fade);
  }

  .period {
    justify-self: end;
    padding: 0.48rem 0.85rem;
    border-radius: 999px;
    background: rgba(var(--ink-rgb), 0.08);
    color: rgba(var(--ink-rgb), 0.66);
    font-size: 0.76rem;
    line-height: 1;
    white-space: nowrap;
    transition: color var(--theme-fade), background-color var(--theme-fade);
  }

  .read-more {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin-top: 1rem;
    padding: 0.25rem 0;
    border: 0;
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.3);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 650;
    cursor: pointer;
    transition: border-color 160ms ease, color var(--theme-fade);
  }

  .read-more:hover {
    border-bottom-color: currentColor;
  }

  .read-more svg {
    transition: transform 160ms ease;
  }

  .read-more:hover svg {
    transform: translateX(3px);
  }

  .craft-note {
    margin-top: 3.5rem;
    color: rgba(var(--ink-rgb), 0.52);
    font-size: 0.86rem;
    line-height: 1.6;
    transition: color var(--theme-fade);
  }

  .craft-note a {
    color: rgba(var(--ink-rgb), 0.78);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.3);
  }

  .work-dialog {
    width: min(calc(100% - 2rem), 700px);
    max-height: min(86dvh, 780px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(var(--ink-rgb), 0.14);
    border-radius: 1.15rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 26px 80px rgba(0, 0, 0, 0.22);
    opacity: 0;
    transform: translateY(12px) scale(0.985);
    transition: opacity 180ms ease, transform 180ms ease, background-color var(--theme-fade), color var(--theme-fade);
  }

  .work-dialog[open] {
    opacity: 1;
    transform: none;
  }

  .work-dialog::backdrop {
    background: rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .dialog-shell {
    display: flex;
    max-height: min(86dvh, 780px);
    flex-direction: column;
  }

  .dialog-head {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.1);
  }

  .dialog-head h2 {
    max-width: 30rem;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .dialog-company {
    margin-top: 0.55rem;
    color: rgba(var(--ink-rgb), 0.58);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .dialog-close {
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border: 1px solid rgba(var(--ink-rgb), 0.14);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 160ms ease, color var(--theme-fade), border-color var(--theme-fade);
  }

  .dialog-close:hover {
    background: rgba(var(--ink-rgb), 0.07);
  }

  .dialog-body {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .dialog-meta {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    color: rgba(var(--ink-rgb), 0.6);
    font-size: 0.8rem;
  }

  .dialog-mark {
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    border-radius: 0.55rem;
    font-size: 0.72rem;
  }

  .badge {
    display: inline-block;
    margin-top: 1.25rem;
    padding: 0.38rem 0.7rem;
    border: 1px solid rgba(var(--ink-rgb), 0.16);
    border-radius: 999px;
    color: rgba(var(--ink-rgb), 0.66);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .dialog-section {
    margin-top: 2rem;
  }

  .dialog-section h3 {
    margin-bottom: 0.75rem;
    color: rgba(var(--ink-rgb), 0.48);
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .dialog-summary {
    color: rgba(var(--ink-rgb), 0.76);
    font-size: 0.96rem;
    line-height: 1.75;
  }

  .impact-list {
    list-style: none;
  }

  .impact-list li {
    position: relative;
    padding-left: 1.25rem;
    color: rgba(var(--ink-rgb), 0.72);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .impact-list li + li {
    margin-top: 0.8rem;
  }

  .impact-list li::before {
    content: '';
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: rgba(var(--ink-rgb), 0.35);
  }

  .chips {
    display: flex;
