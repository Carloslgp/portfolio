---
import Layout from '../layouts/Layout.astro';
import { ENTRIES, range, type Entry } from '../data/work';
import { WORK_SEAM } from '../scripts/workNavigation';

const entries = [...ENTRIES].sort((a, b) => {
  const aCurrent = a.end === 'present';
  const bCurrent = b.end === 'present';

  if (aCurrent !== bCurrent) return aCurrent ? -1 : 1;

  const aAnchor = aCurrent ? a.start : a.end;
  const bAnchor = bCurrent ? b.start : b.end;

  return bAnchor.localeCompare(aAnchor) || b.start.localeCompare(a.start);
});

const entryType: Record<Entry['kind'], string> = {
  role: 'Experience',
  build: 'Project',
  recognition: 'Recognition',
};

function monogram(entry: Entry) {
  const source = entry.org ?? entry.title;
  const words = source.match(/[A-Za-zÀ-ÿ0-9]+/g) ?? [];
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
}

function preview(entry: Entry) {
  if (!entry.summary) return entryType[entry.kind];
  return entry.summary.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim() ?? entry.summary;
}

/** Quantas linhas da lista entram animadas junto com a cortina.
 *
 *  Só as que cabem na tela: mesmo no monitor mais alto a sétima já está
 *  abaixo da dobra, e animar as dezesseis significava pôr o navegador para
 *  compor treze camadas que ninguém vê — com os últimos atrasos caindo já no
 *  fim da abertura, que é onde apareciam os quadros longos no celular. As
 *  demais nascem prontas. */
const REVEAL_ITEMS = 6;

function hasDetails(entry: Entry) {
  return Boolean(entry.summary || entry.impact?.length || entry.stack?.length || entry.badge || entry.href);
}
---

<Layout lang="en">
  <Fragment slot="head">
    <title>Experience — Carlos Leonardo</title>
    <meta
      name="description"
      content="Carlos Leonardo's professional experience, projects and recognition."
    />
    <link rel="prefetch" href="/" />

    {/* A home termina coberta pela pintura do segmento Work. Esta marca nasce
        antes do primeiro paint para a página começar no mesmo quadro e só
        então abrir as duas folhas sobre o conteúdo.

        As três medidas da emenda descem junto, e pelo mesmo motivo do outro
        lado da troca (ver index.astro): elas são o contrato entre os dois
        documentos, e um número que só valesse aqui já seria uma emenda
        visível. */}
    <script
      is:inline
      define:vars={{
        seamAspect: WORK_SEAM.aspect,
        seamOverscan: WORK_SEAM.overscan,
        seamRotation: WORK_SEAM.rotation,
      }}
    >
      document.documentElement.style.setProperty('--seam-aspect', seamAspect);
      document.documentElement.style.setProperty('--seam-overscan', seamOverscan);
      document.documentElement.style.setProperty('--seam-rotation', seamRotation + 'deg');
      try {
        if (sessionStorage.getItem('portfolio:work-entry')) {
          sessionStorage.removeItem('portfolio:work-entry');
          document.documentElement.dataset.workEntry = 'armed';
        }
      } catch (e) {}
    </script>
  </Fragment>

  <div class="paper" aria-hidden="true"></div>

  <div class="work-transition" data-work-transition aria-hidden="true">
    <div class="work-transition-panel is-left">
      <div class="work-seam"><img src="/textures/work.jpg" alt="" /></div>
    </div>
    <div class="work-transition-panel is-right">
      <div class="work-seam"><img src="/textures/work.jpg" alt="" /></div>
    </div>
    <span class="work-transition-title">
      <small>Selected</small>
      <strong>WORK</strong>
    </span>
  </div>

  <a class="back" href="/" data-work-back>‹ Back</a>

  <button
    class="theme"
    data-theme-toggle
    aria-pressed="false"
    aria-label="Toggle dark theme"
    title="Light / dark theme"
  >
    <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>

  <main class="work-page">
    <div class="work-inner">
      <header class="work-head">
        <p class="eyebrow">Work</p>
        <h1>Experience</h1>
        <p class="lead">A concise view of the roles, projects and communities I’ve helped build.</p>
      </header>

      <ol class="experience-list">
        {entries.map((entry, index) => {
          const dates = range(entry);
          const dialogId = `work-details-${entry.id}`;

          return (
            <li
              class:list={['experience-item', index < REVEAL_ITEMS && 'is-arriving']}
              style={index < REVEAL_ITEMS ? `--i:${index + 1}` : undefined}
            >
              <div
                class:list={['experience-mark', entry.logo && 'has-image']}
                style={`--mark-hue:${(index * 47 + 258) % 360}`}
                aria-hidden="true"
              >
                {entry.logo ? (
                  <img
                    src={entry.logo}
                    alt=""
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : monogram(entry)}
              </div>

              <article class="experience-main">
                <h2>{entry.title}</h2>
                <p class="company">{entry.org ?? entryType[entry.kind]}</p>
                <p class="preview">{preview(entry)}</p>

                {hasDetails(entry) && (
                  <button
                    class="read-more"
                    type="button"
                    data-dialog-open={dialogId}
                    aria-haspopup="dialog"
                    aria-controls={dialogId}
                  >
                    Read more
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4"></path>
                    </svg>
                  </button>
                )}
              </article>

              <p class="period">
                <time datetime={dates.from.dt}>{dates.from.label}</time>
                {dates.to && <><span aria-hidden="true"> — </span><time datetime={dates.to.dt}>{dates.to.label}</time></>}
                {dates.present && <><span aria-hidden="true"> — </span>Present</>}
              </p>
            </li>
          );
        })}
      </ol>

      <p class="craft-note">
        Personal experiments and things made for the joy of making live on <a href="/craft">/craft</a>.
      </p>
    </div>
  </main>

  {entries.filter(hasDetails).map((entry, index) => {
    const dates = range(entry);
    const dialogId = `work-details-${entry.id}`;

    return (
      <dialog class="work-dialog" id={dialogId} data-work-dialog aria-labelledby={`${dialogId}-title`}>
        <div class="dialog-shell">
          <header class="dialog-head">
            <div>
              <p class="dialog-kicker">{entryType[entry.kind]}</p>
              <h2 id={`${dialogId}-title`}>{entry.title}</h2>
              <p class="dialog-company">{entry.org}</p>
            </div>

            <button class="dialog-close" type="button" data-dialog-close aria-label={`Close ${entry.title} details`}>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M5 5l14 14M19 5 5 19"></path>
              </svg>
            </button>
          </header>

          <div class="dialog-body">
            <div class="dialog-meta">
              <span class:list={['dialog-mark', entry.logo && 'has-image']} style={`--mark-hue:${(index * 47 + 258) % 360}`} aria-hidden="true">
                {entry.logo ? <img src={entry.logo} alt="" decoding="async" /> : monogram(entry)}
              </span>
              <p>
                <time datetime={dates.from.dt}>{dates.from.label}</time>
                {dates.to && <><span aria-hidden="true"> — </span><time datetime={dates.to.dt}>{dates.to.label}</time></>}
                {dates.present && <><span aria-hidden="true"> — </span>Present</>}
              </p>
            </div>

            {entry.badge && <p class="badge">{entry.badge}</p>}

            {entry.summary && (
              <section class="dialog-section" aria-labelledby={`${dialogId}-overview`}>
                <h3 id={`${dialogId}-overview`}>Overview</h3>
                <p class="dialog-summary">{entry.summary}</p>
              </section>
            )}

            {entry.impact?.length && (
              <section class="dialog-section" aria-labelledby={`${dialogId}-contributions`}>
                <h3 id={`${dialogId}-contributions`}>What I did</h3>
                <ul class="impact-list">
                  {entry.impact.map((line) => <li>{line}</li>)}
                </ul>
              </section>
            )}

            {entry.stack?.length && (
              <section class="dialog-section" aria-labelledby={`${dialogId}-tools`}>
                <h3 id={`${dialogId}-tools`}>Tools & technologies</h3>
                <ul class="chips">
                  {entry.stack.map((tech) => <li>{tech}</li>)}
                </ul>
              </section>
            )}

            {entry.href && (
              <a class="project-link" href={entry.href} target="_blank" rel="noopener noreferrer">
                Visit {entry.org ?? entry.title}
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 3h7v7M13 3 5 11M11 9v4H3V5h4"></path>
                </svg>
              </a>
            )}
          </div>
        </div>
      </dialog>
    );
  })}
</Layout>

<script>
  import { initTheme } from '../scripts/theme';
  import { initWork } from '../scripts/work';

  initTheme();
  initWork();
</script>

<style>
  .paper {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    transition: background-color var(--theme-fade);
  }

  :global(html:has(.work-page)),
  :global(body:has(.work-page)) {
    height: auto;
    overflow: visible;
  }

  /* A goteira da barra de rolagem fica reservada SEMPRE. Sem isto, travar a
     rolagem (na cortina e nos diálogos) devolvia ~15px de largura à página, e
     a lista inteira dava um pulo lateral no meio da abertura — bem no momento
     em que ela está entrando. Como esta página rola de qualquer jeito, o
     espaço reservado não custa nada fora da transição. */
  :global(html:has(.work-page)) {
    scrollbar-gutter: stable;
  }

  :global(body.has-work-dialog) {
    overflow: hidden !important;
  }

  /* Vale enquanto a cortina existe — armada E abrindo. Só em 'armed' a
     rolagem voltava assim que a abertura começava. */
  :global(html[data-work-entry] body),
  :global(body.has-work-transition) {
    overflow: hidden !important;
  }

  /* ——— a pintura se abre em duas folhas ———
     As folhas são MÁSCARAS, não cópias: cada uma recorta metade da mesma
     emenda — a pintura inteira, na proporção da fita e girada como a fita a
     gira (ver scripts/workNavigation.ts → WORK_SEAM). É o mesmo retângulo que
     a home desenha no último quadro dela, com a mesma conta, então a troca de
     documento não troca o desenho.

     Os números da abertura estão logo abaixo, e cada um responde a uma coisa
     que fazia o corte parecer duro:

     --open-dur / --open-ease  A curva anterior (cubic-bezier(0.76,0,0.24,1))
        para, chicoteia e para de novo, e o chicote caía justamente no meio da
        tela. Esta sai depressa — herdando a velocidade com que a pintura
        chegou — e passa o resto do tempo assentando.

     --seam-parallax  Quanto a pintura ANDA CONTRA a folha que a descobre. Em 1
        ela ficaria imóvel e só a máscara correria; em 0 a folha vira um cartão
        rígido voando pro lado, que era o efeito antigo. Perto de 1 é o que faz
        a página parecer descoberta, e não empurrada.

     --seam-breath  A pintura continua crescendo enquanto abre. Sem isso ela
        congela no quadro em que a página troca e só então a cortina se mexe —
        e parada seguida de movimento é exatamente o que se lê como tranco. */
  .work-transition {
    --open-dur: 1.15s;
    --open-ease: cubic-bezier(0.32, 0.12, 0.16, 1);
    --close-dur: 0.9s;
    --close-ease: cubic-bezier(0.36, 0, 0.22, 1);
    --seam-parallax: 0.86;
    --seam-breath: 1.05;
    --panel-travel: 51vw;
    position: fixed;
    top: 0;
    left: 0;
    /* 100vw, e não `inset: 0`: com a goteira reservada, o bloco de contenção
       de um fixo para 15px antes da beirada da janela, e a cortina deixava uma
       tira de papel aparecendo à direita. vw conta a janela inteira. */
    width: 100vw;
    height: 100vh;
    z-index: 20;
    visibility: hidden;
    overflow: hidden;
    pointer-events: none;
  }

  .work-transition-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    transform: translateX(var(--panel-x, 0px));
  }

  .work-transition-panel.is-left {
    left: 0;
  }

  .work-transition-panel.is-right {
    right: 0;
  }

  /* A emenda vive DENTRO de cada folha, mas é medida pela JANELA: por isso ela
     se ancora na beirada que encosta no centro da tela (100% na folha da
     esquerda, 0 na da direita). As duas cópias caem no mesmo lugar e a costura
     entre elas some. */
  .work-transition .work-seam {
    --seam-w: calc(max(100vw, 100vh * var(--seam-aspect)) * var(--seam-overscan));
    --seam-h: calc(var(--seam-w) / var(--seam-aspect));
    position: absolute;
    top: 50%;
    width: var(--seam-w);
    height: var(--seam-h);
    overflow: hidden;
    background: #171411;
    transform: translate(-50%, -50%) translateX(var(--seam-x, 0px)) scale(var(--seam-scale, 1));
  }

  .work-transition-panel.is-left .work-seam {
    left: 100%;
  }

  .work-transition-panel.is-right .work-seam {
    left: 0;
  }

  /* a pintura chega deitada da fita — ver a mesma regra em index.astro */
  .work-transition .work-seam img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--seam-h);
    height: var(--seam-w);
    display: block;
    max-width: none;
    max-height: none;
    object-fit: fill;
    transform: translate(-50%, -50%) rotate(var(--seam-rotation));
  }

  .work-transition .work-seam::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 7, 6, 0.08), rgba(8, 7, 6, 0.48));
  }

  /* O título entra e sai por opacidade e ESCALA, nunca por letter-spacing.
     Havia uma animação de tracking aqui, e ela era invisível: `small` e
     `strong` declaram o próprio espaçamento, então o do contêiner não chegava
     a lugar nenhum. Custava, porém, o preço cheio — mexer numa propriedade
     herdada invalida a subárvore, e o navegador refazia layout e pintura de
     uma palavra em Playfair de 15vw a cada quadro. Medido num celular emulado:
     82 layouts e 194 pinturas na abertura, contra 16 e 63 sem ela. Era essa a
     travada do celular; escala e opacidade ficam no compositor. */
  .work-transition-title {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    color: #fff;
    text-align: center;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.42);
    opacity: 0;
    transform: scale(var(--title-scale, 1));
  }

  .work-transition-title small {
    margin-bottom: 0.4rem;
    font-size: clamp(0.6rem, 1vw, 0.75rem);
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .work-transition-title strong {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(4rem, 15vw, 12rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.065em;
  }

  /* ——— os três estados da cortina ———
     FECHADA é o estado natural das regras acima (folhas em 0, pintura em 1):
     é o quadro que a home entrega e o quadro em que a saída termina. Só a
     visibilidade precisa ser dita. */
  :global(html[data-work-entry]) .work-transition,
  .work-transition.is-preparing-exit,
  .work-transition.is-closing {
    visibility: visible;
    pointer-events: auto;
  }

  :global(html[data-work-entry]) .work-transition-title {
    opacity: 1;
  }

  /* A promoção a camada acontece enquanto a pintura ainda está PARADA, não no
     quadro em que ela começa a andar. Com o will-change só nos estados de
     movimento, a primeira rasterização das duas folhas (imagem grande, em tela
     de celular densa) caía dentro do primeiro quadro da abertura — e era um
     quadro de 50 a 80ms, o tranco inicial. Aqui ele cabe na espera pela thread
     livre (ver work.ts → calmFrame), onde não custa nada. E sai junto com a
     cortina: fora dela seriam duas camadas do tamanho da tela guardadas numa
     página que rola. */
  :global(html[data-work-entry]) .work-transition-panel,
  .work-transition.is-preparing-exit .work-transition-panel,
  .work-transition.is-closing .work-transition-panel {
    will-change: transform, opacity;
  }

  :global(html[data-work-entry]) .work-seam,
  .work-transition.is-preparing-exit .work-seam,
  .work-transition.is-closing .work-seam {
    will-change: transform;
  }

  /* ABERTA. O mesmo estado serve para o fim da entrada e para o começo da
     saída — descrever "aberto" duas vezes seria deixar as duas pontas livres
     para divergirem no próximo ajuste. */
  .work-transition.is-opening .work-transition-panel,
  .work-transition.is-preparing-exit .work-transition-panel {
    opacity: 0;
  }

  /* Folha e pintura são poses da MESMA folha: as duas variáveis moram no
     painel e a emenda as herda. Não é arrumação — é o que mantém todos os
     estados com a mesma forma de seletor. Com `--seam-x` escrito no
     `.work-seam`, a regra de "aberta" ficava com uma classe a mais que a de
     "fechando", e como as duas classes convivem na saída (a pose primeiro, o
     movimento depois) a mais específica vencia: as folhas voltavam ao centro
     mas a pintura ficava parada no deslocamento do parallax — dois retângulos
     no meio da tela e papel nas beiradas. */
  .work-transition.is-opening .is-left,
  .work-transition.is-preparing-exit .is-left {
    --panel-x: calc(var(--panel-travel) * -1);
    --seam-x: calc(var(--panel-travel) * var(--seam-parallax));
    --seam-scale: var(--seam-breath);
  }

  .work-transition.is-opening .is-right,
  .work-transition.is-preparing-exit .is-right {
    --panel-x: var(--panel-travel);
    --seam-x: calc(var(--panel-travel) * var(--seam-parallax) * -1);
    --seam-scale: var(--seam-breath);
  }

  .work-transition.is-opening .work-transition-title,
  .work-transition.is-preparing-exit .work-transition-title {
    opacity: 0;
    --title-scale: 1.06;
  }

  /* Só quem ABRE ou FECHA transiciona. `is-preparing-exit` sozinho é uma pose,
     não um movimento: é ela que dá às folhas um ponto de partida real antes de
     `is-closing` entrar.

     O will-change não mora aqui: ele é aplicado antes, com a cortina ainda
     fechada — ver a regra da promoção acima. */
  .work-transition.is-opening .work-transition-panel,
  .work-transition.is-closing .work-transition-panel {
    transition:
      transform var(--open-dur) var(--open-ease),
      opacity calc(var(--open-dur) * 0.4) linear calc(var(--open-dur) * 0.6);
  }

  .work-transition.is-opening .work-seam,
  .work-transition.is-closing .work-seam {
    transition: transform var(--open-dur) var(--open-ease);
  }

  .work-transition.is-opening .work-transition-title,
  .work-transition.is-closing .work-transition-title {
    transition: opacity calc(var(--open-dur) * 0.4) ease, transform var(--open-dur) var(--open-ease);
  }

  /* FECHANDO. Vem depois da regra de "aberta" de propósito: as duas têm a
     mesma especificidade, e é a ordem que faz o estado final vencer o inicial
     no mesmo elemento. A curva é outra — quem fecha tem que ENCOSTAR, não
     assentar, senão o último quadro daqui não bate com o primeiro da home. */
  .work-transition.is-closing .work-transition-panel {
    --panel-x: 0px;
    --seam-x: 0px;
    --seam-scale: 1;
    opacity: 1;
    transition:
      transform var(--close-dur) var(--close-ease),
      opacity calc(var(--close-dur) * 0.4) linear;
  }

  .work-transition.is-closing .work-seam {
    transition: transform var(--close-dur) var(--close-ease);
  }

  /* O título espera a pintura chegar. Sem o atraso ele acendia sobre a lista
     ainda em papel branco, e a palavra aparecia antes do fundo dela. */
  .work-transition.is-closing .work-transition-title {
    opacity: 1;
    --title-scale: 1;
    transition:
      opacity calc(var(--close-dur) * 0.45) ease calc(var(--close-dur) * 0.4),
      transform var(--close-dur) var(--close-ease);
  }

  /* ——— o conteúdo CHEGA, não estava esperando ———
     Antes a lista já estava montada por baixo e a cortina só a descobria: o
     movimento acabava na borda das folhas e a página aparecia inteira, parada.
     O atraso base põe a primeira linha em movimento com a cortina ainda quase
     fechada, e o escalonamento faz a leitura descer com ela. Sem marca de
     entrada (link direto, reload, baixa animação) nada disso existe. */
  :global(html[data-work-entry]) .work-head,
  :global(html[data-work-entry]) .experience-item.is-arriving {
    opacity: 0;
    transform: translateY(18px);
  }

  :global(html[data-work-entry='opening']) .work-head,
  :global(html[data-work-entry='opening']) .experience-item.is-arriving {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s ease calc(0.16s + var(--i, 0) * 0.06s),
      transform 0.8s cubic-bezier(0.2, 0.86, 0.24, 1) calc(0.16s + var(--i, 0) * 0.06s);
  }

  .back {
    position: fixed;
    top: 1.5rem;
    left: 2rem;
    z-index: 6;
    padding: 0.35rem 0;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--theme-fade);
  }

  .back::after {
